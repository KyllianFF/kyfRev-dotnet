{
  "name": "kyfrev-visual-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Éditeur visuel des fiches de kyfRev : le paquet est écrit dans src/KyfRev.Presentation.Wpf/Editing/Web.",
  "scripts": {
    "build": "vite build && vite build --config vite.diagrammes.config.ts",
