# Fins de ligne LF dans le dépôt et sur le disque, quel que soit le poste.
* text=auto eol=lf

# Scripts et formats propres à Windows : CRLF sur le disque.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.iss text eol=crlf

# Crochets git et scripts shell : toujours LF, même sous Windows.
*.sh text eol=lf
.githooks/* text eol=lf

# Binaires.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary

# Fichiers de référence des tests : comparés à l'octet près, jamais convertis (CRLF, BOM).
tests/**/fixtures/** -text
