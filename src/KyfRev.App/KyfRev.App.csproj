<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>kyfRev</AssemblyName>
    <RootNamespace>KyfRev.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- L'exécutable, ses raccourcis et ses fenêtres prennent cette icône. -->
    <ApplicationIcon>..\..\assets\icon\kyfrev.ico</ApplicationIcon>
    <!-- Windows x64 seulement ; les bibliothèques restent indépendantes de la plateforme. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Description>kyfRev : l'application de bureau. Racine de composition : relie la présentation, le design system et l'infrastructure.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KyfRev.Extensions.Host\KyfRev.Extensions.Host.csproj" />
    <ProjectReference Include="..\KyfRev.Infrastructure.Online\KyfRev.Infrastructure.Online.csproj" />
    <ProjectReference Include="..\KyfRev.Infrastructure.Vault\KyfRev.Infrastructure.Vault.csproj" />
    <ProjectReference Include="..\KyfRev.Infrastructure.Windows\KyfRev.Infrastructure.Windows.csproj" />
    <ProjectReference Include="..\KyfRev.Modules.Citations\KyfRev.Modules.Citations.csproj" />
    <ProjectReference Include="..\KyfRev.Modules.Schemas\KyfRev.Modules.Schemas.csproj" />
    <ProjectReference Include="..\KyfRev.Presentation.Wpf\KyfRev.Presentation.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KyfRev.Presentation.Wpf.Tests" />
    <InternalsVisibleTo Include="KyfRev.Acceptance.Host" />
  </ItemGroup>

  <!-- Date de publication (section datée du CHANGELOG), passée par tools/installer.ps1. -->
  <ItemGroup Condition="'$(ReleaseDate)' != ''">
    <AssemblyMetadata Include="ReleaseDate" Value="$(ReleaseDate)" />
  </ItemGroup>

</Project>
