<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Description>Design system de kyfRev : jetons (gammes, rôles, échelles), thèmes clair, sombre et contraste élevé, styles et composants WPF.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KyfRev.DesignSystem.Tests" />
  </ItemGroup>

  <!-- Polices Atkinson Hyperlegible Next et Mono, livrées avec leur licence (SIL OFL 1.1). -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
