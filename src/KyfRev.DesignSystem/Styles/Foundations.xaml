<ResourceDictionary x:Class="KyfRev.DesignSystem.Styles.Foundations"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Anneau de focus : 2 px, décalé de 2 px, toujours visible au clavier. -->
  <Style x:Key="Kyf.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-4" RadiusX="8" RadiusY="8" SnapsToDevicePixels="True"
                     Stroke="{DynamicResource Kyf.Brush.Focus}" StrokeThickness="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Styles de texte : l'échelle de Typography, interlignes sur la grille de 4 px. -->
  <Style x:Key="Kyf.Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="LineHeight" Value="{DynamicResource Kyf.LineHeight.Body}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Kyf.Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Kyf.Text.Body}">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Kyf.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Kyf.Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
  </Style>

  <Style x:Key="Kyf.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Kyf.Text.Body}">
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Caption}" />
    <Setter Property="LineHeight" Value="{DynamicResource Kyf.LineHeight.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
  </Style>

  <Style x:Key="Kyf.Text.BodyLarge" TargetType="TextBlock" BasedOn="{StaticResource Kyf.Text.Body}">
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.BodyLarge}" />
    <Setter Property="LineHeight" Value="{DynamicResource Kyf.LineHeight.BodyLarge}" />
  </Style>

  <Style x:Key="Kyf.Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Kyf.Text.Body}">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Display}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Subtitle}" />
    <Setter Property="LineHeight" Value="{DynamicResource Kyf.LineHeight.Subtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="Kyf.Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Kyf.Text.Subtitle}">
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Title}" />
    <Setter Property="LineHeight" Value="{DynamicResource Kyf.LineHeight.Title}" />
  </Style>

  <Style x:Key="Kyf.Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Kyf.Text.Subtitle}">
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Display}" />
    <Setter Property="LineHeight" Value="{DynamicResource Kyf.LineHeight.Display}" />
  </Style>

  <!-- Icône seule, dans la police d'icônes de Windows. Placée dans un modèle, elle reste hors de
       la vue « contrôle » de l'automatisation : le nom vient du composant. -->
  <Style x:Key="Kyf.Text.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Icons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Link}" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.PrimaryHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="0,4" Background="{DynamicResource Kyf.Brush.Divider}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Caption}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Control}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
