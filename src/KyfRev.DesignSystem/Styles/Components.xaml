<ResourceDictionary x:Class="KyfRev.DesignSystem.Styles.Components"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls"
                    xmlns:ds="clr-namespace:KyfRev.DesignSystem">

  <!-- Carte : surface posée sur le fond par une ombre douce (derrière, pour garder le texte net),
       bordée d'un trait discret qui devient le seul repère en contraste élevé. Un court trait en
       haut dit ce qu'elle présente. -->
  <Style TargetType="kyf:Card">
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Divider}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Card">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Kyf.Radius.Card}"
                    Effect="{DynamicResource Kyf.Elevation.Card}" />
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Card}"
                    SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="Marker" Width="28" Height="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="20,12,0,0" CornerRadius="2" Visibility="Collapsed" />
                <ContentPresenter Margin="{TemplateBinding Padding}" />
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Marker" Value="Sheet">
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Kyf.Brush.MarkerSheet}" />
            </Trigger>
            <Trigger Property="Marker" Value="Passage">
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Kyf.Brush.MarkerPassage}" />
            </Trigger>
            <Trigger Property="Marker" Value="Reminder">
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Kyf.Brush.MarkerReminder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pastille : icône et libellé ; la couleur n'est jamais le seul repère. -->
  <Style TargetType="kyf:Pill">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.PillSheetBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.PillSheetText}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Pill">
          <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"
                  MinHeight="24" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Glyph}" Style="{DynamicResource Kyf.Text.Icon}" FontSize="12"
                         Foreground="{TemplateBinding Foreground}" Margin="0,0,4,0" />
              <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Kind" Value="Passage">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.PillPassageBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.PillPassageText}" />
      </Trigger>
      <Trigger Property="Kind" Value="Reminder">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.PillReminderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.PillReminderText}" />
      </Trigger>
      <Trigger Property="Kind" Value="Overdue">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.WarningBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
      </Trigger>
      <Trigger Property="Kind" Value="Archived">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
      </Trigger>
      <Trigger Property="Kind" Value="NeedsReview">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.WarningBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Notification : fond et icône selon la gravité, texte toujours dans la couleur du texte ; un filet
       discret la borde, jamais un trait de couleur (le contraste élevé en fait un vrai contour). -->
  <Style TargetType="kyf:Notification">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.InfoBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Hairline}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Notification">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Card}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SeverityGlyph" Text="{TemplateBinding Glyph}" Style="{DynamicResource Kyf.Text.Icon}"
                         Foreground="{DynamicResource Kyf.Brush.Info}" VerticalAlignment="Top" Margin="0,2,12,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Title" Text="{TemplateBinding Title}" Style="{DynamicResource Kyf.Text.BodyStrong}" />
                <TextBlock Text="{TemplateBinding Message}" Style="{DynamicResource Kyf.Text.Body}" />
              </StackPanel>
              <Button x:Name="PART_CloseButton" Grid.Column="2" Margin="12,-4,-4,-4" VerticalAlignment="Top"
                      Style="{DynamicResource Kyf.Button.Icon}" Content="&#xE711;"
                      AutomationProperties.Name="{x:Static ds:DesignText.Close}" ToolTip="{x:Static ds:DesignText.Close}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="">
              <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsClosable" Value="False">
              <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Severity" Value="Success">
              <Setter TargetName="SeverityGlyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.Success}" />
            </Trigger>
            <Trigger Property="Severity" Value="Warning">
              <Setter TargetName="SeverityGlyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
            </Trigger>
            <Trigger Property="Severity" Value="Critical">
              <Setter TargetName="SeverityGlyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.Critical}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsOpen" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <!-- Une réussite lue s'efface d'elle-même (Notification.StaysOpen la garde). -->
      <Trigger Property="IsExpired" Value="True">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Severity" Value="Success">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SuccessBackground}" />
      </Trigger>
      <Trigger Property="Severity" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.WarningBackground}" />
      </Trigger>
      <Trigger Property="Severity" Value="Critical">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.CriticalBackground}" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Case à cocher : le texte et la case suivent le thème. -->
  <!-- Espace coche ; Entrée va au bouton par défaut, comme partout sous Windows, et ne coche rien par mégarde. -->
  <Style TargetType="CheckBox">
    <Setter Property="KeyboardNavigation.AcceptsReturn" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <!-- Un libellé long passe à la ligne : la case reste en face de sa première ligne. -->
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1" Background="{DynamicResource Kyf.Brush.Surface}"
                    BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}" VerticalAlignment="Top" Margin="0,3,0,0">
              <kyf:Icon x:Name="Mark" Text="&#xE73E;" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.OnPrimary}" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Focus}" />
              <Setter TargetName="Box" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bouton radio : comme la case à cocher, en rond. -->
  <Style TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Top" Margin="0,3,0,0">
              <Ellipse x:Name="Ring" Width="18" Height="18" StrokeThickness="1" Fill="{DynamicResource Kyf.Brush.Surface}" Stroke="{DynamicResource Kyf.Brush.ControlBorder}" />
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Kyf.Brush.OnPrimary}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Kyf.Brush.Primary}" />
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Kyf.Brush.Primary}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Kyf.Brush.Focus}" />
              <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bascule : un réglage qui s'applique dès qu'on le change. Son nom, s'il en a un, précède la piste. -->
  <Style x:Key="Kyf.Switch" TargetType="CheckBox">
    <Setter Property="KeyboardNavigation.AcceptsReturn" Value="False" />
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual}" />
    <Setter Property="MinHeight" Value="{DynamicResource Kyf.Target.Compact}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Border x:Name="Track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" VerticalAlignment="Center" BorderThickness="1"
                    Background="{DynamicResource Kyf.Brush.Surface}" BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}">
              <Ellipse x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="3,0" Fill="{DynamicResource Kyf.Brush.ControlBorder}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Un choix parmi deux ou trois, tous visibles : des boutons côte à côte, celui qui est retenu marqué de la couleur
       principale. Les flèches passent de l'un à l'autre. -->
  <Style x:Key="Kyf.ListBoxItem.Choice" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource Kyf.Radius.Control}" SnapsToDevicePixels="True">
            <!-- Le nom en gras, caché, garde sa place : le bouton ne change pas de largeur quand on le choisit. -->
            <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center">
              <ContentPresenter TextElement.FontWeight="SemiBold" Visibility="Hidden" />
              <ContentPresenter HorizontalAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Kyf.ListBox.Choices" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,-6,-6" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource Kyf.ListBoxItem.Choice}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel IsItemsHost="True" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- La rangée d'un réglage dans un bloc des paramètres : un filet la sépare de celle du dessus. -->
  <Style x:Key="Kyf.Setting.Row" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Divider}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,14" />
  </Style>

  <!-- La première rangée d'un bloc : sans filet. -->
  <Style x:Key="Kyf.Setting.FirstRow" TargetType="Border" BasedOn="{StaticResource Kyf.Setting.Row}">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Barre de progression : une piste discrète, la part faite à la couleur principale. -->
  <Style TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource Kyf.Brush.Divider}" SnapsToDevicePixels="True">
            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{DynamicResource Kyf.Brush.Primary}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dialogue : voile, carte au centre, ombre de l'élévation « Dialog », focus tenu à l'intérieur. -->
  <Style TargetType="kyf:Dialog">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
    <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Cycle" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    <Setter Property="AutomationProperties.IsDialog" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Dialog">
          <Grid>
            <Rectangle Fill="{DynamicResource Kyf.Brush.Scrim}" />
            <Grid x:Name="Card" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280" MaxWidth="{TemplateBinding CardMaxWidth}" Margin="16">
              <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Kyf.Radius.Dialog}"
                      Effect="{DynamicResource Kyf.Elevation.Dialog}" />
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Dialog}"
                      Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <!-- Le contenu vient avant les boutons, dans cet ordre aussi au clavier : le focus va d'abord à son premier champ. -->
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="{TemplateBinding Title}" Style="{DynamicResource Kyf.Text.Subtitle}" Margin="0,0,0,12" />
                  <!-- Trop haut pour la fenêtre : le contenu défile, le titre et les boutons restent. -->
                  <!-- La zone qui défile coupe ce qui en dépasse : 4 px de marge rendus au contenu laissent voir l'anneau de focus
                       d'un bouton posé contre son bord, sans déplacer le contenu. -->
                  <ScrollViewer x:Name="PART_Content" Grid.Row="1" Margin="-4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ContentPresenter Margin="4" />
                  </ScrollViewer>
                  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="PART_SecondaryButton" Content="{TemplateBinding SecondaryButtonText}" MinWidth="96"
                            Margin="0,0,8,0" IsCancel="True" />
                    <Button x:Name="PART_PrimaryButton" Content="{TemplateBinding PrimaryButtonText}" MinWidth="96"
                            Style="{DynamicResource Kyf.Button.Primary}" IsDefault="True" IsEnabled="{TemplateBinding IsPrimaryEnabled}" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsWide" Value="True">
              <Setter TargetName="Card" Property="HorizontalAlignment" Value="Stretch" />
            </Trigger>
            <Trigger Property="SecondaryButtonText" Value="">
              <Setter TargetName="PART_SecondaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <!-- Pendant le travail, le focus attend ici : un second appui sur Entrée ne ferme rien. -->
            <Trigger Property="IsWorking" Value="True">
              <Setter TargetName="PART_SecondaryButton" Property="KeyboardNavigation.AcceptsReturn" Value="False" />
            </Trigger>
            <!-- Ce qui ne s'annule pas se voit, et Entrée ne le déclenche pas. -->
            <Trigger Property="IsDestructive" Value="True">
              <Setter TargetName="PART_PrimaryButton" Property="Style" Value="{DynamicResource Kyf.Button.Danger}" />
              <Setter TargetName="PART_PrimaryButton" Property="IsDefault" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsOpen" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- État vide : centré, une grande icône discrète, un titre, une explication, l'action. -->
  <Style TargetType="kyf:EmptyState">
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:EmptyState">
          <StackPanel MaxWidth="400" Margin="24">
            <TextBlock Text="{TemplateBinding Glyph}" Style="{DynamicResource Kyf.Text.Icon}" FontSize="48"
                       Foreground="{DynamicResource Kyf.Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource Kyf.Text.Subtitle}" TextAlignment="Center" />
            <TextBlock Text="{TemplateBinding Description}" Style="{DynamicResource Kyf.Text.Secondary}"
                       TextAlignment="Center" Margin="0,8,0,0" />
            <ContentPresenter Content="{TemplateBinding Action}" HorizontalAlignment="Center" Margin="0,16,0,0" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Squelette : immobile si les animations sont réduites ; bordé, pour rester visible en contraste élevé. -->
  <Style TargetType="kyf:Skeleton">
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsAnimated" Value="{DynamicResource Kyf.Motion.Enabled}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Skeleton">
          <Border x:Name="Block" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Control}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsAnimated" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Pulse">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Block" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.5" Duration="0:0:0.9" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Pulse" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
