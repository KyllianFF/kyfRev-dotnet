<ResourceDictionary x:Class="KyfRev.DesignSystem.Styles.Components"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls"
                    xmlns:ds="clr-namespace:KyfRev.DesignSystem">

  <!-- Carte : surface bordée d'un trait, repère latéral de 3 px selon ce qu'elle présente. -->
  <Style TargetType="kyf:Card">
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Divider}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Card">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Card}"
                  SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="0,8" CornerRadius="0,2,2,0"
                      Visibility="Collapsed" />
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Marker" Value="Sheet">
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Kyf.Brush.MarkerSheet}" />
            </Trigger>
            <Trigger Property="Marker" Value="Passage">
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Kyf.Brush.MarkerPassage}" />
            </Trigger>
            <Trigger Property="Marker" Value="Reminder">
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Kyf.Brush.MarkerReminder}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pastille : icône et libellé ; la couleur n'est jamais le seul repère. -->
  <Style TargetType="kyf:Pill">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.PillSheetBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.PillSheetText}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Pill">
          <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}"
                  MinHeight="24" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding Glyph}" Style="{DynamicResource Kyf.Text.Icon}" FontSize="12"
                         Foreground="{TemplateBinding Foreground}" Margin="0,0,4,0" />
              <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Kind" Value="Passage">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.PillPassageBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.PillPassageText}" />
      </Trigger>
      <Trigger Property="Kind" Value="Reminder">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.PillReminderBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.PillReminderText}" />
      </Trigger>
      <Trigger Property="Kind" Value="Overdue">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.CriticalBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Critical}" />
      </Trigger>
      <Trigger Property="Kind" Value="Archived">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
      </Trigger>
      <Trigger Property="Kind" Value="NeedsReview">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.WarningBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Notification : fond et icône selon la gravité, texte toujours dans la couleur du texte. -->
  <Style TargetType="kyf:Notification">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.InfoBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Info}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title, RelativeSource={RelativeSource Self}}" />
    <Setter Property="AutomationProperties.HelpText" Value="{Binding Message, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Notification">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Card}"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{TemplateBinding Glyph}" Style="{DynamicResource Kyf.Text.Icon}"
                         Foreground="{TemplateBinding BorderBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="Title" Text="{TemplateBinding Title}" Style="{DynamicResource Kyf.Text.BodyStrong}" />
                <TextBlock Text="{TemplateBinding Message}" Style="{DynamicResource Kyf.Text.Body}" />
              </StackPanel>
              <Button x:Name="PART_CloseButton" Grid.Column="2" Margin="12,-4,-4,-4" VerticalAlignment="Top"
                      Style="{DynamicResource Kyf.Button.Icon}" Content="&#xE711;"
                      AutomationProperties.Name="{x:Static ds:DesignText.Close}" ToolTip="{x:Static ds:DesignText.Close}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Title" Value="">
              <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsClosable" Value="False">
              <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsOpen" Value="False">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
      <Trigger Property="Severity" Value="Success">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SuccessBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Success}" />
      </Trigger>
      <Trigger Property="Severity" Value="Warning">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.WarningBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Warning}" />
      </Trigger>
      <Trigger Property="Severity" Value="Critical">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.CriticalBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Critical}" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Dialogue : voile, carte au centre, ombre de l'élévation « Dialog », focus tenu à l'intérieur. -->
  <Style TargetType="kyf:Dialog">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
    <Setter Property="KeyboardNavigation.ControlTabNavigation" Value="Cycle" />
    <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Dialog">
          <Grid>
            <Rectangle Fill="{DynamicResource Kyf.Brush.Scrim}" />
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="320" MaxWidth="560" Margin="24">
              <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Kyf.Radius.Dialog}"
                      Effect="{DynamicResource Kyf.Elevation.Dialog}" />
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Dialog}"
                      Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                      AutomationProperties.Name="{TemplateBinding Title}" AutomationProperties.IsDialog="True">
                <StackPanel>
                  <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource Kyf.Text.Subtitle}" Margin="0,0,0,12" />
                  <ContentPresenter />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button x:Name="PART_SecondaryButton" Content="{TemplateBinding SecondaryButtonText}" MinWidth="96"
                            Margin="0,0,8,0" IsCancel="True" />
                    <Button x:Name="PART_PrimaryButton" Content="{TemplateBinding PrimaryButtonText}" MinWidth="96"
                            Style="{DynamicResource Kyf.Button.Primary}" IsDefault="True" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SecondaryButtonText" Value="">
              <Setter TargetName="PART_SecondaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsOpen" Value="True">
        <Setter Property="Visibility" Value="Visible" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- État vide : centré, une grande icône discrète, un titre, une explication, l'action. -->
  <Style TargetType="kyf:EmptyState">
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:EmptyState">
          <StackPanel MaxWidth="400" Margin="24">
            <TextBlock Text="{TemplateBinding Glyph}" Style="{DynamicResource Kyf.Text.Icon}" FontSize="48"
                       Foreground="{DynamicResource Kyf.Brush.TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Text="{TemplateBinding Title}" Style="{DynamicResource Kyf.Text.Subtitle}" TextAlignment="Center" />
            <TextBlock Text="{TemplateBinding Description}" Style="{DynamicResource Kyf.Text.Secondary}"
                       TextAlignment="Center" Margin="0,8,0,0" />
            <ContentPresenter Content="{TemplateBinding Action}" HorizontalAlignment="Center" Margin="0,16,0,0" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Squelette : immobile si les animations sont réduites ; bordé, pour rester visible en contraste élevé. -->
  <Style TargetType="kyf:Skeleton">
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Divider}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="IsAnimated" Value="{DynamicResource Kyf.Motion.Enabled}" />
    <Setter Property="AutomationProperties.Name" Value="{x:Static ds:DesignText.Loading}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:Skeleton">
          <Border x:Name="Block" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Control}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsAnimated" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Pulse">
                  <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="Block" Storyboard.TargetProperty="Opacity"
                                     From="1" To="0.5" Duration="0:0:0.9" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Pulse" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
