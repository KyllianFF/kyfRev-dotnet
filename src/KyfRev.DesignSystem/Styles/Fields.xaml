<ResourceDictionary x:Class="KyfRev.DesignSystem.Styles.Fields"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls"
                    xmlns:ds="clr-namespace:KyfRev.DesignSystem">

  <!-- Le bouton qui ouvre une liste de choix : tout le champ est cliquable, le contenu est dessiné par-dessus. -->
  <Style x:Key="Kyf.ComboBox.Toggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Frame" Background="{DynamicResource Kyf.Brush.Surface}" BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}" BorderThickness="1"
                  CornerRadius="{DynamicResource Kyf.Radius.Control}" SnapsToDevicePixels="True">
            <kyf:Icon Text="{x:Static kyf:Icons.ChevronDown}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Une liste de choix : comme un champ, et sa liste comme un menu. Sans ce style, Windows la dessine en clair, même en sombre. -->
  <Style TargetType="ComboBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="12,0,32,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Style="{StaticResource Kyf.ComboBox.Toggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   PopupAnimation="None">
              <!-- La marge laisse la place de l'ombre, comme pour un menu. -->
              <Grid Margin="8,4,8,12" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="{DynamicResource Kyf.Brush.Surface}" CornerRadius="{DynamicResource Kyf.Radius.Card}" Effect="{DynamicResource Kyf.Elevation.Flyout}" />
                <Border Background="{DynamicResource Kyf.Brush.Surface}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1"
                        CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="4" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                  <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ComboBoxItem">
          <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
          <Setter Property="MinHeight" Value="36" />
          <Setter Property="Padding" Value="8,0" />
          <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual.Inset}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Row" Background="Transparent" CornerRadius="{DynamicResource Kyf.Radius.Control}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                  <ContentPresenter VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Champ de saisie : contour à 3:1 au moins ; au focus, contour épaissi de la couleur du focus. -->
  <Style TargetType="TextBox">
    <EventSetter Event="Loaded" Handler="OnFieldLoaded" />
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.ControlBorder}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Kyf.Brush.Selection}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Control}"
                  SnapsToDevicePixels="True">
            <Grid>
              <TextBlock x:Name="Placeholder" Margin="{TemplateBinding Padding}" Padding="2,0" IsHitTestVisible="False"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Visibility="Collapsed"
                         Foreground="{DynamicResource Kyf.Brush.TextSecondary}"
                         Text="{TemplateBinding kyf:Field.Placeholder}" />
              <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Text}" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Focus}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- Un champ de plusieurs lignes ne se centre pas : son texte ne doit pas coller au bord. -->
    <Style.Triggers>
      <Trigger Property="AcceptsReturn" Value="True">
        <Setter Property="Padding" Value="12,8" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--
    Mot de passe : le même champ que le texte, ses caractères masqués. Ni texte d'aide dans le champ (son nom le dit, à
    côté), ni Couper ni Copier : rien ne sort d'un mot de passe. Son menu ne fait que coller (depuis un gestionnaire de
    mots de passe).
  -->
  <Style TargetType="PasswordBox">
    <EventSetter Event="Loaded" Handler="OnPasswordLoaded" />
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.ControlBorder}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Kyf.Brush.Selection}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Control}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Text}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Focus}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Un jour du calendrier : le jour choisi est plein, aujourd'hui entouré, ceux qu'on ne peut pas choisir s'effacent. -->
  <Style x:Key="Kyf.CalendarDayButton" TargetType="CalendarDayButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual.Inset}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarDayButton">
          <Border x:Name="Cell" Margin="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                  CornerRadius="{DynamicResource Kyf.Radius.Control}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsInactive" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsToday" Value="True">
              <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
              <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsBlackedOut" Value="True">
              <Setter Property="Cursor" Value="Arrow" />
              <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
              <Setter TargetName="Cell" Property="Background" Value="Transparent" />
              <Setter TargetName="Cell" Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Cell" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Un mois ou une année du calendrier. -->
  <Style x:Key="Kyf.CalendarMonthButton" TargetType="CalendarButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="MinWidth" Value="60" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual.Inset}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarButton">
          <Border x:Name="Cell" Margin="1" Background="Transparent" CornerRadius="{DynamicResource Kyf.Radius.Control}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsInactive" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
            </Trigger>
            <Trigger Property="HasSelectedDays" Value="True">
              <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
              <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Cell" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- L'en-tête (mois précédent, le mois, mois suivant) et les jours, ou les mois, ou les années. -->
  <Style x:Key="Kyf.CalendarItem" TargetType="CalendarItem">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarItem">
          <ControlTemplate.Resources>
            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
              <TextBlock Text="{Binding}" Style="{DynamicResource Kyf.Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4" />
            </DataTemplate>
          </ControlTemplate.Resources>
          <Grid x:Name="PART_Root">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button x:Name="PART_PreviousButton" Style="{DynamicResource Kyf.Button.Icon}" Content="&#xE76B;" Focusable="False"
                    ToolTip="{x:Static ds:DesignText.PreviousPeriod}" AutomationProperties.Name="{x:Static ds:DesignText.PreviousPeriod}" />
            <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{DynamicResource Kyf.Button.Subtle}" Focusable="False" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <Button x:Name="PART_NextButton" Grid.Column="2" Style="{DynamicResource Kyf.Button.Icon}" Content="&#xE76C;" Focusable="False"
                    ToolTip="{x:Static ds:DesignText.NextPeriod}" AutomationProperties.Name="{x:Static ds:DesignText.NextPeriod}" />
            <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
            </Grid>
            <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" Visibility="Hidden">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
            </Grid>
            <Border x:Name="PART_DisabledVisual" Grid.RowSpan="2" Grid.ColumnSpan="3" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
              <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
              <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Le calendrier, comme un menu : la marge laisse la place de l'ombre. -->
  <Style x:Key="Kyf.Calendar" TargetType="Calendar">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Divider}" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="{x:Static ds:DesignText.Calendar}" />
    <Setter Property="CalendarItemStyle" Value="{StaticResource Kyf.CalendarItem}" />
    <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Kyf.CalendarDayButton}" />
    <Setter Property="CalendarButtonStyle" Value="{StaticResource Kyf.CalendarMonthButton}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Calendar">
          <Grid x:Name="PART_Root" Margin="8,4,8,12">
            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Kyf.Radius.Card}" Effect="{DynamicResource Kyf.Elevation.Flyout}" />
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="8" SnapsToDevicePixels="True">
              <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Le texte du champ de date : sans cadre, le cadre est celui du champ. Vide, il rappelle le format. -->
  <Style TargetType="DatePickerTextBox">
    <EventSetter Event="Loaded" Handler="OnFieldLoaded" />
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CaretBrush" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Kyf.Brush.Selection}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePickerTextBox">
          <Grid Background="{TemplateBinding Background}">
            <TextBlock x:Name="Placeholder" Padding="2,0" IsHitTestVisible="False" Visibility="Collapsed" VerticalAlignment="Center"
                       Foreground="{DynamicResource Kyf.Brush.TextSecondary}" Text="{x:Static ds:DesignText.DatePlaceholder}" />
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Champ de date : le même cadre que le texte, un bouton pour le calendrier ; une date refusée le rougit. -->
  <Style TargetType="kyf:DateField">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0,0,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="176" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" />
    <Setter Property="CalendarStyle" Value="{StaticResource Kyf.Calendar}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="kyf:DateField">
          <Grid x:Name="PART_Root">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource Kyf.Radius.Control}" SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DatePickerTextBox x:Name="PART_TextBox" Margin="{TemplateBinding Padding}" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                <Button x:Name="PART_Button" Grid.Column="1" Style="{DynamicResource Kyf.Button.Icon}" Width="36" Height="36" Content="{x:Static kyf:Icons.Calendar}"
                        ToolTip="{x:Static ds:DesignText.OpenCalendar}" AutomationProperties.Name="{x:Static ds:DesignText.OpenCalendar}" />
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Frame}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Text}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Focus}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="HasRefusedDate" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Critical}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
