<ResourceDictionary x:Class="KyfRev.DesignSystem.Styles.Buttons"
                    x:ClassModifier="internal"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <ControlTemplate x:Key="Kyf.Template.Button" TargetType="ButtonBase">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Kyf.Radius.Control}"
            SnapsToDevicePixels="True">
      <ContentPresenter Margin="{TemplateBinding Padding}" Focusable="False" RecognizesAccessKey="True"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Border>
    <ControlTemplate.Triggers>
      <!-- Désactivé : atténué de moitié ; l'infobulle dit pourquoi. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- Bouton secondaire : le bouton par défaut. -->
  <Style x:Key="Kyf.Button" TargetType="ButtonBase">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource Kyf.Template.Button}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Divider}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Kyf.Button}" />

  <Style TargetType="RepeatButton" BasedOn="{StaticResource Kyf.Button}" />

  <Style TargetType="ToggleButton" BasedOn="{StaticResource Kyf.Button}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Bouton principal : une seule action principale par vue, en gras. -->
  <Style x:Key="Kyf.Button.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Kyf.Button}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.PrimaryHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.PrimaryHover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.PrimaryPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.PrimaryPressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Bouton d'une action qui ne s'annule pas. -->
  <Style x:Key="Kyf.Button.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Kyf.Button}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Critical}" />
    <Setter Property="Background" Value="{DynamicResource Kyf.Brush.CriticalBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Critical}" />
  </Style>

  <!-- Bouton discret : sans fond ni contour au repos (barres d'outils, actions secondaires). -->
  <Style x:Key="Kyf.Button.Subtle" TargetType="ButtonBase" BasedOn="{StaticResource Kyf.Button}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- Outil d'un ruban : compact, sans fond au repos ; s'il est à bascule, le choix se voit. -->
  <Style x:Key="Kyf.Button.Tool" TargetType="ButtonBase" BasedOn="{StaticResource Kyf.Button.Subtle}">
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="{DynamicResource Kyf.Target.Compact}" />
    <Setter Property="MinWidth" Value="28" />
    <Style.Triggers>
      <Trigger Property="ToggleButton.IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
      </Trigger>
      <!-- Une mise en forme active sous le curseur : le bouton le montre, comme dans un traitement de texte. -->
      <Trigger Property="Tag" Value="{x:Static sys:Boolean.TrueString}">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Grand outil d'un ruban : l'icône au-dessus de son nom. -->
  <Style x:Key="Kyf.Button.ToolLarge" TargetType="ButtonBase" BasedOn="{StaticResource Kyf.Button.Subtle}">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="MinWidth" Value="56" />
  </Style>

  <!-- Onglet : le survol arrondi comme partout, et un trait droit sous celui qui est choisi. -->
  <ControlTemplate x:Key="Kyf.Template.Tab" TargetType="ToggleButton">
    <Grid x:Name="Root" SnapsToDevicePixels="True">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Kyf.Radius.Control}" Margin="0,0,0,2" />
      <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Background="{TemplateBinding BorderBrush}" />
      <ContentPresenter Margin="{TemplateBinding Padding}" Focusable="False" RecognizesAccessKey="True"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Kyf.Button.Tab" TargetType="ToggleButton" BasedOn="{StaticResource Kyf.Button.Subtle}">
    <Setter Property="Template" Value="{StaticResource Kyf.Template.Tab}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{DynamicResource Kyf.Target.Tab}" />
    <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Icône seule : son nom vient de AutomationProperties.Name et de l'infobulle. -->
  <Style x:Key="Kyf.Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Kyf.Button.Subtle}">
    <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Icons}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
  </Style>

  <!-- Bouton de la fenêtre (réduire, agrandir), dans la barre de titre : carré, collé au bord, hors du parcours au clavier comme ceux de Windows.
       « Tag » montre le survol quand c'est Windows qui le suit, sur « Agrandir » et ses dispositions. -->
  <Style x:Key="Kyf.Button.Window" TargetType="Button" BasedOn="{StaticResource Kyf.Button.Subtle}">
    <Setter Property="Width" Value="46" />
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tag" Value="{x:Static sys:Boolean.TrueString}">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Bouton « Fermer » de la fenêtre : il devient rouge au survol. -->
  <Style x:Key="Kyf.Button.WindowClose" TargetType="Button" BasedOn="{StaticResource Kyf.Button.Window}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Critical}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Critical}" />
        <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
