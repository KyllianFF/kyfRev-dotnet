<Window x:Class="KyfRev.Presentation.Wpf.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
        xmlns:ds="clr-namespace:KyfRev.DesignSystem;assembly=KyfRev.DesignSystem"
        xmlns:p="clr-namespace:KyfRev.Presentation.Wpf"
        xmlns:extensions="clr-namespace:KyfRev.Presentation.Wpf.Extensions"
        xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages"
        xmlns:shell="clr-namespace:KyfRev.Presentation.Wpf.Shell"
        Title="{x:Static p:ShellText.AppName}" Width="1200" Height="780" MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Kyf.Brush.Background}" Foreground="{DynamicResource Kyf.Brush.Text}"
        FontFamily="{DynamicResource Kyf.Font.Ui}" FontSize="{DynamicResource Kyf.FontSize.Body}">

  <!-- L'application dessine son en-tête. Windows garde le déplacement, le redimensionnement, le menu de la fenêtre et les coins arrondis. -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <DataTemplate DataType="{x:Type pages:PlaceholderPageViewModel}">
      <pages:PlaceholderPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:GalleryPageViewModel}">
      <pages:GalleryPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:WelcomePageViewModel}">
      <pages:WelcomePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:UnlockPageViewModel}">
      <pages:UnlockPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:DashboardPageViewModel}">
      <pages:DashboardPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SheetsPageViewModel}">
      <pages:SheetsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:QuotesPageViewModel}">
      <pages:QuotesPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SchemasPageViewModel}">
      <pages:SchemasPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type extensions:ExtensionPageViewModel}">
      <extensions:ExtensionPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SettingsHubViewModel}">
      <pages:SettingsHubPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:DefinitionsPageViewModel}">
      <pages:DefinitionsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:HealthPageViewModel}">
      <pages:HealthPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:StatisticsPageViewModel}">
      <pages:StatisticsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ArchivesPageViewModel}">
      <pages:ArchivesPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:SheetPageViewModel}">
      <pages:SheetPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:PassagePageViewModel}">
      <pages:PassagePage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ReviewBarViewModel}">
      <pages:ReviewBar />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:StudySessionViewModel}">
      <pages:StudySessionPage />
    </DataTemplate>
    <shell:LayoutVisibilityConverter x:Key="ShownIn" />
    <!-- L'icône d'une entrée : un glyphe de kyfRev, ou l'icône dessinée d'une extension, de la couleur du texte comme lui. -->
    <DataTemplate x:Key="NavigationGlyphTemplate" DataType="{x:Type shell:NavigationItem}">
      <Grid>
        <kyf:Icon x:Name="Glyph" Text="{Binding Glyph}" HorizontalAlignment="Center" />
        <Path x:Name="Picture" Data="{Binding Picture.Geometry}" Width="16" Height="16" Visibility="Collapsed"
              StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasPicture}" Value="True">
          <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Picture.Stroked}" Value="False">
          <Setter TargetName="Picture" Property="Fill" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
          <Setter TargetName="Picture" Property="StrokeThickness" Value="0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- Entrée du menu : icône et libellé côte à côte dans la barre latérale, l'un sous l'autre
         dans la colonne d'icônes ; le compteur d'une extension les suit. -->
    <DataTemplate x:Key="NavigationItemTemplate">
      <Grid>
        <StackPanel x:Name="Row" Orientation="Horizontal">
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NavigationGlyphTemplate}" Margin="0,0,12,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
          <Border x:Name="RowBadge" Margin="8,0,0,0" Padding="6,0" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource Kyf.Brush.Primary}"
                  Visibility="{Binding Badge.IsShown, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding Badge.Text}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Kyf.Brush.OnPrimary}" />
          </Border>
        </StackPanel>
        <StackPanel x:Name="Stacked" Margin="-8,6" Visibility="Collapsed">
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NavigationGlyphTemplate}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Label}" FontSize="12" TextAlignment="Center" TextWrapping="WrapWithOverflow" Margin="0,2,0,0" />
          <TextBlock x:Name="StackedBadge" Text="{Binding Badge.Text}" FontSize="11" FontWeight="Bold" TextAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Primary}"
                     Visibility="{Binding Badge.IsShown, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
        </StackPanel>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DataContext.Layout, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Rail">
          <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Stacked" Property="Visibility" Value="Visible" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <!-- Onglet : l'icône, le libellé dessous. -->
    <DataTemplate x:Key="TabItemTemplate">
      <StackPanel Margin="-8,6">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource NavigationGlyphTemplate}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Label}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2,0,0" />
      </StackPanel>
    </DataTemplate>
    <!-- Onglets : seulement en fenêtre étroite, menu affiché. -->
    <Style x:Key="TabsOnly" TargetType="Border">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsMenuVisible}" Value="True" />
            <Condition Binding="{Binding Layout}" Value="Tabs" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenPaletteCommand}" />
    <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
    <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding ToggleFocusModeCommand}" />
    <KeyBinding Key="F11" Command="{Binding ToggleFullScreenCommand}" />
    <KeyBinding Key="Escape" Command="{Binding ExitFullScreenCommand}" />
    <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
    <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding ResetZoomCommand}" />
    <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateToPositionCommand}" CommandParameter="1" />
    <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateToPositionCommand}" CommandParameter="2" />
    <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateToPositionCommand}" CommandParameter="3" />
    <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateToPositionCommand}" CommandParameter="4" />
    <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateToPositionCommand}" CommandParameter="5" />
    <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateToPositionCommand}" CommandParameter="6" />
    <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateToPositionCommand}" CommandParameter="7" />
    <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateToPositionCommand}" CommandParameter="8" />
    <KeyBinding Key="D9" Modifiers="Control" Command="{Binding NavigateToPositionCommand}" CommandParameter="9" />
  </Window.InputBindings>

  <Grid x:Name="Frame">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- La barre de titre : le nom, la recherche, le thème, l'aide et les boutons de la fenêtre. Le reste de la barre déplace la fenêtre.
         Elle ne suit pas le zoom : sa hauteur est celle que Windows connaît. -->
    <Border x:Name="TitleBar" Height="40" Background="{DynamicResource Kyf.Brush.Surface}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="0,0,0,1">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsFullScreen}" Value="True" />
                <Condition Binding="{Binding IsPaletteOpen}" Value="False" />
              </MultiDataTrigger.Conditions>
              <Setter Property="Visibility" Value="Collapsed" />
            </MultiDataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="AppTitle" Padding="24,0,8,0">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Width" Value="248" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Layout}" Value="Rail">
                  <Setter Property="Width" Value="112" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Layout}" Value="Tabs">
                  <Setter Property="Width" Value="Auto" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                  <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <!-- L'icône de l'application et son nom, côte à côte. -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="AppIcon" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{x:Static p:ShellText.AppName}" Style="{DynamicResource Kyf.Text.BodyStrong}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- La recherche : un bouton, puis, ouverte, le champ où l'on tape, à la même place ; la liste s'ouvre juste dessous. Les règles
             d'affichage sont sur son conteneur, et le bouton garde le style de l'application. -->
        <Border x:Name="SearchHost" Grid.Column="1" Margin="8,4" MaxWidth="460">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsWelcome}" Value="True" />
                    <Condition Binding="{Binding IsPaletteOpen}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Layout}" Value="Tabs" />
                    <Condition Binding="{Binding IsPaletteOpen}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="HorizontalAlignment" Value="Right" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        <Grid>
        <TextBox x:Name="PaletteQuery" Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" MinHeight="0" Padding="10,0"
                 VerticalContentAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True" LostKeyboardFocus="OnPaletteQueryLeft"
                 Visibility="{Binding IsPaletteOpen, Converter={StaticResource Visible}}"
                 kyf:Field.Placeholder="{x:Static p:ShellText.SearchPlaceholder}" AutomationProperties.Name="{x:Static p:ShellText.SearchPlaceholder}">
          <TextBox.InputBindings>
            <KeyBinding Key="Down" Command="{Binding MoveSelectionCommand}" CommandParameter="1" />
            <KeyBinding Key="Up" Command="{Binding MoveSelectionCommand}" CommandParameter="-1" />
            <KeyBinding Key="Enter" Command="{Binding RunSelectedCommand}" />
            <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <!-- Le bouton s'efface devant le champ ; son conteneur porte la règle, pour que le bouton garde son style. -->
        <Border x:Name="SearchButtonHost">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaletteOpen}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
        <Button x:Name="SearchButton" Command="{Binding OpenPaletteCommand}" MinHeight="0" HorizontalContentAlignment="Stretch"
                WindowChrome.IsHitTestVisibleInChrome="True"
                AutomationProperties.Name="{x:Static p:ShellText.SearchPlaceholder}"
                AutomationProperties.AcceleratorKey="Ctrl+K" ToolTip="{x:Static p:ShellText.SearchPlaceholder}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" Style="{DynamicResource Kyf.Text.Caption}" VerticalAlignment="Center"
                       Visibility="{Binding Layout, Converter={StaticResource ShownIn}, ConverterParameter=Sidebar}" />
            <kyf:Icon x:Name="SearchIcon" Text="&#xE721;" />
            <TextBlock x:Name="SearchLabel" Text="{x:Static p:ShellText.Search}" VerticalAlignment="Center" Margin="8,0,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Layout}" Value="Tabs">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DockPanel>
        </Button>
        </Border>
        </Grid>
        </Border>

        <StackPanel x:Name="TitleActions" Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsWelcome}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Button x:Name="ThemeButton" Command="{Binding ToggleThemeCommand}" Content="{Binding ThemeGlyph}" Style="{DynamicResource Kyf.Button.Icon}" Width="36" Height="32" FontSize="14"
                  WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding CanToggleTheme, Converter={StaticResource Visible}}"
                  ToolTip="{Binding ThemeLabel}" AutomationProperties.Name="{Binding ThemeLabel}" />
          <Button x:Name="HelpButton" Command="{Binding ShowHelpCommand}" Content="&#xE897;" Style="{DynamicResource Kyf.Button.Icon}" Width="36" Height="32" FontSize="14"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="{x:Static p:ShellText.Help}" AutomationProperties.Name="{x:Static p:ShellText.Help}" AutomationProperties.AcceleratorKey="F1" />
        </StackPanel>

        <StackPanel x:Name="WindowButtons" Grid.Column="3" Orientation="Horizontal">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                  <Setter Property="Opacity" Value="0.6" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Button x:Name="MinimizeButton" Style="{DynamicResource Kyf.Button.Window}" Click="OnMinimizeClick" WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="{x:Static p:ShellText.WindowMinimize}" AutomationProperties.Name="{x:Static p:ShellText.WindowMinimize}">
            <kyf:Icon Text="{x:Static kyf:Icons.WindowMinimize}" FontSize="10" />
          </Button>
          <Button x:Name="MaximizeButton" Style="{DynamicResource Kyf.Button.Window}" Click="OnMaximizeClick" WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="{x:Static p:ShellText.WindowMaximize}" AutomationProperties.Name="{x:Static p:ShellText.WindowMaximize}">
            <kyf:Icon x:Name="MaximizeIcon" Text="{x:Static kyf:Icons.WindowMaximize}" FontSize="10" />
          </Button>
          <Button x:Name="CloseButton" Style="{DynamicResource Kyf.Button.WindowClose}" Click="OnCloseClick" WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="{x:Static p:ShellText.WindowClose}" AutomationProperties.Name="{x:Static p:ShellText.WindowClose}">
            <kyf:Icon Text="{x:Static kyf:Icons.WindowClose}" FontSize="10" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

  <Grid x:Name="Root" Grid.Row="1">
    <!-- Espace de travail, agrandi ou réduit par le zoom. Le menu suit la largeur de la fenêtre
         (ShellLayout) : barre latérale, colonne d'icônes, ou onglets en bas ; le contenu ne défile
         jamais horizontalement. -->
    <Grid x:Name="Workspace">
      <Grid.LayoutTransform>
        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
      </Grid.LayoutTransform>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Barre latérale (fenêtre large) ou colonne d'icônes (fenêtre moyenne). -->
      <Border x:Name="Sidebar" Background="{DynamicResource Kyf.Brush.Surface}"
              BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="0,0,1,0">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Width" Value="248" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Layout}" Value="Rail">
                <Setter Property="Width" Value="112" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Layout}" Value="Tabs">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsMenuVisible}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <DockPanel Margin="12,12,12,12">
          <StackPanel DockPanel.Dock="Bottom">
            <Separator Margin="0,8" />
            <ListBox x:Name="SecondaryNavigation" ItemsSource="{Binding SecondaryNavigation}" SelectedItem="{Binding SelectedSecondary}"
                     ItemTemplate="{StaticResource NavigationItemTemplate}" AutomationProperties.Name="{x:Static p:ShellText.SecondaryNavigation}" />
          </StackPanel>
          <ListBox x:Name="MainNavigation" ItemsSource="{Binding MainNavigation}" SelectedItem="{Binding SelectedMain}"
                   ItemTemplate="{StaticResource NavigationItemTemplate}" AutomationProperties.Name="{x:Static p:ShellText.MainNavigation}" />
        </DockPanel>
      </Border>

      <ContentControl x:Name="Page" Grid.Column="1" Content="{Binding Current.Page}" Focusable="False" IsTabStop="False" />

      <!-- Fenêtre étroite : les premières vues en onglets, les autres sous « Plus ». -->
      <Border x:Name="TabBar" Grid.Row="1" Grid.ColumnSpan="2" Padding="8,6,8,8" Style="{StaticResource TabsOnly}"
              Background="{DynamicResource Kyf.Brush.Surface}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ListBox x:Name="TabNavigation" ItemsSource="{Binding TabNavigation}" SelectedItem="{Binding SelectedTab}"
                   ItemTemplate="{StaticResource TabItemTemplate}" AutomationProperties.Name="{x:Static p:ShellText.MainNavigation}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <Button x:Name="MoreButton" Grid.Column="1" Margin="4,4,4,8" Style="{DynamicResource Kyf.Button.Subtle}" Click="OnMoreClick"
                  Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="{x:Static p:ShellText.MoreViews}" ToolTip="{x:Static p:ShellText.MoreViews}">
            <Button.ContextMenu>
              <ContextMenu x:Name="MoreMenu" ItemsSource="{Binding OverflowNavigation}" DisplayMemberPath="Label"
                           AutomationProperties.Name="{x:Static p:ShellText.MoreViews}" />
            </Button.ContextMenu>
            <Border x:Name="MoreBackground" CornerRadius="{DynamicResource Kyf.Radius.Control}" Padding="8,6">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOverflowActive}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
                      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel VerticalAlignment="Center">
                <kyf:Icon Text="{x:Static kyf:Icons.More}" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Static p:ShellText.More}" FontSize="12" TextAlignment="Center" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- Aide des raccourcis (F1). -->
    <kyf:Dialog x:Name="HelpDialog" Title="{x:Static p:ShellText.Help}" IsOpen="{Binding IsHelpOpen}"
                PrimaryButtonText="{x:Static ds:DesignText.Close}" SecondaryButtonText="">
      <!-- La colonne des touches prend la largeur de la plus longue : la description garde le reste. -->
      <ItemsControl ItemsSource="{Binding Shortcuts}" Focusable="False" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,2" Margin="0,0,16,0" CornerRadius="{DynamicResource Kyf.Radius.Control}"
                      Background="{DynamicResource Kyf.Brush.SurfaceAlt}" BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}" BorderThickness="1">
                <TextBlock Text="{Binding Keys}" FontFamily="{DynamicResource Kyf.Font.Code}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{DynamicResource Kyf.Text.Body}" VerticalAlignment="Top" Margin="0,3,0,0" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </kyf:Dialog>

    <!-- Recherche de commandes (Ctrl+K) : on tape dans la barre de titre, la liste s'ouvre juste dessous, à son aplomb. -->
    <Grid x:Name="Palette" Visibility="{Binding IsPaletteOpen, Converter={StaticResource Visible}}">
      <Rectangle x:Name="PaletteScrim" Fill="Transparent">
        <Rectangle.InputBindings>
          <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePaletteCommand}" />
        </Rectangle.InputBindings>
      </Rectangle>
      <Grid x:Name="PaletteCard" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,2,16,16">
        <Border Background="{DynamicResource Kyf.Brush.Surface}" CornerRadius="{DynamicResource Kyf.Radius.Card}"
                Effect="{DynamicResource Kyf.Elevation.Dialog}" />
        <Border Background="{DynamicResource Kyf.Brush.Surface}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1"
                CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="8" AutomationProperties.Name="{x:Static p:ShellText.SearchPlaceholder}">
          <DockPanel>
            <TextBlock x:Name="NoResult" DockPanel.Dock="Top" Text="{x:Static p:ShellText.NoCommand}" Style="{DynamicResource Kyf.Text.Secondary}"
                       Margin="12,8,12,8" Visibility="{Binding HasNoResult, Converter={StaticResource Visible}}" />
            <ListBox x:Name="PaletteResults" ItemsSource="{Binding PaletteResults}" SelectedItem="{Binding SelectedResult}" Focusable="False"
                     MaxHeight="360" AutomationProperties.Name="{x:Static p:ShellText.SearchPlaceholder}">
              <ListBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding RunSelectedCommand}" />
                <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}" />
              </ListBox.InputBindings>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <TextBlock x:Name="Detail" DockPanel.Dock="Right" Text="{Binding Detail}" Style="{DynamicResource Kyf.Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <kyf:Icon Text="{Binding Glyph}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  </DockPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                      <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
