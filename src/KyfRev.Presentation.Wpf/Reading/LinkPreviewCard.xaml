<UserControl x:Class="KyfRev.Presentation.Wpf.Reading.LinkPreviewCard"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages"
             Focusable="False" IsTabStop="False">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>

  <!-- Toute la carte ouvre la fiche : au clavier, Entrée sur le lien fait la même chose, et le focus reste dans le texte. -->
  <kyf:Card x:Name="Card" Padding="0">
    <Button x:Name="OpenButton" Style="{DynamicResource Kyf.Button.Subtle}" Command="{Binding OpenCommand}" Focusable="False" IsTabStop="False"
            HorizontalContentAlignment="Stretch" Padding="14,12" AutomationProperties.Name="{Binding OpenName}">
      <StackPanel>
        <TextBlock Text="{Binding Folder}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,4"
                   Visibility="{Binding HasFolder, Converter={StaticResource Visible}}" />
        <TextBlock x:Name="PreviewTitle" Text="{Binding Title}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
        <TextBlock x:Name="PreviewTags" Text="{Binding Tags}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Link}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasTags, Converter={StaticResource Visible}}" />
        <TextBlock x:Name="PreviewExcerpt" Text="{Binding Excerpt}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding HasText, Converter={StaticResource Visible}}" />
        <TextBlock x:Name="PreviewNoText" Text="{Binding Excerpt}" Style="{DynamicResource Kyf.Text.Secondary}" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
        <kyf:Pill Kind="Archived" Text="{x:Static pages:ReadingText.Archived}" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding IsArchived, Converter={StaticResource Visible}}" />
        <TextBlock x:Name="PreviewStep" Text="{Binding Step}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding HasStep, Converter={StaticResource Visible}}" />
      </StackPanel>
    </Button>
  </kyf:Card>
</UserControl>
