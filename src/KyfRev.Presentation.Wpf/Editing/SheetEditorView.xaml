<UserControl x:Class="KyfRev.Presentation.Wpf.Editing.SheetEditorView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:editing="clr-namespace:KyfRev.Presentation.Wpf.Editing"
             xmlns:reading="clr-namespace:KyfRev.Presentation.Wpf.Reading">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>

  <Grid>
    <!-- Par défaut, le texte se modifie à sa place. -->
    <ContentControl x:Name="VisualHost" Focusable="False" IsTabStop="False" Visibility="{Binding IsVisualShown, Converter={StaticResource Visible}}" />

    <!-- Sur demande, le code à gauche et le rendu à droite : ce qui est masqué ne prend aucune place. -->
    <UniformGrid Rows="1">
      <Border x:Name="SourcePane" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1" CornerRadius="{DynamicResource Kyf.Radius.Control}"
              Visibility="{Binding ShowsSource, Converter={StaticResource Visible}}">
        <editing:MarkdownEditor x:Name="Source" />
      </Border>
      <Border x:Name="PreviewPane" Margin="8,0,0,0" Padding="12,4,0,0" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1" CornerRadius="{DynamicResource Kyf.Radius.Control}"
              Visibility="{Binding ShowsPreview, Converter={StaticResource Visible}}">
        <reading:SheetDocumentViewer x:Name="PreviewText" Reading="{Binding Preview}" KeepsScroll="True" AutomationProperties.Name="{x:Static editing:EditingText.PreviewName}" />
      </Border>
    </UniformGrid>

    <!-- Les fiches proposées après « [[ » : la frappe continue dans le champ, qui passe ses touches à la liste. -->
    <Popup x:Name="ProposalsPopup" IsOpen="{Binding HasProposals, Mode=OneWay}" PlacementTarget="{Binding ElementName=VisualHost}" Placement="Relative" StaysOpen="True" Focusable="False">
      <Border Background="{DynamicResource Kyf.Brush.Surface}" BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}" BorderThickness="1" MinWidth="240" MaxWidth="420" Padding="4">
        <ListBox x:Name="ProposalsList" ItemsSource="{Binding Proposals}" SelectedItem="{Binding ActiveProposal}" Focusable="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static editing:EditingText.Proposals}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False" />
              <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnProposalClicked" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Kyf.Brush.Text}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Folder}" Style="{DynamicResource Kyf.Text.Caption}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Popup>
  </Grid>
</UserControl>
