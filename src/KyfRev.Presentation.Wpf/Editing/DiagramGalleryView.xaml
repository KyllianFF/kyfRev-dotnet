<UserControl x:Class="KyfRev.Presentation.Wpf.Editing.DiagramGalleryView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editing="clr-namespace:KyfRev.Presentation.Wpf.Editing"
             xmlns:reading="clr-namespace:KyfRev.Presentation.Wpf.Reading"
             Height="500">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="140" />
      <ColumnDefinition Width="*" MinWidth="168" />
      <ColumnDefinition Width="280" />
    </Grid.ColumnDefinitions>

    <!-- Les catégories, à gauche. -->
    <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" BorderThickness="0" Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static editing:EditingText.GalleryCategories}" />

    <!-- Une vignette par modèle : elles passent à la ligne, jamais de défilement horizontal. -->
    <ListBox x:Name="ItemList" Grid.Column="1" Margin="8,0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="0" Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static editing:EditingText.GalleryModels}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="128">
            <reading:DiagramView Scene="{Binding Thumbnail}" IsThumbnail="True" Width="128" />
            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- À droite : l'aperçu de l'exemple ; les éléments s'écrivent à l'étape suivante. -->
    <StackPanel Grid.Column="2">
      <reading:DiagramView x:Name="PreviewView" Scene="{Binding Preview}" Width="280" Visibility="{Binding IsDrawn, Converter={StaticResource Visible}}" />
      <reading:MermaidView x:Name="MermaidPreview" Height="176" ClipToBounds="True" Code="{Binding MermaidCode}" Visibility="{Binding IsMermaid, Converter={StaticResource Visible}}" />
      <TextBlock Text="{Binding SelectedItem.Name}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="0,8,0,0" />
      <TextBlock Text="{Binding SelectedItem.Description}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" />
      <TextBlock Text="{x:Static editing:EditingText.GalleryNextStep}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
