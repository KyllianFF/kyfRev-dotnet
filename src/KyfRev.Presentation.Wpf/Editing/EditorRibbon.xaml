                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.Height}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{x:Static editing:EditingText.ImageHeight}" IsHitTestVisible="True" />
                <TextBox x:Name="ImageHeightBox" Grid.Column="1" Width="84" MinHeight="0" Padding="8,2" Margin="0,0,0,2" Text="{Binding ImageHeightCm, UpdateSourceTrigger=LostFocus}" KeyDown="OnSizeBoxKey"
                         FontFamily="{DynamicResource Kyf.Font.Code}" ToolTip="{x:Static editing:EditingText.ImageSizeHelp}" AutomationProperties.Name="{x:Static editing:EditingText.ImageHeight}" />
                <editing:RibbonGlyph Grid.Row="1" Icon="{x:Static editing:RibbonIcons.Width}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{x:Static editing:EditingText.ImageWidth}" IsHitTestVisible="True" />
                <TextBox x:Name="ImageWidthBox" Grid.Row="1" Grid.Column="1" Width="84" MinHeight="0" Padding="8,2" Text="{Binding ImageWidthCm, UpdateSourceTrigger=LostFocus}" KeyDown="OnSizeBoxKey"
                         FontFamily="{DynamicResource Kyf.Font.Code}" ToolTip="{x:Static editing:EditingText.ImageSizeHelp}" AutomationProperties.Name="{x:Static editing:EditingText.ImageWidth}" />
                <Button x:Name="ImageNarrowerButton" Grid.RowSpan="2" Grid.Column="2" Style="{DynamicResource Kyf.Button.Tool}" Content="−" Margin="4,0,0,0" Command="{Binding NudgeImageWidthCommand}" CommandParameter="-5"
                        ToolTip="{x:Static editing:EditingText.ImageNarrower}" AutomationProperties.Name="{x:Static editing:EditingText.ImageNarrower}" />
                <Button x:Name="ImageWiderButton" Grid.RowSpan="2" Grid.Column="3" Style="{DynamicResource Kyf.Button.Tool}" Content="+" Command="{Binding NudgeImageWidthCommand}" CommandParameter="5"
                        ToolTip="{x:Static editing:EditingText.ImageWider}" AutomationProperties.Name="{x:Static editing:EditingText.ImageWider}" />
              </Grid>
            </StackPanel>
          </HeaderedContentControl>

          <!-- Position : dans le texte, ou seule sur sa ligne, à gauche, au centre ou à droite. Le choix en cours ressort. -->
          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.ImagePlaceGroup}" IsEnabled="{Binding CanChangeImage}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ImageInlineChoice" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Image.IsInline}" Command="{Binding ChangeImageCommand}" CommandParameter="align=fil"
                      ToolTip="{x:Static editing:EditingText.ImageInline}" AutomationProperties.Name="{x:Static editing:EditingText.ImageInline}">
                <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.PlaceInline}" />
              </Button>
              <Button x:Name="ImageLeftChoice" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Image.IsLeft}" Command="{Binding ChangeImageCommand}" CommandParameter="align=gauche"
                      ToolTip="{x:Static editing:EditingText.ImageLeft}" AutomationProperties.Name="{x:Static editing:EditingText.ImageLeft}">
                <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.PlaceLeft}" />
              </Button>
              <Button x:Name="ImageCenterChoice" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Image.IsCenter}" Command="{Binding ChangeImageCommand}" CommandParameter="align=centre"
                      ToolTip="{x:Static editing:EditingText.ImageCenter}" AutomationProperties.Name="{x:Static editing:EditingText.ImageCenter}">
                <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.PlaceCenter}" />
              </Button>
              <Button x:Name="ImageRightChoice" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Image.IsRight}" Command="{Binding ChangeImageCommand}" CommandParameter="align=droite"
                      ToolTip="{x:Static editing:EditingText.ImageRight}" AutomationProperties.Name="{x:Static editing:EditingText.ImageRight}">
                <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.PlaceRight}" />
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.ImageReviewGroup}" IsEnabled="{Binding CanChangeImage}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ImageMaskButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding MaskImageCommand}"
                      ToolTip="{x:Static editing:EditingText.ImageMask}" AutomationProperties.Name="{x:Static editing:EditingText.ImageMask}">
                <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.Masks}" Width="28" Height="28" />
              </Button>
              <TextBlock x:Name="ImageMasksLabel" Text="{Binding Tools.Image.MasksLabel}" Style="{DynamicResource Kyf.Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.ImageResetGroup}" IsEnabled="{Binding CanChangeImage}">
            <UniformGrid Rows="2" Columns="2" VerticalAlignment="Center">
              <Button x:Name="ImageNaturalButton" Style="{DynamicResource Kyf.Button.Tool}" Margin="0,0,2,0" Command="{Binding ChangeImageCommand}" CommandParameter="width="
                      ToolTip="{x:Static editing:EditingText.ImageNatural}" AutomationProperties.Name="{x:Static editing:EditingText.ImageNatural}">
                <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.Natural}" />
              </Button>
              <Button x:Name="ImageUncropButton" Style="{DynamicResource Kyf.Button.Tool}" Margin="0,0,2,0" Command="{Binding ChangeImageCommand}" CommandParameter="crop="
                      IsEnabled="{Binding Tools.Image.IsCropped, FallbackValue=False}"
                      ToolTip="{x:Static editing:EditingText.ImageUncrop}" AutomationProperties.Name="{x:Static editing:EditingText.ImageUncrop}">
                <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.Whole}" />
              </Button>
              <Button x:Name="ImageResetButton" Style="{DynamicResource Kyf.Button.Tool}" Margin="0,0,2,0" Command="{Binding ChangeImageCommand}" CommandParameter="reset"
                      ToolTip="{x:Static editing:EditingText.ImageReset}" AutomationProperties.Name="{x:Static editing:EditingText.ImageReset}">
                <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.Reset}" />
              </Button>
            </UniformGrid>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.ImageAltGroup}">
            <TextBox x:Name="ImageAltBox" Width="240" Text="{Binding ImageAlt, UpdateSourceTrigger=LostFocus}" ToolTip="{x:Static editing:EditingText.ImageAltHelp}"
                     AutomationProperties.Name="{x:Static editing:EditingText.ImageAltGroup}" AutomationProperties.HelpText="{x:Static editing:EditingText.ImageAltHelp}" />
          </HeaderedContentControl>
        </WrapPanel>

        <WrapPanel x:Name="InsertPanel" Visibility="Collapsed">
          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.BlocksGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="TableButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Click="OnTableButton" ToolTip="{x:Static editing:EditingText.Table}" AutomationProperties.Name="{x:Static editing:EditingText.Table}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Table}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Table}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="CodeButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.CodeHelp}" AutomationProperties.Name="{x:Static editing:EditingText.Code}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Code}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Code}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
                <Button.ContextMenu>
                  <ContextMenu x:Name="CodeMenu" MaxHeight="420" />
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.IllustrationsGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SchemaButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding OpenGalleryCommand}" CommandParameter="{x:Static editing:GalleryKind.Schema}" ToolTip="{x:Static editing:EditingText.GallerySchemaTitle}" AutomationProperties.Name="{x:Static editing:EditingText.Schema}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Schema}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Schema}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ChartButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding OpenGalleryCommand}" CommandParameter="{x:Static editing:GalleryKind.Chart}" ToolTip="{x:Static editing:EditingText.GalleryChartTitle}" AutomationProperties.Name="{x:Static editing:EditingText.Chart}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Chart}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Chart}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="NetworkButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding OpenNetworkChoiceCommand}" ToolTip="{x:Static editing:EditingText.NetworkTip}"
                      AutomationProperties.Name="{x:Static editing:EditingText.NetworkTip}" Visibility="{Binding CanInsertNetwork, Converter={StaticResource Visible}}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Network}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.NetworkButton}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="SmartArtButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding OpenGalleryCommand}" CommandParameter="{x:Static editing:GalleryKind.SmartArt}" ToolTip="{x:Static editing:EditingText.GallerySmartArtTitle}" AutomationProperties.Name="{x:Static editing:EditingText.SmartArt}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.SmartArt}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.SmartArt}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.LinksGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="LinkButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding StartLinkCommand}" ToolTip="{x:Static editing:EditingText.Link}" AutomationProperties.Name="{x:Static editing:EditingText.Link}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Link}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Link}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ImagesButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Click="OnImagesButton" ToolTip="{x:Static editing:EditingText.Images}" AutomationProperties.Name="{x:Static editing:EditingText.Images}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Picture}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Images}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.OtherGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="FormulaButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding AskFormulaCommand}" ToolTip="{x:Static editing:EditingText.Formula}" AutomationProperties.Name="{x:Static editing:EditingText.Formula}">
                <StackPanel>
                  <TextBlock Text="∑" FontSize="16" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Text}" />
                  <TextBlock Text="{x:Static editing:EditingText.Formula}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="RuleButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding InsertRuleCommand}" ToolTip="{x:Static editing:EditingText.Rule}" AutomationProperties.Name="{x:Static editing:EditingText.Rule}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Rule}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Rule}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </HeaderedContentControl>
          <!-- Les pages : seulement quand la fiche a une feuille (A4, A5, A6). -->
          <HeaderedContentControl x:Name="PagesGroup" Style="{StaticResource Group}" Header="{x:Static editing:EditingText.PagesGroup}"
                                  Visibility="{Binding PageSetup.IsPaged, ElementName=Root, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="PageBreakButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding InsertPageBreakCommand}" CommandParameter="break" ToolTip="{x:Static editing:EditingText.PageBreakHelp}" AutomationProperties.Name="{x:Static editing:EditingText.PageBreak}">
                <StackPanel>
                  <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.PageBreak}" Width="20" Height="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.PageBreak}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="BlankPageButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding InsertPageBreakCommand}" CommandParameter="blank" ToolTip="{x:Static editing:EditingText.BlankPageHelp}" AutomationProperties.Name="{x:Static editing:EditingText.BlankPage}">
                <StackPanel>
                  <editing:RibbonGlyph Icon="{x:Static editing:RibbonIcons.BlankPage}" Width="20" Height="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.BlankPage}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </Grid>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
