<UserControl x:Class="KyfRev.Presentation.Wpf.Editing.EditorRibbon"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:editing="clr-namespace:KyfRev.Presentation.Wpf.Editing">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <editing:ColorBrushConverter x:Key="ColorBrush" />

    <!-- Un groupe du ruban : ses outils, son nom dessous, un filet à droite. -->
    <Style x:Key="Group" TargetType="HeaderedContentControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="HeaderedContentControl">
            <Border BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="0,0,1,0" Padding="8,4" Margin="0,2">
              <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding Header}" Style="{DynamicResource Kyf.Text.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                <ContentPresenter VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Letter" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1" CornerRadius="{DynamicResource Kyf.Radius.Control}">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="4,2,4,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ToggleButton x:Name="PreviewToggle" Style="{DynamicResource Kyf.Button.Tool}" Padding="10,0" Margin="0,0,4,0" Content="{x:Static editing:EditingText.Preview}" IsChecked="{Binding IsPreviewOn}"
                        Visibility="{Binding IsMarkdownShown, Converter={StaticResource Visible}}" />
          <ToggleButton x:Name="MarkdownToggle" Style="{DynamicResource Kyf.Button.Tool}" Padding="10,0" Content="{x:Static editing:EditingText.ShowMarkdown}" IsChecked="{Binding IsMarkdownOn}" IsEnabled="{Binding IsVisualAvailable}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="HomeTab" Style="{DynamicResource Kyf.Button.Tab}" Content="{x:Static editing:EditingText.Home}" IsChecked="True" Click="OnHomeTab" />
          <ToggleButton x:Name="InsertTab" Style="{DynamicResource Kyf.Button.Tab}" Content="{x:Static editing:EditingText.Insert}" Click="OnInsertTab" />
        </StackPanel>
      </DockPanel>

      <Grid>
        <!-- Les groupes passent à la ligne : jamais de défilement horizontal. -->
        <WrapPanel x:Name="HomePanel">
          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.HistoryGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="UndoButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding UndoCommand}" ToolTip="{x:Static editing:EditingText.Undo}" AutomationProperties.Name="{x:Static editing:EditingText.Undo}">
                <kyf:Icon Text="{x:Static kyf:Icons.Undo}" />
              </Button>
              <Button x:Name="RedoButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding RedoCommand}" ToolTip="{x:Static editing:EditingText.Redo}" AutomationProperties.Name="{x:Static editing:EditingText.Redo}">
                <kyf:Icon Text="{x:Static kyf:Icons.Redo}" />
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.StyleGroup}">
            <Button x:Name="StyleButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.StyleName}" AutomationProperties.Name="{x:Static editing:EditingText.StyleName}" MinWidth="110" HorizontalContentAlignment="Stretch">
              <DockPanel>
                <kyf:Icon DockPanel.Dock="Right" Text="{x:Static kyf:Icons.ChevronDown}" FontSize="10" Margin="6,0,0,0" />
                <TextBlock Text="{Binding StyleLabel}" VerticalAlignment="Center" />
              </DockPanel>
              <Button.ContextMenu>
                <ContextMenu x:Name="StyleMenu" />
              </Button.ContextMenu>
            </Button>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.FontGroup}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="SizeButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.FontSize}" AutomationProperties.Name="{x:Static editing:EditingText.FontSize}" MinWidth="52" HorizontalContentAlignment="Stretch">
                  <DockPanel>
                    <kyf:Icon DockPanel.Dock="Right" Text="{x:Static kyf:Icons.ChevronDown}" FontSize="10" Margin="4,0,0,0" />
                    <TextBlock Text="{Binding SizeLabel}" VerticalAlignment="Center" />
                  </DockPanel>
                  <Button.ContextMenu>
                    <ContextMenu x:Name="SizeMenu" />
                  </Button.ContextMenu>
                </Button>
                <Button x:Name="GrowButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding StepFontSizeCommand}" ToolTip="{x:Static editing:EditingText.FontGrow}" AutomationProperties.Name="{x:Static editing:EditingText.FontGrow}">
                  <TextBlock Text="A+" Style="{StaticResource Letter}" />
                  <Button.CommandParameter>
                    <sys:Int32>1</sys:Int32>
                  </Button.CommandParameter>
                </Button>
                <Button x:Name="ShrinkButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding StepFontSizeCommand}" ToolTip="{x:Static editing:EditingText.FontShrink}" AutomationProperties.Name="{x:Static editing:EditingText.FontShrink}">
                  <TextBlock Text="A−" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Text}" />
                  <Button.CommandParameter>
                    <sys:Int32>-1</sys:Int32>
                  </Button.CommandParameter>
                </Button>
                <Button x:Name="ColorButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnColorButton" ToolTip="{x:Static editing:EditingText.TextColor}" AutomationProperties.Name="{x:Static editing:EditingText.TextColor}">
                  <StackPanel Orientation="Horizontal">
                    <StackPanel>
                      <TextBlock Text="A" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Text}" />
                      <Grid Width="14" Height="3">
                        <Border Background="{DynamicResource Kyf.Brush.Text}" />
                        <Border x:Name="ColorBar" Background="{Binding Tools.Color, Converter={StaticResource ColorBrush}}" />
                      </Grid>
                    </StackPanel>
                    <kyf:Icon Text="{x:Static kyf:Icons.ChevronDown}" FontSize="10" Margin="4,0,0,0" />
                  </StackPanel>
                </Button>
                <Button x:Name="CaseButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.ChangeCase}" AutomationProperties.Name="{x:Static editing:EditingText.ChangeCase}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Aa" Style="{StaticResource Letter}" />
                    <kyf:Icon Text="{x:Static kyf:Icons.ChevronDown}" FontSize="10" Margin="4,0,0,0" />
                  </StackPanel>
                  <Button.ContextMenu>
                    <ContextMenu x:Name="CaseMenu" />
                  </Button.ContextMenu>
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Button x:Name="BoldButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Bold}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Bold}" ToolTip="{x:Static editing:EditingText.Bold}" AutomationProperties.Name="{x:Static editing:EditingText.Bold}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Bold}" />
                </Button>
                <Button x:Name="ItalicButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Italic}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Italic}" ToolTip="{x:Static editing:EditingText.Italic}" AutomationProperties.Name="{x:Static editing:EditingText.Italic}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Italic}" />
                </Button>
                <Button x:Name="UnderlineButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Underline}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Underline}" ToolTip="{x:Static editing:EditingText.Underline}" AutomationProperties.Name="{x:Static editing:EditingText.Underline}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Underline}" />
                </Button>
                <Button x:Name="StrikeButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Strike}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Strike}" ToolTip="{x:Static editing:EditingText.Strike}" AutomationProperties.Name="{x:Static editing:EditingText.Strike}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Strike}" />
                </Button>
                <Button x:Name="SuperscriptButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Superscript}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Superscript}" ToolTip="{x:Static editing:EditingText.Superscript}" AutomationProperties.Name="{x:Static editing:EditingText.Superscript}">
                  <TextBlock Text="x²" Style="{StaticResource Letter}" />
                </Button>
                <Button x:Name="SubscriptButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Subscript}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Subscript}" ToolTip="{x:Static editing:EditingText.Subscript}" AutomationProperties.Name="{x:Static editing:EditingText.Subscript}">
                  <TextBlock Text="x₂" Style="{StaticResource Letter}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.ParagraphGroup}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BulletsButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsBullets}" Command="{Binding ToggleListCommand}" CommandParameter="{x:Static editing:ListKind.Bullets}" ToolTip="{x:Static editing:EditingText.Bullets}" AutomationProperties.Name="{x:Static editing:EditingText.Bullets}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Bullets}" />
                </Button>
                <Button x:Name="NumbersButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsNumbers}" Command="{Binding ToggleListCommand}" CommandParameter="{x:Static editing:ListKind.Numbers}" ToolTip="{x:Static editing:EditingText.Numbers}" AutomationProperties.Name="{x:Static editing:EditingText.Numbers}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="1." FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Text}" />
                    <kyf:Icon Text="{x:Static kyf:Icons.ListLines}" Margin="2,0,0,0" />
                  </StackPanel>
                </Button>
                <Button x:Name="TasksButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsTasks}" Command="{Binding ToggleListCommand}" CommandParameter="{x:Static editing:ListKind.Tasks}" ToolTip="{x:Static editing:EditingText.Tasks}" AutomationProperties.Name="{x:Static editing:EditingText.Tasks}">
                  <kyf:Icon Text="{x:Static kyf:Icons.TaskList}" />
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Button x:Name="AlignLeftButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsAlignLeft}" Command="{Binding SetAlignCommand}" CommandParameter="{x:Static editing:TextAlign.Left}" ToolTip="{x:Static editing:EditingText.AlignLeft}" AutomationProperties.Name="{x:Static editing:EditingText.AlignLeft}">
                  <kyf:Icon Text="{x:Static kyf:Icons.AlignLeft}" />
                </Button>
                <Button x:Name="AlignCenterButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsAlignCenter}" Command="{Binding SetAlignCommand}" CommandParameter="{x:Static editing:TextAlign.Center}" ToolTip="{x:Static editing:EditingText.AlignCenter}" AutomationProperties.Name="{x:Static editing:EditingText.AlignCenter}">
                  <kyf:Icon Text="{x:Static kyf:Icons.AlignCenter}" />
                </Button>
                <Button x:Name="AlignRightButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsAlignRight}" Command="{Binding SetAlignCommand}" CommandParameter="{x:Static editing:TextAlign.Right}" ToolTip="{x:Static editing:EditingText.AlignRight}" AutomationProperties.Name="{x:Static editing:EditingText.AlignRight}">
                  <kyf:Icon Text="{x:Static kyf:Icons.AlignRight}" />
                </Button>
                <Button x:Name="AlignJustifyButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsAlignJustify}" Command="{Binding SetAlignCommand}" CommandParameter="{x:Static editing:TextAlign.Justify}" ToolTip="{x:Static editing:EditingText.AlignJustify}" AutomationProperties.Name="{x:Static editing:EditingText.AlignJustify}">
                  <kyf:Icon Text="{x:Static kyf:Icons.AlignJustify}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>

        <WrapPanel x:Name="InsertPanel" Visibility="Collapsed">
          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.BlocksGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="TableButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Click="OnTableButton" ToolTip="{x:Static editing:EditingText.Table}" AutomationProperties.Name="{x:Static editing:EditingText.Table}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Table}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Table}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="CodeButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.CodeHelp}" AutomationProperties.Name="{x:Static editing:EditingText.Code}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Code}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Code}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
                <Button.ContextMenu>
                  <ContextMenu x:Name="CodeMenu" MaxHeight="420" />
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.LinksGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="LinkButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding StartLinkCommand}" ToolTip="{x:Static editing:EditingText.Link}" AutomationProperties.Name="{x:Static editing:EditingText.Link}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Link}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Link}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ImagesButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Click="OnImagesButton" ToolTip="{x:Static editing:EditingText.Images}" AutomationProperties.Name="{x:Static editing:EditingText.Images}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Picture}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Images}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.OtherGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="FormulaButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding AskFormulaCommand}" ToolTip="{x:Static editing:EditingText.Formula}" AutomationProperties.Name="{x:Static editing:EditingText.Formula}">
                <StackPanel>
                  <TextBlock Text="∑" FontSize="16" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Text}" />
                  <TextBlock Text="{x:Static editing:EditingText.Formula}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="RuleButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding InsertRuleCommand}" ToolTip="{x:Static editing:EditingText.Rule}" AutomationProperties.Name="{x:Static editing:EditingText.Rule}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Rule}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Rule}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
