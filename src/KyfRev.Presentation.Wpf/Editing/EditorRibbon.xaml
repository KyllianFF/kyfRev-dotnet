<UserControl x:Class="KyfRev.Presentation.Wpf.Editing.EditorRibbon"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:editing="clr-namespace:KyfRev.Presentation.Wpf.Editing">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <editing:ColorBrushConverter x:Key="ColorBrush" />
    <editing:TableChoiceConverter x:Key="TableChoice" />

    <!-- Un groupe du ruban : ses outils, son nom dessous, un filet à droite. -->
    <Style x:Key="Group" TargetType="HeaderedContentControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="HeaderedContentControl">
            <Border BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="0,0,1,0" Padding="8,4" Margin="0,2">
              <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding Header}" Style="{DynamicResource Kyf.Text.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                <ContentPresenter VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Letter" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
    </Style>
  </UserControl.Resources>

  <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1" CornerRadius="{DynamicResource Kyf.Radius.Control}">
    <DockPanel>
      <!-- Quand la place manque : une barre courte. Toute la mise en forme s'ouvre en volet, l'affichage passe sous « ⋯ ». -->
      <DockPanel x:Name="CompactBar" DockPanel.Dock="Top" Margin="4,2" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <ToggleButton x:Name="CompactTableButton" Style="{DynamicResource Kyf.Button.Tool}" Padding="8,0" Margin="0,0,2,0" Click="OnCompactTable"
                        ToolTip="{x:Static editing:EditingText.TableTab}" AutomationProperties.Name="{x:Static editing:EditingText.TableTab}"
                        Visibility="{Binding IsInTable, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
              <kyf:Icon Text="{x:Static kyf:Icons.Table}" FontSize="12" Foreground="{DynamicResource Kyf.Brush.Primary}" VerticalAlignment="Center" />
              <TextBlock x:Name="CompactTableLabel" Text="{x:Static editing:EditingText.TableTab}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="FormatToggle" Style="{DynamicResource Kyf.Button.Tool}" Padding="8,0" Margin="0,0,2,0" Click="OnFormatToggle"
                        ToolTip="{x:Static editing:EditingText.FormattingHelp}" AutomationProperties.Name="{x:Static editing:EditingText.Formatting}">
            <StackPanel Orientation="Horizontal">
              <kyf:Icon Text="{x:Static kyf:Icons.TextFormat}" VerticalAlignment="Center" />
              <TextBlock x:Name="FormatLabel" Text="{x:Static editing:EditingText.Formatting}" Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Button x:Name="ViewButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.ViewMenu}" AutomationProperties.Name="{x:Static editing:EditingText.ViewMenu}">
            <kyf:Icon Text="{x:Static kyf:Icons.More}" />
            <Button.ContextMenu>
              <ContextMenu x:Name="ViewMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem x:Name="HistoryItem" Header="{x:Static editing:EditingText.History}" Command="{Binding OpenHistoryCommand}" />
                <MenuItem x:Name="MarkdownItem" Header="{x:Static editing:EditingText.ShowMarkdown}" IsCheckable="True" IsChecked="{Binding IsMarkdownOn}" IsEnabled="{Binding IsVisualAvailable}" />
                <MenuItem x:Name="PreviewItem" Header="{x:Static editing:EditingText.Preview}" IsCheckable="True" IsChecked="{Binding IsPreviewOn}"
                          Visibility="{Binding IsMarkdownShown, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" ClipToBounds="True">
          <Button x:Name="CompactUndoButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding UndoCommand}" ToolTip="{x:Static editing:EditingText.Undo}" AutomationProperties.Name="{x:Static editing:EditingText.Undo}">
            <kyf:Icon Text="{x:Static kyf:Icons.Undo}" />
          </Button>
          <Button x:Name="CompactRedoButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding RedoCommand}" ToolTip="{x:Static editing:EditingText.Redo}" AutomationProperties.Name="{x:Static editing:EditingText.Redo}">
            <kyf:Icon Text="{x:Static kyf:Icons.Redo}" />
          </Button>
          <Button x:Name="CompactStyleButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.StyleName}" AutomationProperties.Name="{x:Static editing:EditingText.StyleName}"
                  MinWidth="96" MaxWidth="150" Margin="2,0" HorizontalContentAlignment="Stretch">
            <DockPanel>
              <kyf:Icon DockPanel.Dock="Right" Text="{x:Static kyf:Icons.ChevronDown}" FontSize="10" Margin="6,0,0,0" />
              <TextBlock Text="{Binding StyleLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Button.ContextMenu>
              <ContextMenu x:Name="CompactStyleMenu" />
            </Button.ContextMenu>
          </Button>
          <Button x:Name="CompactBoldButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Bold}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Bold}" ToolTip="{x:Static editing:EditingText.Bold}" AutomationProperties.Name="{x:Static editing:EditingText.Bold}">
            <kyf:Icon Text="{x:Static kyf:Icons.Bold}" />
          </Button>
          <Button x:Name="CompactItalicButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Italic}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Italic}" ToolTip="{x:Static editing:EditingText.Italic}" AutomationProperties.Name="{x:Static editing:EditingText.Italic}">
            <kyf:Icon Text="{x:Static kyf:Icons.Italic}" />
          </Button>
          <Button x:Name="CompactBulletsButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsBullets}" Command="{Binding ToggleListCommand}" CommandParameter="{x:Static editing:ListKind.Bullets}" ToolTip="{x:Static editing:EditingText.Bullets}" AutomationProperties.Name="{x:Static editing:EditingText.Bullets}">
            <kyf:Icon Text="{x:Static kyf:Icons.Bullets}" />
          </Button>
          <Button x:Name="CompactLinkButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding StartLinkCommand}" ToolTip="{x:Static editing:EditingText.Link}" AutomationProperties.Name="{x:Static editing:EditingText.Link}">
            <kyf:Icon Text="{x:Static kyf:Icons.Link}" />
          </Button>
        </StackPanel>
      </DockPanel>

      <!-- Les onglets ; quand la place manque, ils n'apparaissent qu'avec le volet, et l'affichage passe sous « ⋯ ». -->
      <DockPanel x:Name="TabRow" DockPanel.Dock="Top" Margin="4,2,4,0">
        <StackPanel x:Name="ViewButtons" DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="HistoryButton" Style="{DynamicResource Kyf.Button.Tool}" Padding="10,0" Margin="0,0,4,0" Content="{x:Static editing:EditingText.History}" Command="{Binding OpenHistoryCommand}" />
          <ToggleButton x:Name="PreviewToggle" Style="{DynamicResource Kyf.Button.Tool}" Padding="10,0" Margin="0,0,4,0" Content="{x:Static editing:EditingText.Preview}" IsChecked="{Binding IsPreviewOn}"
                        Visibility="{Binding IsMarkdownShown, Converter={StaticResource Visible}}" />
          <ToggleButton x:Name="MarkdownToggle" Style="{DynamicResource Kyf.Button.Tool}" Padding="10,0" Content="{x:Static editing:EditingText.ShowMarkdown}" IsChecked="{Binding IsMarkdownOn}" IsEnabled="{Binding IsVisualAvailable}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="HomeTab" Style="{DynamicResource Kyf.Button.Tab}" Content="{x:Static editing:EditingText.Home}" IsChecked="True" Click="OnHomeTab" />
          <ToggleButton x:Name="InsertTab" Style="{DynamicResource Kyf.Button.Tab}" Content="{x:Static editing:EditingText.Insert}" Click="OnInsertTab" />
          <!-- L'onglet du tableau : il n'existe que le curseur dans un tableau, comme dans Word. -->
          <ToggleButton x:Name="TableTab" Style="{DynamicResource Kyf.Button.Tab}" Click="OnTableTab" AutomationProperties.Name="{x:Static editing:EditingText.TableTab}"
                        Visibility="{Binding IsInTable, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
              <kyf:Icon Text="{x:Static kyf:Icons.Table}" FontSize="12" Foreground="{DynamicResource Kyf.Brush.Primary}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{x:Static editing:EditingText.TableTab}" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
        </StackPanel>
      </DockPanel>

      <!-- En barre courte, le volet garde une hauteur mesurée et défile verticalement : le texte reste en vue dessous. -->
      <ScrollViewer x:Name="Panels" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
      <Grid>
        <!-- Les groupes passent à la ligne : jamais de défilement horizontal. -->
        <WrapPanel x:Name="HomePanel">
          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.HistoryGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="UndoButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding UndoCommand}" ToolTip="{x:Static editing:EditingText.Undo}" AutomationProperties.Name="{x:Static editing:EditingText.Undo}">
                <kyf:Icon Text="{x:Static kyf:Icons.Undo}" />
              </Button>
              <Button x:Name="RedoButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding RedoCommand}" ToolTip="{x:Static editing:EditingText.Redo}" AutomationProperties.Name="{x:Static editing:EditingText.Redo}">
                <kyf:Icon Text="{x:Static kyf:Icons.Redo}" />
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.StyleGroup}">
            <Button x:Name="StyleButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.StyleName}" AutomationProperties.Name="{x:Static editing:EditingText.StyleName}" MinWidth="110" HorizontalContentAlignment="Stretch">
              <DockPanel>
                <kyf:Icon DockPanel.Dock="Right" Text="{x:Static kyf:Icons.ChevronDown}" FontSize="10" Margin="6,0,0,0" />
                <TextBlock Text="{Binding StyleLabel}" VerticalAlignment="Center" />
              </DockPanel>
              <Button.ContextMenu>
                <ContextMenu x:Name="StyleMenu" />
              </Button.ContextMenu>
            </Button>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.FontGroup}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="SizeButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.FontSize}" AutomationProperties.Name="{x:Static editing:EditingText.FontSize}" MinWidth="52" HorizontalContentAlignment="Stretch">
                  <DockPanel>
                    <kyf:Icon DockPanel.Dock="Right" Text="{x:Static kyf:Icons.ChevronDown}" FontSize="10" Margin="4,0,0,0" />
                    <TextBlock Text="{Binding SizeLabel}" VerticalAlignment="Center" />
                  </DockPanel>
                  <Button.ContextMenu>
                    <ContextMenu x:Name="SizeMenu" />
                  </Button.ContextMenu>
                </Button>
                <Button x:Name="GrowButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding StepFontSizeCommand}" ToolTip="{x:Static editing:EditingText.FontGrow}" AutomationProperties.Name="{x:Static editing:EditingText.FontGrow}">
                  <TextBlock Text="A+" Style="{StaticResource Letter}" />
                  <Button.CommandParameter>
                    <sys:Int32>1</sys:Int32>
                  </Button.CommandParameter>
                </Button>
                <Button x:Name="ShrinkButton" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding StepFontSizeCommand}" ToolTip="{x:Static editing:EditingText.FontShrink}" AutomationProperties.Name="{x:Static editing:EditingText.FontShrink}">
                  <TextBlock Text="A−" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Text}" />
                  <Button.CommandParameter>
                    <sys:Int32>-1</sys:Int32>
                  </Button.CommandParameter>
                </Button>
                <Button x:Name="ColorButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnColorButton" ToolTip="{x:Static editing:EditingText.TextColor}" AutomationProperties.Name="{x:Static editing:EditingText.TextColor}">
                  <StackPanel Orientation="Horizontal">
                    <StackPanel>
                      <TextBlock Text="A" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Text}" />
                      <Grid Width="14" Height="3">
                        <Border Background="{DynamicResource Kyf.Brush.Text}" />
                        <Border x:Name="ColorBar" Background="{Binding Tools.Color, Converter={StaticResource ColorBrush}}" />
                      </Grid>
                    </StackPanel>
                    <kyf:Icon Text="{x:Static kyf:Icons.ChevronDown}" FontSize="10" Margin="4,0,0,0" />
                  </StackPanel>
                </Button>
                <Button x:Name="CaseButton" Style="{DynamicResource Kyf.Button.Tool}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.ChangeCase}" AutomationProperties.Name="{x:Static editing:EditingText.ChangeCase}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Aa" Style="{StaticResource Letter}" />
                    <kyf:Icon Text="{x:Static kyf:Icons.ChevronDown}" FontSize="10" Margin="4,0,0,0" />
                  </StackPanel>
                  <Button.ContextMenu>
                    <ContextMenu x:Name="CaseMenu" />
                  </Button.ContextMenu>
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Button x:Name="BoldButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Bold}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Bold}" ToolTip="{x:Static editing:EditingText.Bold}" AutomationProperties.Name="{x:Static editing:EditingText.Bold}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Bold}" />
                </Button>
                <Button x:Name="ItalicButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Italic}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Italic}" ToolTip="{x:Static editing:EditingText.Italic}" AutomationProperties.Name="{x:Static editing:EditingText.Italic}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Italic}" />
                </Button>
                <Button x:Name="UnderlineButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Underline}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Underline}" ToolTip="{x:Static editing:EditingText.Underline}" AutomationProperties.Name="{x:Static editing:EditingText.Underline}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Underline}" />
                </Button>
                <Button x:Name="StrikeButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Strike}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Strike}" ToolTip="{x:Static editing:EditingText.Strike}" AutomationProperties.Name="{x:Static editing:EditingText.Strike}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Strike}" />
                </Button>
                <Button x:Name="SuperscriptButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Superscript}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Superscript}" ToolTip="{x:Static editing:EditingText.Superscript}" AutomationProperties.Name="{x:Static editing:EditingText.Superscript}">
                  <TextBlock Text="x²" Style="{StaticResource Letter}" />
                </Button>
                <Button x:Name="SubscriptButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Subscript}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Subscript}" ToolTip="{x:Static editing:EditingText.Subscript}" AutomationProperties.Name="{x:Static editing:EditingText.Subscript}">
                  <TextBlock Text="x₂" Style="{StaticResource Letter}" />
                </Button>
                <Button x:Name="InlineCodeButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Code}" Command="{Binding ToggleMarkCommand}" CommandParameter="{x:Static editing:InlineMark.Code}" ToolTip="{x:Static editing:EditingText.InlineCode}" AutomationProperties.Name="{x:Static editing:EditingText.InlineCode}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Code}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.ParagraphGroup}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="BulletsButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsBullets}" Command="{Binding ToggleListCommand}" CommandParameter="{x:Static editing:ListKind.Bullets}" ToolTip="{x:Static editing:EditingText.Bullets}" AutomationProperties.Name="{x:Static editing:EditingText.Bullets}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Bullets}" />
                </Button>
                <Button x:Name="NumbersButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsNumbers}" Command="{Binding ToggleListCommand}" CommandParameter="{x:Static editing:ListKind.Numbers}" ToolTip="{x:Static editing:EditingText.Numbers}" AutomationProperties.Name="{x:Static editing:EditingText.Numbers}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="1." FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Text}" />
                    <kyf:Icon Text="{x:Static kyf:Icons.ListLines}" Margin="2,0,0,0" />
                  </StackPanel>
                </Button>
                <Button x:Name="TasksButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsTasks}" Command="{Binding ToggleListCommand}" CommandParameter="{x:Static editing:ListKind.Tasks}" ToolTip="{x:Static editing:EditingText.Tasks}" AutomationProperties.Name="{x:Static editing:EditingText.Tasks}">
                  <kyf:Icon Text="{x:Static kyf:Icons.TaskList}" />
                </Button>
                <Button x:Name="QuoteButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding Tools.Quote}" Command="{Binding ToggleQuoteCommand}" ToolTip="{x:Static editing:EditingText.Quote}" AutomationProperties.Name="{x:Static editing:EditingText.Quote}">
                  <kyf:Icon Text="{x:Static kyf:Icons.Quote}" />
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <Button x:Name="AlignLeftButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsAlignLeft}" Command="{Binding SetAlignCommand}" CommandParameter="{x:Static editing:TextAlign.Left}" ToolTip="{x:Static editing:EditingText.AlignLeft}" AutomationProperties.Name="{x:Static editing:EditingText.AlignLeft}">
                  <kyf:Icon Text="{x:Static kyf:Icons.AlignLeft}" />
                </Button>
                <Button x:Name="AlignCenterButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsAlignCenter}" Command="{Binding SetAlignCommand}" CommandParameter="{x:Static editing:TextAlign.Center}" ToolTip="{x:Static editing:EditingText.AlignCenter}" AutomationProperties.Name="{x:Static editing:EditingText.AlignCenter}">
                  <kyf:Icon Text="{x:Static kyf:Icons.AlignCenter}" />
                </Button>
                <Button x:Name="AlignRightButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsAlignRight}" Command="{Binding SetAlignCommand}" CommandParameter="{x:Static editing:TextAlign.Right}" ToolTip="{x:Static editing:EditingText.AlignRight}" AutomationProperties.Name="{x:Static editing:EditingText.AlignRight}">
                  <kyf:Icon Text="{x:Static kyf:Icons.AlignRight}" />
                </Button>
                <Button x:Name="AlignJustifyButton" Style="{DynamicResource Kyf.Button.Tool}" Tag="{Binding IsAlignJustify}" Command="{Binding SetAlignCommand}" CommandParameter="{x:Static editing:TextAlign.Justify}" ToolTip="{x:Static editing:EditingText.AlignJustify}" AutomationProperties.Name="{x:Static editing:EditingText.AlignJustify}">
                  <kyf:Icon Text="{x:Static kyf:Icons.AlignJustify}" />
                </Button>
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>

        <WrapPanel x:Name="TablePanel" Visibility="Collapsed">
          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.HeadersGroup}">
            <StackPanel>
                <CheckBox x:Name="HeaderRowBox" Content="{x:Static editing:EditingText.HeaderRow}" Margin="0,0,0,2" Command="{Binding ChangeTableCommand}" CommandParameter="enteteLigne"
                          IsChecked="{Binding Tools.Table.HeaderRow, Mode=OneWay}" />
                <CheckBox x:Name="HeaderColumnBox" Content="{x:Static editing:EditingText.HeaderColumn}" Margin="0,0,0,2" Command="{Binding ChangeTableCommand}" CommandParameter="enteteColonne"
                          IsChecked="{Binding Tools.Table.HeaderColumn, Mode=OneWay}" />
                <CheckBox x:Name="TotalRowBox" Content="{x:Static editing:EditingText.TotalRow}" Margin="0,0,0,2" Command="{Binding ChangeTableCommand}" CommandParameter="total"
                          IsChecked="{Binding Tools.Table.Total, Mode=OneWay}" />
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.BandsGroup}">
            <StackPanel>
                <RadioButton x:Name="BandsNoneChoice" GroupName="TableBands" Content="{x:Static editing:EditingText.BandsNone}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="bandes=aucune"
                             IsChecked="{Binding Tools.Table.Bands, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=aucune}" />
                <RadioButton x:Name="BandsRowsChoice" GroupName="TableBands" Content="{x:Static editing:EditingText.BandsRows}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="bandes=lignes"
                             IsChecked="{Binding Tools.Table.Bands, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=lignes}" />
                <RadioButton x:Name="BandsColumnsChoice" GroupName="TableBands" Content="{x:Static editing:EditingText.BandsColumns}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="bandes=colonnes"
                             IsChecked="{Binding Tools.Table.Bands, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=colonnes}" />
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.LinesGroup}">
            <UniformGrid Columns="2">
                <RadioButton x:Name="LinesAllChoice" GroupName="TableLines" Content="{x:Static editing:EditingText.LinesAll}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="traits=tous"
                             IsChecked="{Binding Tools.Table.Lines, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=tous}" />
                <RadioButton x:Name="LinesHorizontalChoice" GroupName="TableLines" Content="{x:Static editing:EditingText.LinesHorizontal}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="traits=horizontaux"
                             IsChecked="{Binding Tools.Table.Lines, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=horizontaux}" />
                <RadioButton x:Name="LinesVerticalChoice" GroupName="TableLines" Content="{x:Static editing:EditingText.LinesVertical}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="traits=verticaux"
                             IsChecked="{Binding Tools.Table.Lines, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=verticaux}" />
                <RadioButton x:Name="LinesOutlineChoice" GroupName="TableLines" Content="{x:Static editing:EditingText.LinesOutline}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="traits=contour"
                             IsChecked="{Binding Tools.Table.Lines, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=contour}" />
                <RadioButton x:Name="LinesHeaderChoice" GroupName="TableLines" Content="{x:Static editing:EditingText.LinesHeader}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="traits=entete"
                             IsChecked="{Binding Tools.Table.Lines, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=entete}" />
                <RadioButton x:Name="LinesNoneChoice" GroupName="TableLines" Content="{x:Static editing:EditingText.LinesNone}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="traits=aucun"
                             IsChecked="{Binding Tools.Table.Lines, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=aucun}" />
            </UniformGrid>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.ThemeGroup}">
            <UniformGrid Columns="3">
                <RadioButton x:Name="ThemeSoberChoice" GroupName="TableTheme" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="theme=sobre"
                             IsChecked="{Binding Tools.Table.Theme, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=sobre}" AutomationProperties.Name="{x:Static editing:EditingText.ThemeSober}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="16" BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.Divider}" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" />
                        <Border Grid.Row="1" Background="{DynamicResource Kyf.Brush.TableSoberBand}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{x:Static editing:EditingText.ThemeSober}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ThemeForestChoice" GroupName="TableTheme" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="theme=foret"
                             IsChecked="{Binding Tools.Table.Theme, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=foret}" AutomationProperties.Name="{x:Static editing:EditingText.ThemeForest}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="16" BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.TableForestLine}" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource Kyf.Brush.TableForestHeader}" />
                        <Border Grid.Row="1" Background="{DynamicResource Kyf.Brush.TableForestBand}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{x:Static editing:EditingText.ThemeForest}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ThemeAmberChoice" GroupName="TableTheme" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="theme=ambre"
                             IsChecked="{Binding Tools.Table.Theme, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=ambre}" AutomationProperties.Name="{x:Static editing:EditingText.ThemeAmber}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="16" BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.TableAmberLine}" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource Kyf.Brush.TableAmberHeader}" />
                        <Border Grid.Row="1" Background="{DynamicResource Kyf.Brush.TableAmberBand}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{x:Static editing:EditingText.ThemeAmber}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ThemeSlateChoice" GroupName="TableTheme" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="theme=ardoise"
                             IsChecked="{Binding Tools.Table.Theme, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=ardoise}" AutomationProperties.Name="{x:Static editing:EditingText.ThemeSlate}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="16" BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.TableSlateLine}" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource Kyf.Brush.TableSlateHeader}" />
                        <Border Grid.Row="1" Background="{DynamicResource Kyf.Brush.TableSlateBand}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{x:Static editing:EditingText.ThemeSlate}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ThemePlumChoice" GroupName="TableTheme" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="theme=prune"
                             IsChecked="{Binding Tools.Table.Theme, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=prune}" AutomationProperties.Name="{x:Static editing:EditingText.ThemePlum}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="16" BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.TablePlumLine}" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource Kyf.Brush.TablePlumHeader}" />
                        <Border Grid.Row="1" Background="{DynamicResource Kyf.Brush.TablePlumBand}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{x:Static editing:EditingText.ThemePlum}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ThemeInkChoice" GroupName="TableTheme" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="theme=encre"
                             IsChecked="{Binding Tools.Table.Theme, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=encre}" AutomationProperties.Name="{x:Static editing:EditingText.ThemeInk}">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="16" BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.TableInkLine}" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource Kyf.Brush.TableInkHeader}" />
                        <Border Grid.Row="1" Background="{DynamicResource Kyf.Brush.TableInkBand}" />
                      </Grid>
                    </Border>
                    <TextBlock Text="{x:Static editing:EditingText.ThemeInk}" VerticalAlignment="Center" />
                  </StackPanel>
                </RadioButton>
            </UniformGrid>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.ColumnGroup}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                  <RadioButton x:Name="ColumnLeftChoice" GroupName="TableAlign" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding ChangeTableCommand}" CommandParameter="aligner=left"
                               IsChecked="{Binding Tools.Table.ColumnAlign, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=left}"
                               ToolTip="{x:Static editing:EditingText.ColumnLeft}" AutomationProperties.Name="{x:Static editing:EditingText.ColumnLeft}">
                    <kyf:Icon Text="{x:Static kyf:Icons.AlignLeft}" />
                  </RadioButton>
                  <RadioButton x:Name="ColumnCenterChoice" GroupName="TableAlign" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding ChangeTableCommand}" CommandParameter="aligner=center"
                               IsChecked="{Binding Tools.Table.ColumnAlign, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=center}"
                               ToolTip="{x:Static editing:EditingText.ColumnCenter}" AutomationProperties.Name="{x:Static editing:EditingText.ColumnCenter}">
                    <kyf:Icon Text="{x:Static kyf:Icons.AlignCenter}" />
                  </RadioButton>
                  <RadioButton x:Name="ColumnRightChoice" GroupName="TableAlign" Style="{DynamicResource Kyf.Button.Tool}" Command="{Binding ChangeTableCommand}" CommandParameter="aligner=right"
                               IsChecked="{Binding Tools.Table.ColumnAlign, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=right}"
                               ToolTip="{x:Static editing:EditingText.ColumnRight}" AutomationProperties.Name="{x:Static editing:EditingText.ColumnRight}">
                    <kyf:Icon Text="{x:Static kyf:Icons.AlignRight}" />
                  </RadioButton>
              </StackPanel>
                <CheckBox x:Name="HiddenInReviewBox" Content="{x:Static editing:EditingText.HiddenInReview}" ToolTip="{x:Static editing:EditingText.HiddenInReviewHelp}" Margin="0,0,0,2"
                          Command="{Binding ChangeTableCommand}" CommandParameter="reviser" IsChecked="{Binding Tools.Table.ColumnHidden, Mode=OneWay}" />
                <Button x:Name="SortButton" Style="{DynamicResource Kyf.Button.Subtle}" Content="{x:Static editing:EditingText.SortRows}" ToolTip="{x:Static editing:EditingText.SortRowsHelp}"
                        HorizontalAlignment="Left" Command="{Binding ChangeTableCommand}" CommandParameter="trier" IsEnabled="{Binding Tools.Table.Sortable, FallbackValue=False}" />
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.RowsColumnsGroup}">
            <UniformGrid Columns="3">
                <Button x:Name="RowBeforeButton" Style="{DynamicResource Kyf.Button.Tool}" Content="{x:Static editing:EditingText.RowBeforeShort}" Padding="6,2" Margin="0,0,2,2" HorizontalContentAlignment="Left"
                        ToolTip="{x:Static editing:EditingText.RowBefore}" AutomationProperties.Name="{x:Static editing:EditingText.RowBefore}" Command="{Binding ChangeTableCommand}" CommandParameter="action=rowBefore" />
                <Button x:Name="RowAfterButton" Style="{DynamicResource Kyf.Button.Tool}" Content="{x:Static editing:EditingText.RowAfterShort}" Padding="6,2" Margin="0,0,2,2" HorizontalContentAlignment="Left"
                        ToolTip="{x:Static editing:EditingText.RowAfter}" AutomationProperties.Name="{x:Static editing:EditingText.RowAfter}" Command="{Binding ChangeTableCommand}" CommandParameter="action=rowAfter" />
                <Button x:Name="DeleteRowButton" Style="{DynamicResource Kyf.Button.Tool}" Content="{x:Static editing:EditingText.DeleteRowShort}" Padding="6,2" Margin="0,0,2,2" HorizontalContentAlignment="Left"
                        ToolTip="{x:Static editing:EditingText.DeleteRow}" AutomationProperties.Name="{x:Static editing:EditingText.DeleteRow}" Command="{Binding ChangeTableCommand}" CommandParameter="action=deleteRow" />
                <Button x:Name="ColumnBeforeButton" Style="{DynamicResource Kyf.Button.Tool}" Content="{x:Static editing:EditingText.ColumnBeforeShort}" Padding="6,2" Margin="0,0,2,2" HorizontalContentAlignment="Left"
                        ToolTip="{x:Static editing:EditingText.ColumnBefore}" AutomationProperties.Name="{x:Static editing:EditingText.ColumnBefore}" Command="{Binding ChangeTableCommand}" CommandParameter="action=columnBefore" />
                <Button x:Name="ColumnAfterButton" Style="{DynamicResource Kyf.Button.Tool}" Content="{x:Static editing:EditingText.ColumnAfterShort}" Padding="6,2" Margin="0,0,2,2" HorizontalContentAlignment="Left"
                        ToolTip="{x:Static editing:EditingText.ColumnAfter}" AutomationProperties.Name="{x:Static editing:EditingText.ColumnAfter}" Command="{Binding ChangeTableCommand}" CommandParameter="action=columnAfter" />
                <Button x:Name="DeleteColumnButton" Style="{DynamicResource Kyf.Button.Tool}" Content="{x:Static editing:EditingText.DeleteColumnShort}" Padding="6,2" Margin="0,0,2,2" HorizontalContentAlignment="Left"
                        ToolTip="{x:Static editing:EditingText.DeleteColumn}" AutomationProperties.Name="{x:Static editing:EditingText.DeleteColumn}" Command="{Binding ChangeTableCommand}" CommandParameter="action=deleteColumn" />
                <Button x:Name="DeleteTableButton" Style="{DynamicResource Kyf.Button.Tool}" Content="{x:Static editing:EditingText.DeleteTableShort}" Padding="6,2" Margin="0,0,2,2" HorizontalContentAlignment="Left"
                        ToolTip="{x:Static editing:EditingText.DeleteTable}" AutomationProperties.Name="{x:Static editing:EditingText.DeleteTable}" Command="{Binding ChangeTableCommand}" CommandParameter="action=deleteTable" />
            </UniformGrid>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.WidthGroup}">
            <StackPanel>
                <RadioButton x:Name="WidthPageChoice" GroupName="TableWidth" Content="{x:Static editing:EditingText.WidthPage}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="largeur=page"
                             IsChecked="{Binding Tools.Table.Width, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=page}" />
                <RadioButton x:Name="WidthFitChoice" GroupName="TableWidth" Content="{x:Static editing:EditingText.WidthFit}" Margin="0,0,10,2" Command="{Binding ChangeTableCommand}" CommandParameter="largeur=ajustee"
                             IsChecked="{Binding Tools.Table.Width, Mode=OneWay, Converter={StaticResource TableChoice}, ConverterParameter=ajustee}" />
            </StackPanel>
          </HeaderedContentControl>

        </WrapPanel>

        <WrapPanel x:Name="InsertPanel" Visibility="Collapsed">
          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.BlocksGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="TableButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Click="OnTableButton" ToolTip="{x:Static editing:EditingText.Table}" AutomationProperties.Name="{x:Static editing:EditingText.Table}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Table}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Table}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="CodeButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Click="OnMenuButton" ToolTip="{x:Static editing:EditingText.CodeHelp}" AutomationProperties.Name="{x:Static editing:EditingText.Code}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Code}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Code}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
                <Button.ContextMenu>
                  <ContextMenu x:Name="CodeMenu" MaxHeight="420" />
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.IllustrationsGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SchemaButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding OpenGalleryCommand}" CommandParameter="{x:Static editing:GalleryKind.Schema}" ToolTip="{x:Static editing:EditingText.GallerySchemaTitle}" AutomationProperties.Name="{x:Static editing:EditingText.Schema}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Schema}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Schema}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ChartButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding OpenGalleryCommand}" CommandParameter="{x:Static editing:GalleryKind.Chart}" ToolTip="{x:Static editing:EditingText.GalleryChartTitle}" AutomationProperties.Name="{x:Static editing:EditingText.Chart}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Chart}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Chart}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="NetworkButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding OpenNetworkChoiceCommand}" ToolTip="{x:Static editing:EditingText.NetworkTip}"
                      AutomationProperties.Name="{x:Static editing:EditingText.NetworkTip}" Visibility="{Binding CanInsertNetwork, Converter={StaticResource Visible}}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Network}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.NetworkButton}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="SmartArtButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding OpenGalleryCommand}" CommandParameter="{x:Static editing:GalleryKind.SmartArt}" ToolTip="{x:Static editing:EditingText.GallerySmartArtTitle}" AutomationProperties.Name="{x:Static editing:EditingText.SmartArt}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.SmartArt}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.SmartArt}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.LinksGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="LinkButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding StartLinkCommand}" ToolTip="{x:Static editing:EditingText.Link}" AutomationProperties.Name="{x:Static editing:EditingText.Link}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Link}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Link}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="ImagesButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Click="OnImagesButton" ToolTip="{x:Static editing:EditingText.Images}" AutomationProperties.Name="{x:Static editing:EditingText.Images}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Picture}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Images}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl Style="{StaticResource Group}" Header="{x:Static editing:EditingText.OtherGroup}">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="FormulaButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding AskFormulaCommand}" ToolTip="{x:Static editing:EditingText.Formula}" AutomationProperties.Name="{x:Static editing:EditingText.Formula}">
                <StackPanel>
                  <TextBlock Text="∑" FontSize="16" Height="20" LineHeight="20" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" Foreground="{DynamicResource Kyf.Brush.Text}" />
                  <TextBlock Text="{x:Static editing:EditingText.Formula}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="RuleButton" Style="{DynamicResource Kyf.Button.ToolLarge}" Command="{Binding InsertRuleCommand}" ToolTip="{x:Static editing:EditingText.Rule}" AutomationProperties.Name="{x:Static editing:EditingText.Rule}">
                <StackPanel>
                  <kyf:Icon Text="{x:Static kyf:Icons.Rule}" FontSize="20" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Static editing:EditingText.Rule}" Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Text}" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </HeaderedContentControl>
        </WrapPanel>
      </Grid>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
