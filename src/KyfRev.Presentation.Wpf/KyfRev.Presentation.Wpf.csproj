<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Description>Présentation WPF de kyfRev : coquille (navigation, recherche de commandes, aide, mode concentration, zoom), vues et modèles de vue.</Description>
  </PropertyGroup>

  <!-- Aucune infrastructure concrète : la racine de composition (KyfRev.App) les relie. -->
  <ItemGroup>
    <ProjectReference Include="..\KyfRev.Application\KyfRev.Application.csproj" />
    <ProjectReference Include="..\KyfRev.DesignSystem\KyfRev.DesignSystem.csproj" />
    <ProjectReference Include="..\KyfRev.Extensions.Host\KyfRev.Extensions.Host.csproj" />
    <ProjectReference Include="..\KyfRev.Modules.Citations\KyfRev.Modules.Citations.csproj" />
    <ProjectReference Include="..\KyfRev.Modules.Schemas\KyfRev.Modules.Schemas.csproj" />
    <ProjectReference Include="..\KyfRev.Rendering\KyfRev.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="WpfMath" />
  </ItemGroup>

  <!-- Le paquet de l'éditeur visuel, construit par tools/visual-editor. -->
  <ItemGroup>
    <EmbeddedResource Include="Editing\Web\**\*" LogicalName="kyfrev-web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Schemas\Web\**\*" LogicalName="kyfrev-schemas/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Extensions\Web\**\*" LogicalName="kyfrev-extensions/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Reading\partage.css" LogicalName="kyfrev-partage.css" />
    <EmbeddedResource Include="..\..\assets\icon\kyfrev.ico" LogicalName="kyfrev-icone.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KyfRev.Presentation.Wpf.Tests" />
  </ItemGroup>

</Project>
