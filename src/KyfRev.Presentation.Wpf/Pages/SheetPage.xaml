<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.SheetPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:reading="clr-namespace:KyfRev.Presentation.Wpf.Reading"
             xmlns:editing="clr-namespace:KyfRev.Presentation.Wpf.Editing"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Le titre d'une partie : celle qui est à l'écran ressort. -->
    <Style x:Key="OutlineTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Le plan de la fiche : un clic amène la partie en haut du texte. -->
    <DataTemplate x:Key="OutlinePanel">
      <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1" CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{x:Static pages:ReadingText.Outline}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="4,0,0,8"
                     AutomationProperties.HeadingLevel="Level2" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Outline}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:OutlineEntry}">
                  <Button FocusVisualStyle="{DynamicResource Kyf.FocusVisual.Inset}" Style="{DynamicResource Kyf.Button.Subtle}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Click="OnOutlineEntryClick"
                          AutomationProperties.Name="{Binding Title}" Padding="4,3">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource OutlineTitle}" Margin="{Binding Indent, Converter={x:Static pages:IndentConverter.Instance}}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Les passages et les définitions : un clic amène leur texte en haut. -->
    <DataTemplate x:Key="PassagesPanel">
      <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1" CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding PassagesLabel}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="4,0,0,8"
                     AutomationProperties.HeadingLevel="Level2" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Passages}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type pages:PassageEntry}">
                    <Button FocusVisualStyle="{DynamicResource Kyf.FocusVisual.Inset}" Style="{DynamicResource Kyf.Button.Subtle}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Click="OnPassageEntryClick"
                            ContextMenuOpening="OnPassageEntryMenu" AutomationProperties.Name="{Binding ShownTitle}" Padding="4,6">
                      <Button.ContextMenu>
                        <ContextMenu />
                      </Button.ContextMenu>
                      <StackPanel>
                        <Border x:Name="Quote" HorizontalAlignment="Left" Padding="4,1" Background="{DynamicResource Kyf.Brush.PillPassageBackground}"
                                Visibility="{Binding IsPassage, Converter={StaticResource Visible}}">
                          <TextBlock Text="{Binding ShownTitle}" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Kyf.Brush.PillPassageText}" />
                        </Border>
                        <TextBlock Text="{Binding ShownTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding IsDefinition, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding ShownDetail}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding HasShownDetail, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{x:Static pages:ReadingText.LostPassage}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Kyf.Brush.Warning}" Visibility="{Binding IsLost, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{x:Static pages:ReadingText.CandidatePassage}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Kyf.Brush.Warning}" Visibility="{Binding IsCandidate, Converter={StaticResource Visible}}" />
                        <Rectangle Height="2" Margin="0,4,0,0" Fill="{DynamicResource Kyf.Brush.MarkerPassage}" Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- La corbeille de la fiche, repliée : on y vient pour rendre, pas pour lire. -->
              <StackPanel Margin="0,12,0,0" Visibility="{Binding HasTrashedPassages, Converter={StaticResource Visible}}">
                <ToggleButton x:Name="TrashToggle" Content="{Binding TrashLabel}" Style="{DynamicResource Kyf.Button.Tool}" HorizontalAlignment="Left" Padding="8,0" />
                <ItemsControl ItemsSource="{Binding TrashedPassages}" Focusable="False" Margin="0,4,0,0" Visibility="{Binding IsChecked, ElementName=TrashToggle, Converter={StaticResource Visible}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:TrashedPassage}">
                      <DockPanel Margin="4,2">
                        <Button DockPanel.Dock="Right" Content="{x:Static pages:ReadingText.Restore}" Style="{DynamicResource Kyf.Button.Subtle}" Margin="4,0,0,0"
                                Command="{Binding DataContext.RestorePassageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Label, StringFormat={x:Static pages:ReadingText.RestoreNamed}}" />
                        <TextBlock Text="{Binding Label}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ValidateShortcut}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding ToggleWritingCommand}" />
    <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
  </UserControl.InputBindings>

  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Le retour reste à portée, même la fiche défilée ; les volets s'ouvrent et se ferment ici. -->
      <DockPanel Margin="16,16,16,8">
        <Button x:Name="BackButton" DockPanel.Dock="Left" Command="{Binding BackCommand}" Style="{DynamicResource Kyf.Button.Subtle}" Margin="-8,0,0,0"
                AutomationProperties.Name="{x:Static pages:ReviewText.Back}">
          <StackPanel Orientation="Horizontal">
            <kyf:Icon Text="{x:Static kyf:Icons.Back}" Margin="0,0,8,0" />
            <TextBlock Text="{x:Static pages:ReviewText.Back}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- Quand la place manque, les volets passent au-dessus des modes : aucun bouton ne passe sous le retour. -->
        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsPanelToggles, Converter={StaticResource Visible}}">
            <ToggleButton x:Name="OutlineToggle" Content="{x:Static pages:ReadingText.Outline}" IsChecked="{Binding IsOutlineOn}" Margin="0,0,8,0"
                          Visibility="{Binding HasOutline, Converter={StaticResource Visible}}" />
            <ToggleButton x:Name="PassagesToggle" Content="{Binding PassagesLabel}" IsChecked="{Binding IsPassagesOn}" Margin="0,0,8,0"
                          Visibility="{Binding HasPassages, Converter={StaticResource Visible}}" />
          </StackPanel>
          <TextBlock x:Name="SaveStateText" Text="{Binding Editor.StateLabel}" Style="{DynamicResource Kyf.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"
                     AutomationProperties.LiveSetting="Polite" Visibility="{Binding IsWriting, Converter={StaticResource Visible}}" />
          <StackPanel Orientation="Horizontal">
            <ToggleButton x:Name="ReadToggle" Content="{x:Static editing:EditingText.Read}" IsChecked="{Binding IsReadOn}"
                          Style="{DynamicResource Kyf.Button.Tool}" MinHeight="40" Padding="12,0" />
            <ToggleButton x:Name="ReviseToggle" Content="{x:Static pages:ReadingText.Revise}" IsChecked="{Binding IsReviseOn}"
                          Style="{DynamicResource Kyf.Button.Tool}" MinHeight="40" Padding="12,0" />
            <ToggleButton x:Name="WriteToggle" Content="{x:Static editing:EditingText.Write}" IsChecked="{Binding IsWriteOn}"
                          Style="{DynamicResource Kyf.Button.Tool}" MinHeight="40" Padding="12,0" ToolTip="{x:Static editing:EditingText.WriteKey}" />
            <ToggleButton x:Name="ListenToggle" IsChecked="{Binding ReadAloud.IsOpen, Mode=OneWay}" Click="OnListenToggle" Style="{DynamicResource Kyf.Button.Tool}" MinHeight="40" Padding="12,0" Margin="8,0,0,0" Visibility="Collapsed"
                          ToolTip="{x:Static pages:ReadingText.ListenRegion}" AutomationProperties.Name="{x:Static pages:ReadingText.Listen}">
              <StackPanel Orientation="Horizontal">
                <kyf:Icon Text="{x:Static kyf:Icons.Speaker}" VerticalAlignment="Center" />
                <TextBlock x:Name="ListenLabel" Text="{x:Static pages:ReadingText.Listen}" VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </ToggleButton>
          </StackPanel>
        </WrapPanel>
        <TextBlock x:Name="Notice" Text="{Binding Notice}" Style="{DynamicResource Kyf.Text.Secondary}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
      </DockPanel>

      <!-- Les barres de la lecture s'empilent : on peut écouter en changeant la place d'un passage. -->
      <StackPanel Grid.Row="1" Visibility="{Binding IsReading, Converter={StaticResource Visible}}">
        <!-- Texte à trous : où l'on en est, et de quoi tout afficher ou tout remasquer. -->
        <DockPanel x:Name="HolesBar" Margin="16,0,16,8" DataContext="{Binding Holes}" Visibility="{Binding HasHoles, Converter={StaticResource Visible}}">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="RevealAllButton" Style="{DynamicResource Kyf.Button.Subtle}" Content="{x:Static pages:ReadingText.RevealAllHoles}" Command="{Binding RevealAllCommand}" IsEnabled="{Binding CanRevealAll}" />
            <Button x:Name="HideAllButton" Style="{DynamicResource Kyf.Button.Subtle}" Content="{x:Static pages:ReadingText.HideAllHoles}" Command="{Binding HideAllCommand}" IsEnabled="{Binding CanHideAll}" Margin="4,0,0,0" />
          </StackPanel>
          <TextBlock x:Name="HolesSummary" Text="{Binding Summary}" Style="{DynamicResource Kyf.Text.Secondary}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <!-- Un passage attend sa nouvelle place : on la sélectionne dans le texte, le reste de la page reste lisible. -->
        <DockPanel x:Name="RebindBar" Margin="16,0,16,8" Visibility="{Binding IsRebinding, Converter={StaticResource Visible}}">
          <StackPanel x:Name="RebindButtons" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="RebindHereButton" Content="{x:Static pages:ReadingText.RebindHere}" Style="{DynamicResource Kyf.Button.Primary}" Click="OnRebindHere" Margin="8,0,8,0" />
            <Button x:Name="RebindCancelButton" Content="{x:Static pages:ReadingText.RebindCancel}" Command="{Binding CancelRebindingCommand}" />
          </StackPanel>
          <TextBlock x:Name="RebindPrompt" Text="{Binding RebindingPrompt}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <!-- Écouter la fiche : la lecture et ses réglages. Sur une fenêtre étroite, ils passent à la ligne. -->
        <WrapPanel x:Name="ListenBar" Margin="16,0,16,8" DataContext="{Binding ReadAloud}" Visibility="{Binding IsOpen, Converter={StaticResource Visible}, FallbackValue=Collapsed}"
                   AutomationProperties.Name="{x:Static pages:ReadingText.ListenRegion}">
          <Button x:Name="ListenPlay" Command="{Binding PlayPauseCommand}" Style="{DynamicResource Kyf.Button.Primary}" Margin="0,0,8,4" AutomationProperties.Name="{Binding PlayLabel}">
            <StackPanel Orientation="Horizontal">
              <kyf:Icon Text="{Binding PlayGlyph}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding PlayLabel}" />
            </StackPanel>
          </Button>
          <Button x:Name="ListenStop" Command="{Binding StopCommand}" Style="{DynamicResource Kyf.Button.Icon}" Content="{x:Static kyf:Icons.Stop}" Margin="0,0,4,4"
                  ToolTip="{x:Static pages:ReadingText.ListenStop}" AutomationProperties.Name="{x:Static pages:ReadingText.ListenStop}" />
          <Button x:Name="ListenPrevious" Command="{Binding PreviousCommand}" Style="{DynamicResource Kyf.Button.Icon}" Content="{x:Static kyf:Icons.Previous}" Margin="0,0,4,4"
                  ToolTip="{x:Static pages:ReadingText.ListenPrevious}" AutomationProperties.Name="{x:Static pages:ReadingText.ListenPrevious}" />
          <TextBlock x:Name="ListenProgress" Text="{Binding Progress}" Style="{DynamicResource Kyf.Text.Secondary}" VerticalAlignment="Center" MinWidth="56" TextAlignment="Center" Margin="0,0,4,4" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="ListenNext" Command="{Binding NextCommand}" Style="{DynamicResource Kyf.Button.Icon}" Content="{x:Static kyf:Icons.Next}" Margin="0,0,12,4"
                  ToolTip="{x:Static pages:ReadingText.ListenNext}" AutomationProperties.Name="{x:Static pages:ReadingText.ListenNext}" />
          <Button x:Name="ListenRate" Content="{Binding RateLabel}" Style="{DynamicResource Kyf.Button.Subtle}" Click="OnRateMenu" Margin="0,0,4,4" />
          <Button x:Name="ListenVoice" Content="{Binding VoiceLabel}" Style="{DynamicResource Kyf.Button.Subtle}" Click="OnVoiceMenu" Margin="0,0,12,4" />
          <TextBlock x:Name="ListenMessage" Text="{Binding Message}" Style="{DynamicResource Kyf.Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,4"
                     Visibility="{Binding HasMessage, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="ListenClose" Command="{Binding CloseCommand}" Style="{DynamicResource Kyf.Button.Icon}" Content="{x:Static kyf:Icons.Close}" Margin="0,0,0,4"
                  ToolTip="{x:Static pages:ReadingText.ListenClose}" AutomationProperties.Name="{x:Static pages:ReadingText.ListenClose}" />
        </WrapPanel>
      </StackPanel>

      <!-- Le ruban court sur toute la largeur, au-dessus du plan et des passages. -->
      <StackPanel Grid.Row="1" Margin="16,0,16,8" DataContext="{Binding Editor}"
                  Visibility="{Binding DataContext.IsWriting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
        <editing:EditorRibbon x:Name="Ribbon" />
        <!-- Un conflit n'écrit rien tant qu'il n'est pas tranché : aucune des deux versions n'est perdue. -->
        <StackPanel x:Name="ConflictPanel" Margin="0,8,0,0" Visibility="{Binding HasConflict, Converter={StaticResource Visible}}">
          <kyf:Notification x:Name="ConflictMessage" Severity="Warning" Message="{x:Static editing:EditingText.ConflictMessage}" IsClosable="False" Margin="0,0,0,8" />
          <WrapPanel>
            <Button x:Name="CompareConflictButton" Content="{x:Static editing:EditingText.ConflictCompare}" Command="{Binding CompareConflictCommand}" Margin="0,0,8,0" />
            <Button x:Name="KeepMineButton" Content="{x:Static editing:EditingText.KeepMine}" Command="{Binding KeepMineCommand}" Margin="0,0,8,0" />
            <Button x:Name="ReloadDiskButton" Content="{x:Static editing:EditingText.ReloadDisk}" Command="{Binding ReloadDiskCommand}" />
          </WrapPanel>
        </StackPanel>
        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}">
          <kyf:Notification x:Name="WritingProblem" Severity="Critical" Message="{Binding Problem}" IsClosable="False" Margin="0,0,0,8" />
          <WrapPanel>
            <Button x:Name="RetryButton" Content="{x:Static editing:EditingText.Retry}" Command="{Binding RetryCommand}" Margin="0,0,8,0"
                    Visibility="{Binding HasFailed, Converter={StaticResource Visible}}" />
            <Button x:Name="DismissButton" Content="{x:Static editing:EditingText.Dismiss}" Command="{Binding DismissProblemCommand}" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="2" Margin="16,0,16,0">
        <DockPanel>
          <ContentControl x:Name="OutlinePane" DockPanel.Dock="Left" Width="{x:Static pages:SheetPageViewModel.OutlineWidth}" Margin="0,0,16,0" Focusable="False" IsTabStop="False"
                          Content="{Binding}" ContentTemplate="{StaticResource OutlinePanel}" Visibility="{Binding ShowsOutline, Converter={StaticResource Visible}}" />
          <ContentControl x:Name="PassagesPane" DockPanel.Dock="Right" Width="{x:Static pages:SheetPageViewModel.PassagesWidth}" Margin="16,0,0,0" Focusable="False" IsTabStop="False"
                          Content="{Binding}" ContentTemplate="{StaticResource PassagesPanel}" Visibility="{Binding ShowsPassages, Converter={StaticResource Visible}}" />

          <!-- La fiche, à largeur de lecture ; elle défile seule, avec son titre. -->
          <Grid MaxWidth="{Binding TextWidth}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock x:Name="Loading" Text="{x:Static pages:ReviewText.OpeningSheet}" Style="{DynamicResource Kyf.Text.Secondary}"
                         Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
              <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}"
                                IsClosable="False" Margin="0,0,0,12" />
              <kyf:Notification x:Name="ProblemMessage" Severity="Warning" Message="{Binding Problem}" IsOpen="{Binding HasProblem, Mode=OneWay}"
                                IsClosable="False" Margin="0,0,0,12" />
            </StackPanel>
            <editing:SheetEditorView x:Name="EditorView" Grid.Row="1" DataContext="{Binding Editor}"
                                     Visibility="{Binding DataContext.IsWriting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
            <reading:SheetDocumentViewer x:Name="SheetText" Grid.Row="1" Visibility="{Binding IsReading, Converter={StaticResource Visible}}" Reading="{Binding Reading}" OpenLinkCommand="{Binding OpenLinkCommand}"
                                         Highlights="{Binding Highlights}" ActiveHighlight="{Binding ActivePassage}" Holes="{Binding Holes}"
                                         PreviewMouseLeftButtonDown="OnTextPressed" PreviewMouseLeftButtonUp="OnTextReleased" PreviewKeyDown="OnTextKey"
                                         ContextMenuOpening="OnTextMenu"
                                         AutomationProperties.Name="{x:Static pages:ReadingText.Document}">
              <reading:SheetDocumentViewer.ContextMenu>
                <ContextMenu x:Name="TextMenu" />
              </reading:SheetDocumentViewer.ContextMenu>
            </reading:SheetDocumentViewer>
          </Grid>
        </DockPanel>

        <!-- Sans la place, un volet s'ouvre par-dessus le texte, avec les mêmes boutons. -->
        <ContentControl x:Name="OutlineOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Width="{x:Static pages:SheetPageViewModel.OutlineOverlayWidth}" Focusable="False" IsTabStop="False"
                        Content="{Binding}" ContentTemplate="{StaticResource OutlinePanel}" Visibility="{Binding ShowsOutlineOverlay, Converter={StaticResource Visible}}" />
        <ContentControl x:Name="PassagesOverlay" HorizontalAlignment="Right" VerticalAlignment="Top" Width="{x:Static pages:SheetPageViewModel.PassagesOverlayWidth}" Focusable="False" IsTabStop="False"
                        Content="{Binding}" ContentTemplate="{StaticResource PassagesPanel}" Visibility="{Binding ShowsPassagesOverlay, Converter={StaticResource Visible}}" />
      </Grid>

      <Border Grid.Row="3" Height="16" Visibility="{Binding IsWriting, Converter={StaticResource Visible}}" />

      <!-- Toujours visible, même la fiche défilée. -->
      <ContentControl Grid.Row="3" Content="{Binding Review}" Focusable="False" IsTabStop="False" Margin="16,8,16,16"
                      Visibility="{Binding IsReading, Converter={StaticResource Visible}}" />
    </Grid>

    <kyf:Dialog x:Name="Confirmation" Title="{Binding Review.ConfirmTitle}" IsOpen="{Binding Review.IsConfirming, Mode=OneWay}"
                PrimaryButtonText="{Binding Review.ConfirmLabel}" Closed="OnConfirmationClosed">
      <TextBlock Text="{Binding Review.ConfirmMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
    </kyf:Dialog>

    <kyf:Dialog x:Name="PassageEditor" Title="{Binding EditorTitle}" IsOpen="{Binding IsEditing, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:ReadingText.Save}" Closed="OnEditorClosed">
      <StackPanel>
        <kyf:Notification x:Name="EditorMessage" Severity="Critical" Message="{Binding EditorProblem}" IsOpen="{Binding HasEditorProblem, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
        <TextBox x:Name="CommentBox" Text="{Binding EditorComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" VerticalContentAlignment="Top"
                 MaxLength="{x:Static pages:SheetPageViewModel.CommentMaximum}" AutomationProperties.Name="{x:Static pages:ReadingText.CommentTitle}"
                 Visibility="{Binding EditsComment, Converter={StaticResource Visible}}" />
        <StackPanel Visibility="{Binding EditsDefinition, Converter={StaticResource Visible}}">
          <TextBlock Text="{x:Static pages:ReadingText.TermLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
          <TextBox x:Name="TermBox" Text="{Binding EditorTerm, UpdateSourceTrigger=PropertyChanged}" MaxLength="{x:Static pages:SheetPageViewModel.TermMaximum}"
                   AutomationProperties.Name="{x:Static pages:ReadingText.TermLabel}" />
          <TextBlock Text="{x:Static pages:ReadingText.ExplanationLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,8,0,4" />
          <TextBox x:Name="ExplanationBox" Text="{Binding EditorExplanation, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" VerticalContentAlignment="Top"
                   MaxLength="{x:Static pages:SheetPageViewModel.CommentMaximum}" AutomationProperties.Name="{x:Static pages:ReadingText.ExplanationLabel}" />
        </StackPanel>
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="PassageDelete" Title="{Binding DeleteTitle}" IsOpen="{Binding IsDeleting, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:ReadingText.DeleteLabel}" Closed="OnDeleteClosed">
      <TextBlock Text="{x:Static pages:ReadingText.DeleteMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
    </kyf:Dialog>

    <kyf:Dialog x:Name="RebindConfirm" Title="{x:Static pages:ReadingText.RebindTitle}" IsOpen="{Binding IsConfirmingRebinding, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:ReadingText.RebindKeep}" SecondaryButtonText="{x:Static pages:ReadingText.RebindRestart}" Closed="OnRebindClosed">
      <StackPanel>
        <TextBlock Text="{Binding RebindingMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
        <Button x:Name="RebindConfirmCancel" Content="{x:Static pages:ReadingText.RebindCancel}" Style="{DynamicResource Kyf.Button.Subtle}" HorizontalAlignment="Right" Margin="0,8,0,0" Click="OnRebindConfirmCancel" />
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="HistoryDialog" DataContext="{Binding Editor}" Title="{x:Static editing:EditingText.HistoryTitle}" IsOpen="{Binding IsHistoryOpen, Mode=OneWay}" CardMaxWidth="1150" IsWide="True"
                PrimaryButtonText="{x:Static editing:EditingText.HistoryClose}" SecondaryButtonText="" Closed="OnHistoryClosed">
      <Grid x:Name="HistoryContent" DataContext="{Binding History}" Height="560">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="210" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HistorySummary" Grid.ColumnSpan="2" Text="{Binding Summary}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="0,0,0,8"
                   Visibility="{Binding HasVersions, Converter={StaticResource Visible}}" />
        <kyf:Notification x:Name="HistoryProblem" Grid.Row="1" Grid.ColumnSpan="2" Severity="Critical" Message="{Binding Problem}" IsClosable="False" Margin="0,0,0,8"
                          Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
        <TextBlock x:Name="HistoryEmptyText" Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static editing:EditingText.HistoryEmpty}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap"
                   Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
        <ListBox x:Name="HistoryList" Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" BorderThickness="0" Background="Transparent" Margin="0,0,12,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static editing:EditingText.HistoryVersions}"
                 Visibility="{Binding HasVersions, Converter={StaticResource Visible}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Date}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Size}" Style="{DynamicResource Kyf.Text.Caption}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Grid.Column="1" Visibility="{Binding HasVersions, Converter={StaticResource Visible}}">
          <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,4">
            <TextBlock x:Name="HistoryVersionLabel" Text="{Binding VersionLabel}" Style="{DynamicResource Kyf.Text.Caption}" />
            <TextBlock Text="{x:Static editing:EditingText.HistoryCurrent}" Style="{DynamicResource Kyf.Text.Caption}" />
          </UniformGrid>
          <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="RestoreAskButton" Content="{x:Static editing:EditingText.HistoryRestoreAsk}" Command="{Binding AskRestoreCommand}" Visibility="{Binding IsNotConfirming, Converter={StaticResource Visible}}" />
            <TextBlock Text="{x:Static editing:EditingText.HistoryRestoreNote}" Style="{DynamicResource Kyf.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}" />
            <Button x:Name="RestoreCancelButton" Content="{x:Static editing:EditingText.HistoryCancel}" Command="{Binding CancelRestoreCommand}" Margin="0,0,8,0" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}" />
            <Button x:Name="RestoreButton" Content="{x:Static editing:EditingText.HistoryRestore}" Command="{Binding RestoreCommand}" Style="{DynamicResource Kyf.Button.Primary}" Visibility="{Binding IsConfirming, Converter={StaticResource Visible}}" />
          </WrapPanel>
          <editing:DiffView x:Name="HistoryDiff" Rows="{Binding Rows}" />
        </DockPanel>
      </Grid>
    </kyf:Dialog>

    <kyf:Dialog x:Name="ConflictDialog" DataContext="{Binding Editor}" Title="{x:Static editing:EditingText.ConflictCompareTitle}" IsOpen="{Binding IsComparingConflict, Mode=OneWay}" CardMaxWidth="1150" IsWide="True"
                PrimaryButtonText="{x:Static editing:EditingText.HistoryClose}" SecondaryButtonText="" Closed="OnConflictCompareClosed">
      <DockPanel Height="520">
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,4">
          <TextBlock Text="{x:Static editing:EditingText.ConflictDisk}" Style="{DynamicResource Kyf.Text.Caption}" />
          <TextBlock Text="{x:Static editing:EditingText.ConflictMine}" Style="{DynamicResource Kyf.Text.Caption}" />
        </UniformGrid>
        <editing:DiffView x:Name="ConflictDiff" Rows="{Binding ConflictRows}" />
      </DockPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="GalleryDialog" DataContext="{Binding Editor}" Title="{Binding Gallery.Title}" IsOpen="{Binding IsGalleryOpen, Mode=OneWay}" CardMaxWidth="980" IsWide="True"
                PrimaryButtonText="{x:Static editing:EditingText.GalleryContinue}" Closed="OnGalleryClosed">
      <editing:DiagramGalleryView x:Name="GalleryContent" DataContext="{Binding Gallery}" />
    </kyf:Dialog>

    <kyf:Dialog x:Name="NetworkChoiceDialog" DataContext="{Binding Editor}" Title="{x:Static editing:EditingText.NetworkTitle}" IsOpen="{Binding IsNetworkChoiceOpen, Mode=OneWay}"
                PrimaryButtonText="{x:Static editing:EditingText.GalleryInsert}" Closed="OnNetworkChoiceClosed">
      <StackPanel DataContext="{Binding NetworkChoice}">
        <kyf:Notification x:Name="NetworkChoiceError" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,12" />
        <TextBlock Text="{x:Static editing:EditingText.NetworkNewLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="NetworkNewTitle" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static editing:EditingText.NetworkNewLabel}" />
        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasExisting, Converter={StaticResource Visible}}">
          <TextBlock Text="{x:Static editing:EditingText.NetworkExistingLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
          <ListBox x:Name="NetworkExisting" ItemsSource="{Binding Existing}" SelectedItem="{Binding Selected}" MaxHeight="220" DisplayMemberPath="Title"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{x:Static editing:EditingText.NetworkExistingLabel}" />
          <CheckBox x:Name="NetworkCopyBox" IsChecked="{Binding IsCopy}" Margin="0,8,0,0" AutomationProperties.Name="{x:Static editing:EditingText.NetworkCopy}">
            <TextBlock Text="{x:Static editing:EditingText.NetworkCopy}" TextWrapping="Wrap" />
          </CheckBox>
        </StackPanel>
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="DiagramEditorDialog" DataContext="{Binding Editor}" Title="{Binding DiagramEditor.Title}" IsOpen="{Binding IsDiagramEditorOpen, Mode=OneWay}" CardMaxWidth="1040" IsWide="True"
                PrimaryButtonText="{Binding DiagramEditor.ConfirmLabel}" Closed="OnDiagramEditorClosed">
      <editing:DiagramEditorView x:Name="DiagramEditorContent" DataContext="{Binding DiagramEditor}" />
    </kyf:Dialog>

    <kyf:Dialog x:Name="LinkDialog" DataContext="{Binding Editor}" Title="{x:Static editing:EditingText.LinkTitle}" IsOpen="{Binding IsLinkOpen, Mode=OneWay}"
                PrimaryButtonText="{x:Static editing:EditingText.InsertLink}" Closed="OnLinkClosed">
      <StackPanel>
        <TextBlock Text="{x:Static editing:EditingText.LinkLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="LinkLabelBox" Text="{Binding LinkLabel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static editing:EditingText.LinkLabel}" />
        <TextBlock Text="{x:Static editing:EditingText.LinkAddress}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,8,0,4" />
        <TextBox x:Name="LinkAddressBox" Text="{Binding LinkAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static editing:EditingText.LinkAddress}" />
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="FormulaDialog" DataContext="{Binding Editor}" Title="{x:Static editing:EditingText.FormulaTitle}" IsOpen="{Binding IsFormulaOpen, Mode=OneWay}"
                PrimaryButtonText="{x:Static editing:EditingText.InsertLink}" Closed="OnFormulaClosed">
      <StackPanel>
        <TextBlock Text="{x:Static editing:EditingText.FormulaSource}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="FormulaBox" Text="{Binding FormulaTex, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" VerticalContentAlignment="Top"
                 FontFamily="{DynamicResource Kyf.Font.Code}" AutomationProperties.Name="{x:Static editing:EditingText.FormulaSource}" />
        <CheckBox x:Name="FormulaBlockBox" Content="{x:Static editing:EditingText.FormulaBlock}" IsChecked="{Binding FormulaBlock}" Margin="0,8,0,0" />
        <TextBlock Text="{x:Static editing:EditingText.FormulaPreview}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,12,0,4" />
        <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" CornerRadius="{DynamicResource Kyf.Radius.Control}" Padding="12" MinHeight="72">
          <reading:FormulaPreview x:Name="FormulaPreview" Tex="{Binding FormulaTex}" HorizontalAlignment="Center" VerticalAlignment="Center" IsTabStop="False" />
        </Border>
        <TextBlock Text="{x:Static editing:EditingText.FormulaExamples}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,12,0,4" />
        <ItemsControl x:Name="FormulaExamples" ItemsSource="{x:Static editing:SheetEditorViewModel.FormulaExamples}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding}" Style="{DynamicResource Kyf.Button.Subtle}" FontFamily="{DynamicResource Kyf.Font.Code}" Margin="0,0,4,4" AutomationProperties.Name="{Binding}"
                      Command="{Binding DataContext.UseFormulaExampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </kyf:Dialog>
  </Grid>
</UserControl>
