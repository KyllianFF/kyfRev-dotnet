<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.SheetPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:reading="clr-namespace:KyfRev.Presentation.Wpf.Reading"
             xmlns:editing="clr-namespace:KyfRev.Presentation.Wpf.Editing"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Le titre d'une partie : celle qui est à l'écran ressort. -->
    <Style x:Key="OutlineTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Le plan de la fiche : un clic amène la partie en haut du texte. -->
    <DataTemplate x:Key="OutlinePanel">
      <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1" CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{x:Static pages:ReadingText.Outline}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="4,0,0,8"
                     AutomationProperties.HeadingLevel="Level2" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Outline}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:OutlineEntry}">
                  <Button Style="{DynamicResource Kyf.Button.Subtle}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Click="OnOutlineEntryClick"
                          AutomationProperties.Name="{Binding Title}" Padding="4,3">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource OutlineTitle}" Margin="{Binding Indent, Converter={x:Static pages:IndentConverter.Instance}}" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- Les passages et les définitions : un clic amène leur texte en haut. -->
    <DataTemplate x:Key="PassagesPanel">
      <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1" CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding PassagesLabel}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="4,0,0,8"
                     AutomationProperties.HeadingLevel="Level2" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ItemsControl ItemsSource="{Binding Passages}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:PassageEntry}">
                  <Button Style="{DynamicResource Kyf.Button.Subtle}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Click="OnPassageEntryClick"
                          ContextMenuOpening="OnPassageEntryMenu" AutomationProperties.Name="{Binding ShownTitle}" Padding="4,6">
                    <Button.ContextMenu>
                      <ContextMenu />
                    </Button.ContextMenu>
                    <StackPanel>
                      <Border x:Name="Quote" HorizontalAlignment="Left" Padding="4,1" Background="{DynamicResource Kyf.Brush.PillPassageBackground}"
                              Visibility="{Binding IsPassage, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding ShownTitle}" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Kyf.Brush.PillPassageText}" />
                      </Border>
                      <TextBlock Text="{Binding ShownTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{Binding IsDefinition, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding ShownDetail}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Visibility="{Binding HasShownDetail, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{x:Static pages:ReadingText.LostPassage}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Foreground="{DynamicResource Kyf.Brush.Warning}" Visibility="{Binding IsLost, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{x:Static pages:ReadingText.CandidatePassage}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                 Foreground="{DynamicResource Kyf.Brush.Warning}" Visibility="{Binding IsCandidate, Converter={StaticResource Visible}}" />
                      <Rectangle Height="2" Margin="0,4,0,0" Fill="{DynamicResource Kyf.Brush.MarkerPassage}" Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ValidateShortcut}" />
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding ToggleWritingCommand}" />
    <KeyBinding Key="Escape" Command="{Binding CloseOverlayCommand}" />
  </UserControl.InputBindings>

  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Le retour reste à portée, même la fiche défilée ; les volets s'ouvrent et se ferment ici. -->
      <DockPanel Margin="16,16,16,8">
        <Button x:Name="BackButton" DockPanel.Dock="Left" Command="{Binding BackCommand}" Style="{DynamicResource Kyf.Button.Subtle}" Margin="-8,0,0,0"
                AutomationProperties.Name="{x:Static pages:ReviewText.Back}">
          <StackPanel Orientation="Horizontal">
            <kyf:Icon Text="{x:Static kyf:Icons.Back}" Margin="0,0,8,0" />
            <TextBlock Text="{x:Static pages:ReviewText.Back}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsPanelToggles, Converter={StaticResource Visible}}">
            <ToggleButton x:Name="OutlineToggle" Content="{x:Static pages:ReadingText.Outline}" IsChecked="{Binding IsOutlineOn}" Margin="0,0,8,0"
                          Visibility="{Binding HasOutline, Converter={StaticResource Visible}}" />
            <ToggleButton x:Name="PassagesToggle" Content="{Binding PassagesLabel}" IsChecked="{Binding IsPassagesOn}" Margin="0,0,8,0"
                          Visibility="{Binding HasPassages, Converter={StaticResource Visible}}" />
          </StackPanel>
          <TextBlock x:Name="SaveStateText" Text="{Binding Editor.StateLabel}" Style="{DynamicResource Kyf.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,12,0"
                     AutomationProperties.LiveSetting="Polite" Visibility="{Binding IsWriting, Converter={StaticResource Visible}}" />
          <ToggleButton x:Name="ReadToggle" Content="{x:Static editing:EditingText.Read}" IsChecked="{Binding IsReadOn}"
                        Style="{DynamicResource Kyf.Button.Tool}" MinHeight="40" Padding="12,0" />
          <ToggleButton x:Name="ReviseToggle" Content="{x:Static pages:ReadingText.Revise}" IsChecked="{Binding IsReviseOn}"
                        Style="{DynamicResource Kyf.Button.Tool}" MinHeight="40" Padding="12,0" />
          <ToggleButton x:Name="WriteToggle" Content="{x:Static editing:EditingText.Write}" IsChecked="{Binding IsWriteOn}"
                        Style="{DynamicResource Kyf.Button.Tool}" MinHeight="40" Padding="12,0" ToolTip="{x:Static editing:EditingText.WriteKey}" />
        </StackPanel>
        <TextBlock x:Name="Notice" Text="{Binding Notice}" Style="{DynamicResource Kyf.Text.Secondary}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
      </DockPanel>

      <!-- Texte à trous : où l'on en est, et de quoi tout afficher ou tout remasquer. -->
      <DockPanel x:Name="HolesBar" Grid.Row="1" Margin="16,0,16,8" DataContext="{Binding Holes}" Visibility="{Binding HasHoles, Converter={StaticResource Visible}}">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="RevealAllButton" Style="{DynamicResource Kyf.Button.Subtle}" Content="{x:Static pages:ReadingText.RevealAllHoles}" Command="{Binding RevealAllCommand}" IsEnabled="{Binding CanRevealAll}" />
          <Button x:Name="HideAllButton" Style="{DynamicResource Kyf.Button.Subtle}" Content="{x:Static pages:ReadingText.HideAllHoles}" Command="{Binding HideAllCommand}" IsEnabled="{Binding CanHideAll}" Margin="4,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="HolesSummary" Text="{Binding Summary}" Style="{DynamicResource Kyf.Text.Secondary}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>

      <!-- Le ruban court sur toute la largeur, au-dessus du plan et des passages. -->
      <StackPanel Grid.Row="1" Margin="16,0,16,8" DataContext="{Binding Editor}"
                  Visibility="{Binding DataContext.IsWriting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
        <editing:EditorRibbon x:Name="Ribbon" />
        <!-- Un conflit n'écrit rien tant qu'il n'est pas tranché : aucune des deux versions n'est perdue. -->
        <StackPanel x:Name="ConflictPanel" Margin="0,8,0,0" Visibility="{Binding HasConflict, Converter={StaticResource Visible}}">
          <kyf:Notification x:Name="ConflictMessage" Severity="Warning" Message="{x:Static editing:EditingText.ConflictMessage}" IsClosable="False" Margin="0,0,0,8" />
          <WrapPanel>
            <Button x:Name="KeepMineButton" Content="{x:Static editing:EditingText.KeepMine}" Command="{Binding KeepMineCommand}" Margin="0,0,8,0" />
            <Button x:Name="ReloadDiskButton" Content="{x:Static editing:EditingText.ReloadDisk}" Command="{Binding ReloadDiskCommand}" />
          </WrapPanel>
        </StackPanel>
        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasProblem, Converter={StaticResource Visible}}">
          <kyf:Notification x:Name="WritingProblem" Severity="Critical" Message="{Binding Problem}" IsClosable="False" Margin="0,0,0,8" />
          <WrapPanel>
            <Button x:Name="RetryButton" Content="{x:Static editing:EditingText.Retry}" Command="{Binding RetryCommand}" Margin="0,0,8,0"
                    Visibility="{Binding HasFailed, Converter={StaticResource Visible}}" />
            <Button x:Name="DismissButton" Content="{x:Static editing:EditingText.Dismiss}" Command="{Binding DismissProblemCommand}" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>

      <Grid Grid.Row="2" Margin="16,0,16,0">
        <DockPanel>
          <ContentControl x:Name="OutlinePane" DockPanel.Dock="Left" Width="{x:Static pages:SheetPageViewModel.OutlineWidth}" Margin="0,0,16,0" Focusable="False" IsTabStop="False"
                          Content="{Binding}" ContentTemplate="{StaticResource OutlinePanel}" Visibility="{Binding ShowsOutline, Converter={StaticResource Visible}}" />
          <ContentControl x:Name="PassagesPane" DockPanel.Dock="Right" Width="{x:Static pages:SheetPageViewModel.PassagesWidth}" Margin="16,0,0,0" Focusable="False" IsTabStop="False"
                          Content="{Binding}" ContentTemplate="{StaticResource PassagesPanel}" Visibility="{Binding ShowsPassages, Converter={StaticResource Visible}}" />

          <!-- La fiche, à largeur de lecture ; elle défile seule, avec son titre. -->
          <Grid MaxWidth="{Binding TextWidth}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock x:Name="Loading" Text="{x:Static pages:ReviewText.OpeningSheet}" Style="{DynamicResource Kyf.Text.Secondary}"
                         Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />
              <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}"
                                IsClosable="False" Margin="0,0,0,12" />
              <kyf:Notification x:Name="ProblemMessage" Severity="Warning" Message="{Binding Problem}" IsOpen="{Binding HasProblem, Mode=OneWay}"
                                IsClosable="False" Margin="0,0,0,12" />
            </StackPanel>
            <editing:SheetEditorView x:Name="EditorView" Grid.Row="1" DataContext="{Binding Editor}"
                                     Visibility="{Binding DataContext.IsWriting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}" />
            <reading:SheetDocumentViewer x:Name="SheetText" Grid.Row="1" Visibility="{Binding IsReading, Converter={StaticResource Visible}}" Reading="{Binding Reading}" OpenLinkCommand="{Binding OpenLinkCommand}"
                                         Highlights="{Binding Highlights}" ActiveHighlight="{Binding ActivePassage}" Holes="{Binding Holes}"
                                         PreviewMouseLeftButtonDown="OnTextPressed" PreviewMouseLeftButtonUp="OnTextReleased" PreviewKeyDown="OnTextKey"
                                         ContextMenuOpening="OnTextMenu"
                                         AutomationProperties.Name="{x:Static pages:ReadingText.Document}">
              <reading:SheetDocumentViewer.ContextMenu>
                <ContextMenu x:Name="TextMenu" />
              </reading:SheetDocumentViewer.ContextMenu>
            </reading:SheetDocumentViewer>
          </Grid>
        </DockPanel>

        <!-- Sans la place, un volet s'ouvre par-dessus le texte, avec les mêmes boutons. -->
        <ContentControl x:Name="OutlineOverlay" HorizontalAlignment="Left" VerticalAlignment="Top" Width="{x:Static pages:SheetPageViewModel.OutlineOverlayWidth}" Focusable="False" IsTabStop="False"
                        Content="{Binding}" ContentTemplate="{StaticResource OutlinePanel}" Visibility="{Binding ShowsOutlineOverlay, Converter={StaticResource Visible}}" />
        <ContentControl x:Name="PassagesOverlay" HorizontalAlignment="Right" VerticalAlignment="Top" Width="{x:Static pages:SheetPageViewModel.PassagesOverlayWidth}" Focusable="False" IsTabStop="False"
                        Content="{Binding}" ContentTemplate="{StaticResource PassagesPanel}" Visibility="{Binding ShowsPassagesOverlay, Converter={StaticResource Visible}}" />
      </Grid>

      <Border Grid.Row="3" Height="16" Visibility="{Binding IsWriting, Converter={StaticResource Visible}}" />

      <!-- Toujours visible, même la fiche défilée. -->
      <ContentControl Grid.Row="3" Content="{Binding Review}" Focusable="False" IsTabStop="False" Margin="16,8,16,16"
                      Visibility="{Binding IsReading, Converter={StaticResource Visible}}" />
    </Grid>

    <kyf:Dialog x:Name="Confirmation" Title="{Binding Review.ConfirmTitle}" IsOpen="{Binding Review.IsConfirming, Mode=OneWay}"
                PrimaryButtonText="{Binding Review.ConfirmLabel}" Closed="OnConfirmationClosed">
      <TextBlock Text="{Binding Review.ConfirmMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
    </kyf:Dialog>

    <kyf:Dialog x:Name="PassageEditor" Title="{Binding EditorTitle}" IsOpen="{Binding IsEditing, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:ReadingText.Save}" Closed="OnEditorClosed">
      <StackPanel>
        <kyf:Notification x:Name="EditorMessage" Severity="Critical" Message="{Binding EditorProblem}" IsOpen="{Binding HasEditorProblem, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
        <TextBox x:Name="CommentBox" Text="{Binding EditorComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" VerticalContentAlignment="Top"
                 MaxLength="{x:Static pages:SheetPageViewModel.CommentMaximum}" AutomationProperties.Name="{x:Static pages:ReadingText.CommentTitle}"
                 Visibility="{Binding EditsComment, Converter={StaticResource Visible}}" />
        <StackPanel Visibility="{Binding EditsDefinition, Converter={StaticResource Visible}}">
          <TextBlock Text="{x:Static pages:ReadingText.TermLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
          <TextBox x:Name="TermBox" Text="{Binding EditorTerm, UpdateSourceTrigger=PropertyChanged}" MaxLength="{x:Static pages:SheetPageViewModel.TermMaximum}"
                   AutomationProperties.Name="{x:Static pages:ReadingText.TermLabel}" />
          <TextBlock Text="{x:Static pages:ReadingText.ExplanationLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,8,0,4" />
          <TextBox x:Name="ExplanationBox" Text="{Binding EditorExplanation, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" VerticalContentAlignment="Top"
                   MaxLength="{x:Static pages:SheetPageViewModel.CommentMaximum}" AutomationProperties.Name="{x:Static pages:ReadingText.ExplanationLabel}" />
        </StackPanel>
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="PassageDelete" Title="{Binding DeleteTitle}" IsOpen="{Binding IsDeleting, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:ReadingText.DeleteLabel}" Closed="OnDeleteClosed">
      <TextBlock Text="{x:Static pages:ReadingText.DeleteMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
    </kyf:Dialog>

    <kyf:Dialog x:Name="GalleryDialog" DataContext="{Binding Editor}" Title="{Binding Gallery.Title}" IsOpen="{Binding IsGalleryOpen, Mode=OneWay}" CardMaxWidth="980"
                PrimaryButtonText="{x:Static editing:EditingText.GalleryInsert}" Closed="OnGalleryClosed">
      <editing:DiagramGalleryView x:Name="GalleryContent" DataContext="{Binding Gallery}" />
    </kyf:Dialog>

    <kyf:Dialog x:Name="LinkDialog" DataContext="{Binding Editor}" Title="{x:Static editing:EditingText.LinkTitle}" IsOpen="{Binding IsLinkOpen, Mode=OneWay}"
                PrimaryButtonText="{x:Static editing:EditingText.InsertLink}" Closed="OnLinkClosed">
      <StackPanel>
        <TextBlock Text="{x:Static editing:EditingText.LinkLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="LinkLabelBox" Text="{Binding LinkLabel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static editing:EditingText.LinkLabel}" />
        <TextBlock Text="{x:Static editing:EditingText.LinkAddress}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,8,0,4" />
        <TextBox x:Name="LinkAddressBox" Text="{Binding LinkAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static editing:EditingText.LinkAddress}" />
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="FormulaDialog" DataContext="{Binding Editor}" Title="{x:Static editing:EditingText.FormulaTitle}" IsOpen="{Binding IsFormulaOpen, Mode=OneWay}"
                PrimaryButtonText="{x:Static editing:EditingText.InsertLink}" Closed="OnFormulaClosed">
      <StackPanel>
        <TextBlock Text="{x:Static editing:EditingText.FormulaSource}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="FormulaBox" Text="{Binding FormulaTex, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="2" VerticalContentAlignment="Top"
                 FontFamily="{DynamicResource Kyf.Font.Code}" AutomationProperties.Name="{x:Static editing:EditingText.FormulaSource}" />
        <CheckBox x:Name="FormulaBlockBox" Content="{x:Static editing:EditingText.FormulaBlock}" IsChecked="{Binding FormulaBlock}" Margin="0,8,0,0" />
      </StackPanel>
    </kyf:Dialog>
  </Grid>
</UserControl>
