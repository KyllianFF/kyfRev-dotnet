<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.ShortcutsSettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:shell="clr-namespace:KyfRev.Presentation.Wpf.Shell"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages"
             PreviewKeyDown="OnKey">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>

  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel MaxWidth="{x:Static pages:SettingsTab.Column}">
      <TextBlock Text="{x:Static pages:MoreSettingsText.MachineNote}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <StackPanel x:Name="Sections">
        <kyf:Card x:Name="ShortcutsCard" pages:SettingsPart.Of="raccourcis" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:MoreSettingsText.ShortcutsTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,4" />
            <TextBlock Text="{x:Static pages:MoreSettingsText.ShortcutsHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <kyf:Notification x:Name="ShortcutMessage" Severity="Warning" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
            <ItemsControl x:Name="ShortcutList" ItemsSource="{Binding Rows}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:ShortcutRow}">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" MinWidth="110" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,2" CornerRadius="{DynamicResource Kyf.Radius.Control}"
                            BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}" BorderThickness="1" Background="{DynamicResource Kyf.Brush.SurfaceAlt}">
                      <TextBlock Text="{Binding Keys}" FontFamily="{DynamicResource Kyf.Font.Code}" />
                    </Border>
                    <Button Grid.Column="2" Style="{DynamicResource Kyf.Button.Tool}" Padding="12,0" Margin="8,0,0,0" Tag="{Binding IsWaiting}" Content="{Binding ChangeLabel}"
                            Command="{Binding DataContext.ChangeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding ChangeLabel}" AutomationProperties.HelpText="{Binding Label}" />
                    <Button Grid.Column="3" Style="{DynamicResource Kyf.Button.Subtle}" Padding="12,0" Margin="4,0,0,0" Content="{x:Static pages:MoreSettingsText.Restore}"
                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            IsEnabled="{Binding IsChanged}" AutomationProperties.HelpText="{Binding Label}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button x:Name="RestoreAllButton" Style="{DynamicResource Kyf.Button.Subtle}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{x:Static pages:MoreSettingsText.RestoreAll}"
                    Command="{Binding RestoreCommand}" />
            <TextBlock Text="{x:Static pages:MoreSettingsText.ShortcutsNote}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />

            <TextBlock Text="{x:Static pages:MoreSettingsText.FixedTitle}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,16,0,6" />
            <ItemsControl x:Name="FixedList" ItemsSource="{x:Static pages:ShortcutsSettingsViewModel.Fixed}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type shell:Shortcut}">
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Description}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Keys}" Style="{DynamicResource Kyf.Text.Secondary}" FontFamily="{DynamicResource Kyf.Font.Code}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </kyf:Card>

        <kyf:Card x:Name="CaptureCard" pages:SettingsPart.Of="raccourcis" Padding="16,12" Margin="0,0,0,8" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="{x:Static pages:MoreSettingsText.CaptureTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,8" />
            <CheckBox x:Name="GlobalCaptureBox" Style="{DynamicResource Kyf.Switch}" IsChecked="{Binding GlobalCapture}" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.GlobalCapture}"
                      AutomationProperties.HelpText="{x:Static pages:GeneralSettingsText.GlobalCaptureHelp}">
              <StackPanel>
                <TextBlock Text="{x:Static pages:GeneralSettingsText.GlobalCapture}" Style="{DynamicResource Kyf.Text.BodyStrong}" />
                <TextBlock Text="{x:Static pages:GeneralSettingsText.GlobalCaptureHelp}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="0,2,0,0" />
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </kyf:Card>

        <kyf:Card x:Name="MenuCard" pages:SettingsPart.Of="menu" Padding="16,12" Margin="0,0,0,8" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock Text="{x:Static pages:MoreSettingsText.MenuTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,4" />
            <TextBlock Text="{x:Static pages:MoreSettingsText.MenuHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,2" />
            <TextBlock Text="{x:Static pages:MoreSettingsText.MenuHowTo}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <!-- Une vue se prend par sa ligne et se fait glisser ; choisie d'un clic, les flèches la déplacent. Les boutons ↑ ↓ restent,
                 pour la souris seule et les lecteurs d'écran. -->
            <ListBox x:Name="MenuList" ItemsSource="{Binding Menu}" SelectedItem="{Binding ChosenMenuRow}" SelectionMode="Single" PreviewKeyDown="OnMenuKey"
                     PreviewMouseLeftButtonDown="OnMenuPressed" PreviewMouseMove="OnMenuDragged" PreviewMouseLeftButtonUp="OnMenuReleased" LostMouseCapture="OnMenuCaptureLost"
                     AutomationProperties.Name="{x:Static pages:MoreSettingsText.MenuListName}" AutomationProperties.HelpText="{x:Static pages:MoreSettingsText.MenuListHelp}">
              <!-- Pas de défilement propre : la page défile, molette comprise, même au-dessus de la liste. -->
              <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                  <ItemsPresenter />
                </ControlTemplate>
              </ListBox.Template>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:MenuRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <kyf:Icon Text="{x:Static kyf:Icons.Grip}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource Kyf.Brush.TextSecondary}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Style="{DynamicResource Kyf.Button.Tool}" Content="↑" Cursor="Hand" ToolTip="{Binding UpLabel}" AutomationProperties.Name="{Binding UpLabel}"
                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Style="{DynamicResource Kyf.Button.Tool}" Content="↓" Cursor="Hand" Margin="2,0,0,0" ToolTip="{Binding DownLabel}" AutomationProperties.Name="{Binding DownLabel}"
                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="MenuMovedText" Text="{Binding MenuMoved}" Style="{DynamicResource Kyf.Text.Caption}" Margin="8,4,0,0" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="RestoreOrderButton" Style="{DynamicResource Kyf.Button.Subtle}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{x:Static pages:MoreSettingsText.RestoreOrder}"
                    Command="{Binding RestoreOrderCommand}" />
          </StackPanel>
        </kyf:Card>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
