<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.FolderImportDialog"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>

  <kyf:Dialog x:Name="ImportDialog" Title="{x:Static pages:SharingText.ImportTitle}" IsOpen="{Binding IsOpen, Mode=OneWay}"
              PrimaryButtonText="{Binding ConfirmLabel}" SecondaryButtonText="{Binding CancelLabel}" IsPrimaryEnabled="{Binding CanConfirm}" IsWorking="{Binding IsBusy}" Closed="OnClosed">
    <StackPanel>
      <!-- Le bilan : ce qui a été copié, et ce qui ne l'a pas été. -->
      <StackPanel x:Name="ReportPanel" Visibility="{Binding HasReport, Converter={StaticResource Visible}}">
        <kyf:Notification x:Name="ReportSummary" Message="{Binding Summary}" IsOpen="{Binding HasReport, Mode=OneWay}" IsClosable="False" ScrollsIntoView="True" />
        <TextBlock x:Name="ReportFollow" Text="{Binding Follow}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding HasFollow, Converter={StaticResource Visible}}" />
        <StackPanel Margin="0,12,0,0" Visibility="{Binding HasIgnored, Converter={StaticResource Visible}}">
          <ToggleButton x:Name="IgnoredToggle" Content="{Binding IgnoredLabel}" Style="{DynamicResource Kyf.Button.Tool}" HorizontalAlignment="Left" Padding="8,0" />
          <ItemsControl x:Name="IgnoredList" ItemsSource="{Binding Ignored}" Focusable="False" Margin="8,4,0,0" AutomationProperties.Name="{Binding IgnoredLabel}"
                        Visibility="{Binding IsChecked, ElementName=IgnoredToggle, Converter={StaticResource Visible}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>

      <!-- Ce qu'il faut importer, et ce que deviennent les fiches ; ce qui se passe d'abord, pour se voir en fenêtre étroite. -->
      <StackPanel x:Name="ChoicePanel" Visibility="{Binding IsChoosing, Converter={StaticResource Visible}}">
        <kyf:Notification x:Name="ImportRunning" Message="{x:Static pages:SharingText.ImportRunning}" IsOpen="{Binding IsBusy, Mode=OneWay}" IsClosable="False" ScrollsIntoView="True" Margin="0,0,0,12" />
        <kyf:Notification x:Name="ImportError" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" ScrollsIntoView="True" Margin="0,0,0,12" />
        <TextBlock x:Name="ImportHelp" Text="{x:Static pages:SharingText.ImportHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" />
        <DockPanel Margin="0,12,0,0">
          <Button x:Name="ChooseButton" DockPanel.Dock="Left" Content="{Binding ChooseLabel}" Command="{Binding ChooseCommand}" IsEnabled="{Binding IsIdle}" />
          <TextBlock x:Name="SourceName" Text="{Binding SourceName}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0"
                     ToolTip="{Binding Source}" Visibility="{Binding HasSource, Converter={StaticResource Visible}}" />
        </DockPanel>
        <TextBlock Text="{x:Static pages:SharingText.ImportReview}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,16,0,6" AutomationProperties.HeadingLevel="Level3" />
        <RadioButton x:Name="CopyOnlyChoice" GroupName="SuiviImport" IsChecked="{Binding CopiesOnly}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,8"
                     AutomationProperties.Name="{x:Static pages:SharingText.ImportCopyOnly}" AutomationProperties.HelpText="{x:Static pages:SharingText.ImportCopyOnlyHelp}">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SharingText.ImportCopyOnly}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static pages:SharingText.ImportCopyOnlyHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TrackChoice" GroupName="SuiviImport" IsChecked="{Binding Tracks}" IsEnabled="{Binding IsIdle}"
                     AutomationProperties.Name="{x:Static pages:SharingText.ImportTrack}" AutomationProperties.HelpText="{x:Static pages:SharingText.ImportTrackHelp}">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SharingText.ImportTrack}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Static pages:SharingText.ImportTrackHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>
      </StackPanel>
    </StackPanel>
  </kyf:Dialog>
</UserControl>
