<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.StudySessionPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="Right" Modifiers="Control" Command="{Binding NextCommand}" />
  </UserControl.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- La barre de la séance : progression, plein écran, terminer, passer ou suivant. -->
    <Border x:Name="SessionBar" Background="{DynamicResource Kyf.Brush.Surface}" BorderBrush="{DynamicResource Kyf.Brush.Divider}"
            BorderThickness="0,0,0,1" Padding="32,12" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="FullScreenButton" Command="{Binding ToggleFullScreenCommand}" Style="{DynamicResource Kyf.Button.Subtle}" Margin="0,0,8,0"
                  ToolTip="F11" AutomationProperties.Name="{x:Static pages:SessionText.FullScreen}" AutomationProperties.AcceleratorKey="F11">
            <StackPanel Orientation="Horizontal">
              <kyf:Icon Text="{x:Static kyf:Icons.FocusMode}" Margin="0,0,8,0" />
              <TextBlock Text="{x:Static pages:SessionText.FullScreen}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="EndButton" Content="{x:Static pages:SessionText.Finish}" Command="{Binding EndCommand}" Margin="0,0,8,0" />
          <!-- Rien n'a été fait : « Passer » ; une fois l'élément traité : « Suivant », en bouton principal. -->
          <Button x:Name="SkipButton" Command="{Binding NextCommand}" ToolTip="Ctrl+→" AutomationProperties.Name="{x:Static pages:SessionText.Skip}"
                  AutomationProperties.AcceleratorKey="Ctrl+→" Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static pages:SessionText.Skip}" VerticalAlignment="Center" />
              <kyf:Icon Text="&#xE72A;" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="NextButton" Command="{Binding NextCommand}" Style="{DynamicResource Kyf.Button.Primary}" ToolTip="Ctrl+→"
                  AutomationProperties.Name="{x:Static pages:SessionText.Next}" AutomationProperties.AcceleratorKey="Ctrl+→"
                  Visibility="{Binding HasActed, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static pages:SessionText.Next}" VerticalAlignment="Center" />
              <kyf:Icon Text="&#xE72A;" Margin="8,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- La colonne suit la place laissée par les boutons, jusqu'à 360 px. -->
        <Grid VerticalAlignment="Center" AutomationProperties.Name="{Binding ProgressName}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="360" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="ProgressLabel" Text="{Binding ProgressLabel}" Style="{DynamicResource Kyf.Text.BodyStrong}" />
          <!-- Piste de la progression : la part parcourue se remplit. -->
          <Grid x:Name="ProgressTrack" Grid.Row="1" Height="6" Margin="0,6,0,0">
            <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" CornerRadius="3" />
            <Border x:Name="ProgressFill" Background="{DynamicResource Kyf.Brush.Primary}" CornerRadius="3" RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="{Binding Progress}" />
              </Border.RenderTransform>
            </Border>
          </Grid>
        </Grid>
      </DockPanel>
    </Border>

    <!-- L'élément en cours : sa fiche ou son passage, avec sa barre de révision. -->
    <ContentControl x:Name="Item" Grid.Row="1" Content="{Binding Current}" Focusable="False" IsTabStop="False" />

    <!-- Le bilan de fin. -->
    <StackPanel x:Name="SummaryPanel" Grid.Row="0" Grid.RowSpan="2" MaxWidth="560" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsFinished, Converter={StaticResource Visible}}">
      <kyf:Icon Text="{x:Static kyf:Icons.Success}" FontSize="40" Foreground="{DynamicResource Kyf.Brush.Success}" HorizontalAlignment="Center" />
      <TextBlock x:Name="SummaryTitle" Text="{x:Static pages:SessionText.SummaryTitle}" Style="{DynamicResource Kyf.Text.Title}" HorizontalAlignment="Center"
                 Margin="0,12,0,0" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="Summary" Text="{Binding Summary}" Style="{DynamicResource Kyf.Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,16" />
      <kyf:Card>
        <StackPanel>
          <TextBlock x:Name="Duration" Text="{Binding DurationText}" Style="{DynamicResource Kyf.Text.Body}" />
          <TextBlock x:Name="Done" Text="{Binding DoneText}" Style="{DynamicResource Kyf.Text.Body}" Margin="0,4,0,0" />
          <TextBlock x:Name="Postponed" Text="{Binding PostponedText}" Style="{DynamicResource Kyf.Text.Body}" Margin="0,4,0,0" />
          <TextBlock x:Name="Remaining" Text="{Binding RemainingText}" Style="{DynamicResource Kyf.Text.Body}" Margin="0,4,0,0" />
        </StackPanel>
      </kyf:Card>
      <Button x:Name="BackToToday" Content="{x:Static pages:SessionText.BackToToday}" Command="{Binding LeaveCommand}"
              Style="{DynamicResource Kyf.Button.Primary}" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
