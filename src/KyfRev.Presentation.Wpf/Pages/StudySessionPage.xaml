<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.StudySessionPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages"
             x:Name="Self">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <pages:WidthAtLeastConverter x:Key="AtLeast" />

    <!-- Les boutons de la séance : à droite de la progression, ou dessous quand la place manque. -->
    <Style x:Key="SessionActions" TargetType="WrapPanel">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ActualWidth, ElementName=Self, Converter={StaticResource AtLeast}, ConverterParameter=560}" Value="False">
          <Setter Property="DockPanel.Dock" Value="Bottom" />
          <Setter Property="Margin" Value="0,8,0,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <UserControl.InputBindings>
    <KeyBinding Key="Right" Modifiers="Control" Command="{Binding NextCommand}" />
  </UserControl.InputBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- La barre de la séance : la progression sur toute la largeur, plein écran, terminer, passer ou suivant. -->
    <Border x:Name="SessionBar" Background="{DynamicResource Kyf.Brush.Surface}" BorderBrush="{DynamicResource Kyf.Brush.Divider}"
            BorderThickness="0,0,0,1" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
      <StackPanel>
        <!-- Piste de la progression : la part parcourue se remplit. -->
        <Grid x:Name="ProgressTrack" Height="4">
          <Border Background="{DynamicResource Kyf.Brush.SurfaceAlt}" />
          <Border x:Name="ProgressFill" Background="{DynamicResource Kyf.Brush.Primary}" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="{Binding Progress}" />
            </Border.RenderTransform>
          </Border>
        </Grid>
        <DockPanel Margin="16,8">
          <WrapPanel Style="{StaticResource SessionActions}">
            <Button x:Name="FullScreenButton" Command="{Binding ToggleFullScreenCommand}" Style="{DynamicResource Kyf.Button.Icon}" Margin="0,0,8,0"
                    Content="{x:Static kyf:Icons.FocusMode}" ToolTip="F11" AutomationProperties.Name="{x:Static pages:SessionText.FullScreen}"
                    AutomationProperties.AcceleratorKey="F11" />
            <Button x:Name="EndButton" Content="{x:Static pages:SessionText.Finish}" Command="{Binding EndCommand}" Margin="0,0,8,0" />
            <!-- Rien n'a été fait : « Passer » ; une fois l'élément traité : « Suivant », en bouton principal. -->
            <Button x:Name="SkipButton" Command="{Binding NextCommand}" ToolTip="Ctrl+→" AutomationProperties.Name="{x:Static pages:SessionText.Skip}"
                    AutomationProperties.AcceleratorKey="Ctrl+→" Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static pages:SessionText.Skip}" VerticalAlignment="Center" />
                <kyf:Icon Text="&#xE72A;" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
            <Button x:Name="NextButton" Command="{Binding NextCommand}" Style="{DynamicResource Kyf.Button.Primary}" ToolTip="Ctrl+→"
                    AutomationProperties.Name="{x:Static pages:SessionText.Next}" AutomationProperties.AcceleratorKey="Ctrl+→"
                    Visibility="{Binding HasActed, Converter={StaticResource Visible}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static pages:SessionText.Next}" VerticalAlignment="Center" />
                <kyf:Icon Text="&#xE72A;" Margin="8,0,0,0" />
              </StackPanel>
            </Button>
          </WrapPanel>
          <StackPanel VerticalAlignment="Center" AutomationProperties.Name="{Binding ProgressName}">
            <TextBlock x:Name="ProgressLabel" Text="{Binding ProgressLabel}" Style="{DynamicResource Kyf.Text.BodyStrong}" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- L'élément en cours : sa fiche ou son passage, avec sa barre de révision. -->
    <ContentControl x:Name="Item" Grid.Row="1" Content="{Binding Current}" Focusable="False" IsTabStop="False" />

    <!-- Le bilan de fin. -->
    <StackPanel x:Name="SummaryPanel" Grid.Row="0" Grid.RowSpan="2" MaxWidth="560" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsFinished, Converter={StaticResource Visible}}">
      <kyf:Icon Text="{x:Static kyf:Icons.Success}" FontSize="40" Foreground="{DynamicResource Kyf.Brush.Success}" HorizontalAlignment="Center" />
      <TextBlock x:Name="SummaryTitle" Text="{x:Static pages:SessionText.SummaryTitle}" Style="{DynamicResource Kyf.Text.Title}" HorizontalAlignment="Center"
                 Margin="0,12,0,0" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="Summary" Text="{Binding Summary}" Style="{DynamicResource Kyf.Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,16" />
      <!-- Les libellés à gauche, les chiffres alignés à droite, en chasse fixe. -->
      <kyf:Card MinWidth="280">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <Style x:Key="Figure" TargetType="TextBlock">
              <Setter Property="Grid.Column" Value="1" />
              <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Code}" />
              <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
              <Setter Property="LineHeight" Value="{DynamicResource Kyf.LineHeight.Body}" />
              <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
              <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
              <Setter Property="TextAlignment" Value="Right" />
            </Style>
          </Grid.Resources>
          <TextBlock Text="{x:Static pages:SessionText.Duration}" Style="{DynamicResource Kyf.Text.Secondary}" />
          <TextBlock x:Name="Duration" Text="{Binding Duration}" Style="{StaticResource Figure}" Margin="24,0,0,0" />
          <TextBlock Grid.Row="1" Text="{x:Static pages:SessionText.Done}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="0,8,0,0" />
          <TextBlock x:Name="Done" Grid.Row="1" Text="{Binding DoneCount}" Style="{StaticResource Figure}" Margin="24,8,0,0" />
          <TextBlock Grid.Row="2" Text="{x:Static pages:SessionText.Postponed}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="0,8,0,0" />
          <TextBlock x:Name="Postponed" Grid.Row="2" Text="{Binding PostponedCount}" Style="{StaticResource Figure}" Margin="24,8,0,0" />
          <TextBlock Grid.Row="3" Text="{x:Static pages:SessionText.Remaining}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="0,8,0,0" />
          <TextBlock x:Name="Remaining" Grid.Row="3" Text="{Binding RemainingCount}" Style="{StaticResource Figure}" Margin="24,8,0,0" />
        </Grid>
      </kyf:Card>
      <Button x:Name="BackToToday" Content="{x:Static pages:SessionText.BackToToday}" Command="{Binding LeaveCommand}"
              Style="{DynamicResource Kyf.Button.Primary}" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
  </Grid>
</UserControl>
