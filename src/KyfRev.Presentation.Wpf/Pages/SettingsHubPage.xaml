<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.SettingsHubPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
      <pages:SettingsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:DataSettingsViewModel}">
      <pages:DataSettingsPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:AboutSettingsViewModel}">
      <pages:AboutSettingsPage />
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel Margin="16">
    <TextBlock x:Name="Heading" DockPanel.Dock="Top" Text="{x:Static pages:SettingsText.Title}" Style="{DynamicResource Kyf.Text.Title}"
               AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,8" />
    <!-- Un seul groupe de boutons radio : les flèches passent d'un onglet à l'autre, et un seul reste choisi. -->
    <ItemsControl x:Name="TabBar" DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" Focusable="False" Margin="0,0,0,12" AutomationProperties.Name="{x:Static pages:SettingsHubText.TabsName}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsTab}">
          <RadioButton GroupName="SettingsTabs" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Style="{DynamicResource Kyf.Button.Tab}"
                       MinHeight="36" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ContentControl x:Name="TabContent" Content="{Binding Selected.Page}" Focusable="False" IsTabStop="False" />
  </DockPanel>
</UserControl>
