<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.ReviewBar"
             x:ClassModifier="internal"
             x:Name="Self"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- La disposition vient de AdaptiveRow : ces styles ne gardent que l'alignement. -->
    <Style x:Key="StepsSlot" TargetType="ItemsControl">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatusSlot" TargetType="StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ActionsSlot" TargetType="Grid">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- L'échéance : en ambre et en gras si elle est dépassée ; le texte le dit aussi. -->
    <Style x:Key="DueStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
      <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsLate}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <kyf:Card x:Name="Bar" MaxWidth="980" Padding="16,12" AutomationProperties.Name="{x:Static pages:ReviewText.Review}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Sur une ligne (frise, état, actions) tant que l'état y garde sa place ; l'un sous l'autre sinon, l'état d'abord. -->
      <kyf:AdaptiveRow x:Name="Layout" MainMinWidth="220">

      <!-- Frise des étapes du cycle : J0 ✓ J1 ✓ J3 ● J7 J14 J30. -->
      <ItemsControl x:Name="Steps" ItemsSource="{Binding Steps}" Style="{StaticResource StepsSlot}" kyf:AdaptiveRow.Part="Leading"
                    Visibility="{Binding ShowsSteps, Converter={StaticResource Visible}}"
                    AutomationProperties.Name="{x:Static pages:ReviewText.Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type pages:StepMark}">
            <StackPanel Width="46" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}" Background="Transparent">
              <Grid Height="24">
                <!-- Le trait qui relie à l'étape précédente, sauf pour la première. -->
                <Border x:Name="Link" Width="22" Height="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-11,0,0,0"
                        Background="{DynamicResource Kyf.Brush.Divider}" />
                <Border x:Name="Point" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Center" BorderThickness="2"
                        BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}" Background="Transparent">
                  <kyf:Icon x:Name="Check" Text="&#xE73E;" FontSize="12" Foreground="{DynamicResource Kyf.Brush.OnPrimary}" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
              <TextBlock x:Name="Label" Text="{Binding Label}" Style="{DynamicResource Kyf.Text.Caption}" FontFamily="{DynamicResource Kyf.Font.Code}"
                         HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                <Setter TargetName="Link" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsDone}" Value="True">
                <Setter TargetName="Point" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
                <Setter TargetName="Point" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                <Setter TargetName="Link" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding WasLate}" Value="True">
                <Setter TargetName="Point" Property="Background" Value="{DynamicResource Kyf.Brush.Warning}" />
                <Setter TargetName="Point" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Warning}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Point" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
                <Setter TargetName="Point" Property="BorderThickness" Value="3" />
                <Setter TargetName="Point" Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
                <Setter TargetName="Link" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- L'étape attendue et son échéance ; archivé, l'état des rappels. -->
      <StackPanel Style="{StaticResource StatusSlot}" kyf:AdaptiveRow.Part="Main">
        <StackPanel Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
          <TextBlock x:Name="Status" TextWrapping="Wrap">
            <Run Text="{Binding StepLabel, Mode=OneWay}" /><Run Text=" : " /><Run Text="{Binding State.Step, Mode=OneWay}" FontWeight="SemiBold" />
          </TextBlock>
          <TextBlock x:Name="Due" Text="{Binding DueText}" Style="{StaticResource DueStyle}" />
        </StackPanel>
        <TextBlock x:Name="ArchivedStatus" Text="{Binding ArchivedStatus}" TextWrapping="Wrap"
                   Visibility="{Binding ShowsArchivedActions, Converter={StaticResource Visible}}" />
        <!-- Un rappel attend sa réponse : quitter la fiche ne vaut pas réponse. -->
        <StackPanel x:Name="ReminderStatus" Visibility="{Binding IsReminder, Converter={StaticResource Visible}}">
          <TextBlock Text="{x:Static pages:ReviewText.ReminderTitle}" Style="{DynamicResource Kyf.Text.BodyStrong}" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock x:Name="ReminderIntro" Text="{Binding ReminderIntro}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap"
                     Visibility="{Binding ShowsReminderChoices, Converter={StaticResource Visible}}" />
          <TextBlock x:Name="MarkingHelp" Text="{x:Static pages:ReviewText.ReminderMarking}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap"
                     Visibility="{Binding IsMarking, Converter={StaticResource Visible}}" />
        </StackPanel>
      </StackPanel>

      <Grid Style="{StaticResource ActionsSlot}" kyf:AdaptiveRow.Part="Trailing">
        <!-- En révision : reporter, les autres actions, valider. -->
        <WrapPanel Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
          <StackPanel x:Name="Done" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                      Visibility="{Binding ShowsReviewedToday, Converter={StaticResource Visible}}">
            <kyf:Icon Text="{x:Static kyf:Icons.Success}" Foreground="{DynamicResource Kyf.Brush.Success}" Margin="0,0,8,0" />
            <TextBlock Text="{x:Static pages:ReviewText.ReviewedToday}" VerticalAlignment="Center" />
          </StackPanel>
          <Button x:Name="PostponeButton" Content="{x:Static pages:ReviewText.Postpone}" Click="OnMenuButton" Margin="0,0,8,0"
                  AutomationProperties.Name="{x:Static pages:ReviewText.Postpone}">
            <Button.ContextMenu>
              <ContextMenu x:Name="PostponeMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem x:Name="PostponeTomorrow" Header="{x:Static pages:ReviewText.PostponeTomorrow}" Command="{Binding PostponeTomorrowCommand}" />
                <MenuItem x:Name="PostponeThreeDays" Header="{x:Static pages:ReviewText.PostponeThreeDays}" Command="{Binding PostponeThreeDaysCommand}" />
                <MenuItem x:Name="PostponeOnDay" Header="{x:Static pages:ReviewText.ChoosePostponeDay}" Command="{Binding ChoosePostponeDayCommand}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="MoreButton" Style="{DynamicResource Kyf.Button.Icon}" Content="&#xE712;" Click="OnMenuButton" Margin="0,0,8,0"
                  ToolTip="{x:Static pages:ReviewText.MoreActions}" AutomationProperties.Name="{x:Static pages:ReviewText.MoreActions}">
            <Button.ContextMenu>
              <ContextMenu x:Name="MoreMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem x:Name="ValidateOnDay" Header="{x:Static pages:ReviewText.ChooseValidationDay}" Command="{Binding ChooseValidationDayCommand}"
                          Visibility="{Binding CanAntedate, Converter={StaticResource Visible}}" />
                <MenuItem x:Name="Restart" Header="{x:Static pages:ReviewText.RestartAction}" Command="{Binding RequestRestartCommand}" />
                <MenuItem x:Name="Archive" Header="{x:Static pages:ReviewText.ArchiveAction}" Command="{Binding RequestArchiveCommand}"
                          Visibility="{Binding IsSheet, Converter={StaticResource Visible}}" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="ValidateButton" Command="{Binding ValidateCommand}" Style="{DynamicResource Kyf.Button.Primary}"
                  Visibility="{Binding CanValidate, Converter={StaticResource Visible}}" ToolTip="Ctrl+Entrée"
                  AutomationProperties.Name="{Binding ValidateLabel}" AutomationProperties.AcceleratorKey="Ctrl+Entrée">
            <StackPanel Orientation="Horizontal">
              <kyf:Icon Text="{x:Static kyf:Icons.Success}" Margin="0,0,8,0" />
              <TextBlock Text="{Binding ValidateLabel}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>

        <!-- Le rappel : les trois réponses. -->
        <WrapPanel x:Name="ReminderChoices" Visibility="{Binding ShowsReminderChoices, Converter={StaticResource Visible}}">
          <Button x:Name="ReviewEntirely" Content="{x:Static pages:ReviewText.ReminderEntirely}" Command="{Binding RequestReviewEntirelyCommand}" Margin="0,0,8,0" />
          <Button x:Name="SomePoints" Content="{x:Static pages:ReviewText.ReminderSomePoints}" Command="{Binding StartMarkingCommand}" Margin="0,0,8,0" />
          <Button x:Name="Known" Content="{x:Static pages:ReviewText.ReminderKnown}" Command="{Binding AnswerKnownCommand}" Style="{DynamicResource Kyf.Button.Primary}" />
        </WrapPanel>

        <!-- Le marquage : combien de passages, annuler, terminer. -->
        <WrapPanel x:Name="MarkingActions" Visibility="{Binding IsMarking, Converter={StaticResource Visible}}">
          <TextBlock x:Name="MarkedLabel" Text="{Binding MarkedLabel}" Style="{DynamicResource Kyf.Text.BodyStrong}" VerticalAlignment="Center" Margin="0,0,12,0"
                     AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="CancelMarking" Content="{x:Static pages:ReviewText.CancelMarking}" Command="{Binding CancelMarkingCommand}" Margin="0,0,8,0" />
          <Button x:Name="FinishMarking" Content="{x:Static pages:ReviewText.FinishMarking}" Command="{Binding FinishMarkingCommand}" Style="{DynamicResource Kyf.Button.Primary}" />
        </WrapPanel>

        <!-- Archivé : la remise en révision. -->
        <WrapPanel Visibility="{Binding ShowsArchivedActions, Converter={StaticResource Visible}}">
          <Button x:Name="ToggleReminders" Content="{Binding ReminderToggleLabel}" Command="{Binding ToggleRemindersCommand}" Margin="0,0,8,0"
                  Visibility="{Binding IsSheet, Converter={StaticResource Visible}}" />
          <Button x:Name="RestartArchived" Content="{x:Static pages:ReviewText.RestartArchived}" Command="{Binding RestartArchivedCommand}"
                  Style="{DynamicResource Kyf.Button.Primary}" />
        </WrapPanel>
      </Grid>

      </kyf:AdaptiveRow>

      <StackPanel Grid.Row="1">
        <!-- Le jour d'une révision déjà faite, ou d'un report. -->
        <StackPanel x:Name="DayForm" Margin="0,12,0,0" Visibility="{Binding IsChoosingDay, Converter={StaticResource Visible}}" IsVisibleChanged="OnDayFormVisibleChanged">
          <TextBlock Text="{Binding DayChoiceLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
          <WrapPanel>
            <kyf:DateField x:Name="ChosenDay" Width="200" Margin="0,0,8,4" Day="{Binding ChosenDay}" Minimum="{Binding EarliestDay}" Maximum="{Binding LatestDay}"
                           AutomationProperties.Name="{Binding DayChoiceLabel}" />
            <Button x:Name="ConfirmDay" Content="{Binding DayChoiceConfirm}" Command="{Binding ConfirmDayCommand}" Style="{DynamicResource Kyf.Button.Primary}" Margin="0,0,8,4" />
            <Button x:Name="CancelDay" Content="{x:Static pages:ReviewText.CancelDay}" Command="{Binding CancelDayCommand}" Margin="0,0,0,4" />
          </WrapPanel>
        </StackPanel>
        <!-- Les passages de la fiche, à remettre à J0. -->
        <StackPanel x:Name="Marking" Margin="0,12,0,0" Visibility="{Binding IsMarking, Converter={StaticResource Visible}}">
          <TextBlock x:Name="NoPassage" Text="{x:Static pages:ReviewText.ReminderNoPassage}" Style="{DynamicResource Kyf.Text.Secondary}"
                     Visibility="{Binding HasNoPassage, Converter={StaticResource Visible}}" />
          <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding HasPassages, Converter={StaticResource Visible}}">
            <ItemsControl x:Name="Passages" ItemsSource="{Binding Passages}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:PassageMark}">
                  <DockPanel Margin="0,2">
                    <Button DockPanel.Dock="Right" Content="{x:Static pages:ReviewText.MarkPassage}" Margin="12,0,0,0" AutomationProperties.Name="{Binding MarkName}"
                            Command="{Binding DataContext.MarkPassageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            Visibility="{Binding CanMark, Converter={StaticResource Visible}}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsMarked, Converter={StaticResource Visible}}">
                      <kyf:Icon Text="{x:Static kyf:Icons.Success}" Foreground="{DynamicResource Kyf.Brush.Success}" Margin="0,0,8,0" />
                      <TextBlock Text="{x:Static pages:ReviewText.Marked}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
        <kyf:Notification x:Name="Message" Severity="Success" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}"
                          IsClosable="False" Margin="0,12,0,0" />
        <kyf:Notification x:Name="Error" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}"
                          IsClosable="False" Margin="0,12,0,0" />
      </StackPanel>
    </Grid>
  </kyf:Card>
</UserControl>
