<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.WelcomePage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages"
             xmlns:shell="clr-namespace:KyfRev.Presentation.Wpf.Shell"
             xmlns:p="clr-namespace:KyfRev.Presentation.Wpf">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Une entrée de l'accueil : un titre et ce qu'elle fait, dans une carte que l'on clique. -->
    <Style x:Key="Choice" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.ControlBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="Margin" Value="7" />
      <Setter Property="MinHeight" Value="132" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- L'entrée principale, en couleur : son survol reste dans la couleur principale. -->
    <Style x:Key="MainChoice" TargetType="Button" BasedOn="{StaticResource Choice}">
      <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Kyf.Brush.PrimaryHover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Le titre d'une entrée, et ce qu'elle fait : tous deux prennent la couleur du texte de leur carte. -->
    <Style x:Key="ChoiceTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Subtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>
    <Style x:Key="ChoiceHelp" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
    </Style>

    <!-- Un des trois temps de la méthode : son numéro, son nom, ce qu'il est. -->
    <Style x:Key="StepNumber" TargetType="Border">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="Column" MaxWidth="1054" Margin="16,28,16,20" VerticalAlignment="Center">
      <shell:Logotype x:Name="Brand" MarkSize="56" HorizontalAlignment="Center" Margin="0,0,0,16" />
      <TextBlock x:Name="Heading" Text="{x:Static p:ShellText.Welcome}" Style="{DynamicResource Kyf.Text.Display}"
                 HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="{x:Static p:ShellText.WelcomeIntro}" Style="{DynamicResource Kyf.Text.Secondary}" MaxWidth="640"
                 FontSize="{DynamicResource Kyf.FontSize.BodyLarge}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />

      <!-- Les trois entrées : côte à côte, ou l'une sous l'autre en fenêtre étroite. -->
      <UniformGrid x:Name="Choices" Rows="1" Margin="0,22,0,0" AutomationProperties.Name="{x:Static p:ShellText.Welcome}">
        <Button x:Name="CreateButton" Command="{Binding CreateCommand}" Style="{StaticResource MainChoice}" AutomationProperties.Name="{x:Static pages:WelcomeText.Create}"
                AutomationProperties.HelpText="{Binding CreateHelp}">
          <StackPanel>
            <TextBlock Text="{x:Static pages:WelcomeText.Create}" Style="{StaticResource ChoiceTitle}" />
            <TextBlock x:Name="NewVaultHelp" Text="{Binding CreateHelp}" Style="{StaticResource ChoiceHelp}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <!-- Le coffre prévu. -->
            <TextBlock x:Name="PlannedVault" Text="{Binding VaultToCreate}" FontFamily="{DynamicResource Kyf.Font.Code}" FontSize="{DynamicResource Kyf.FontSize.Caption}"
                       Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                       Visibility="{Binding HasVaultToCreate, Converter={StaticResource Visible}}" />
          </StackPanel>
        </Button>
        <Button x:Name="OpenButton" Command="{Binding OpenCommand}" Style="{StaticResource Choice}"
                Visibility="{Binding CanOpenExisting, Converter={StaticResource Visible}}"
                AutomationProperties.Name="{x:Static p:ShellText.OpenExistingVault}" AutomationProperties.HelpText="{x:Static pages:WelcomeText.OpenHelp}">
          <StackPanel>
            <TextBlock Text="{x:Static p:ShellText.OpenExistingVault}" Style="{StaticResource ChoiceTitle}" />
            <TextBlock Text="{x:Static pages:WelcomeText.OpenHelp}" Style="{StaticResource ChoiceHelp}" />
          </StackPanel>
        </Button>
        <Button x:Name="SampleButton" Command="{Binding TrySampleCommand}" Style="{StaticResource Choice}"
                Visibility="{Binding CanTrySample, Converter={StaticResource Visible}}"
                AutomationProperties.Name="{x:Static pages:WelcomeText.Sample}" AutomationProperties.HelpText="{x:Static pages:WelcomeText.SampleHelp}">
          <StackPanel>
            <TextBlock Text="{x:Static pages:WelcomeText.Sample}" Style="{StaticResource ChoiceTitle}" />
            <TextBlock Text="{x:Static pages:WelcomeText.SampleHelp}" Style="{StaticResource ChoiceHelp}" />
          </StackPanel>
        </Button>
      </UniformGrid>

      <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}"
                        IsClosable="False" Margin="7,10,7,0" />

      <!-- La méthode des J, dite avant le premier clic. -->
      <Border x:Name="Method" Margin="7,15,7,0" Padding="20,18,20,20" Background="{DynamicResource Kyf.Brush.Surface}"
              BorderBrush="{DynamicResource Kyf.Brush.Hairline}" BorderThickness="1" CornerRadius="{DynamicResource Kyf.Radius.Card}">
        <StackPanel>
          <TextBlock Text="{x:Static pages:WelcomeText.MethodTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,12" />
          <UniformGrid x:Name="Steps" Rows="1">
            <StackPanel Margin="0,0,24,12">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="1" Style="{DynamicResource Kyf.Text.BodyStrong}" Foreground="{DynamicResource Kyf.Brush.NavigationActiveText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static pages:WelcomeText.WriteTitle}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <TextBlock Text="{x:Static pages:WelcomeText.WriteText}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,24,12">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="2" Style="{DynamicResource Kyf.Text.BodyStrong}" Foreground="{DynamicResource Kyf.Brush.NavigationActiveText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static pages:WelcomeText.ReviewTitle}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <ItemsControl x:Name="StepPills" ItemsSource="{x:Static pages:WelcomeText.Steps}" Focusable="False" Margin="0,6,0,0" AutomationProperties.Name="J0, J1, J3, J7, J14, J30">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource Kyf.Brush.PillSheetBackground}" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                      <TextBlock Text="{Binding}" FontFamily="{DynamicResource Kyf.Font.Code}" FontSize="{DynamicResource Kyf.FontSize.Caption}" FontWeight="Bold"
                                 Foreground="{DynamicResource Kyf.Brush.PillSheetText}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{x:Static pages:WelcomeText.ReviewText}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="3" Style="{DynamicResource Kyf.Text.BodyStrong}" Foreground="{DynamicResource Kyf.Brush.NavigationActiveText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="{x:Static pages:WelcomeText.ArchiveTitle}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <TextBlock Text="{x:Static pages:WelcomeText.ArchiveText}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <Button x:Name="GuideButton" Command="{Binding OpenGuideCommand}" Style="{DynamicResource Kyf.Button.Subtle}" Content="{x:Static pages:WelcomeText.ReadGuide}"
              HorizontalAlignment="Center" Margin="0,10,0,0" MinHeight="44" Visibility="{Binding CanOpenGuide, Converter={StaticResource Visible}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
