<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.FirstTip"
             x:ClassModifier="internal"
             x:Name="Self"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages"
             Visibility="Collapsed" Focusable="False">
  <!-- Une aide de la première fois : elle informe, ne bloque rien, et se ferme pour de bon. -->
  <Border x:Name="Bubble" Background="{DynamicResource Kyf.Brush.InfoBackground}" BorderBrush="{DynamicResource Kyf.Brush.Info}" BorderThickness="1"
          CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="16,12,16,6" AutomationProperties.Name="{Binding Title, ElementName=Self}"
          AutomationProperties.LiveSetting="Polite">
    <StackPanel>
      <TextBlock x:Name="TitleText" Text="{Binding Title, ElementName=Self}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3" />
      <TextBlock x:Name="BodyText" Text="{Binding Text, ElementName=Self}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
      <WrapPanel HorizontalAlignment="Right" Margin="0,4,-10,0">
        <Button x:Name="NoMoreButton" Content="{x:Static pages:FirstTipText.NoMore}" Style="{DynamicResource Kyf.Button.Subtle}" MinHeight="44" Click="OnNoMore" />
        <Button x:Name="UnderstoodButton" Content="{x:Static pages:FirstTipText.Understood}" Style="{DynamicResource Kyf.Button.Subtle}" MinHeight="44" FontWeight="SemiBold" Click="OnUnderstood" />
      </WrapPanel>
    </StackPanel>
  </Border>
</UserControl>
