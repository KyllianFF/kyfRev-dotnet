<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.DashboardPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:modules="clr-namespace:KyfRev.Application.Modules;assembly=KyfRev.Application"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceDictionary Source="ItemPreview.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Choix en ligne (filtre), comme le choix du thème de la galerie. -->
    <ItemsPanelTemplate x:Key="InLine">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- Sept colonnes égales : les jours à venir, les jours passés. -->
    <ItemsPanelTemplate x:Key="SevenDays">
      <UniformGrid Columns="7" />
    </ItemsPanelTemplate>

    <!-- Rien à réviser aujourd'hui. -->
    <DataTemplate DataType="{x:Type pages:EmptyDashboardRow}">
      <kyf:EmptyState Glyph="{x:Static kyf:Icons.Success}" Title="{x:Static pages:DashboardText.EmptyTitle}"
                      Description="{Binding Description}" Margin="0,8,0,16" />
    </DataTemplate>

    <!-- Les premiers pas, dans un coffre qui débute : trois pas qui se cochent seuls, à la place de l'état vide. -->
    <DataTemplate DataType="{x:Type pages:FirstSteps}">
      <Border x:Name="FirstStepsCard" BorderBrush="{DynamicResource Kyf.Brush.Primary}" BorderThickness="2" CornerRadius="{DynamicResource Kyf.Radius.Card}"
              Padding="16,14,16,6" Margin="0,8,0,16" AutomationProperties.Name="{Binding}">
        <StackPanel>
          <WrapPanel>
            <TextBlock Text="{x:Static pages:FirstStepsText.Title}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="FirstStepsProgress" Text="{Binding Progress}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="10,0,0,2" VerticalAlignment="Bottom" />
          </WrapPanel>
          <ItemsControl x:Name="FirstStepsList" ItemsSource="{Binding Steps}" Focusable="False" Margin="0,6,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Kyf.Brush.Hairline}" BorderThickness="0,1,0,0" Padding="0,10" AutomationProperties.Name="{Binding Spoken}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Dot" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}"
                            VerticalAlignment="Top" Margin="0,0,12,0">
                      <Grid>
                        <TextBlock x:Name="Number" Text="{Binding Number}" Style="{DynamicResource Kyf.Text.BodyStrong}" Foreground="{DynamicResource Kyf.Brush.TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <kyf:Icon x:Name="Check" kyf:Transitions.GrowsIn="True" Text="{x:Static kyf:Icons.Success}" Foreground="{DynamicResource Kyf.Brush.OnPrimary}" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <kyf:AdaptiveRow Grid.Column="1" MainMinWidth="220" Spacing="16" StackedSpacing="8">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Help}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                      <Button kyf:AdaptiveRow.Part="Trailing" Content="{x:Static pages:FirstStepsText.NewSheet}" Style="{DynamicResource Kyf.Button.Primary}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Command="{Binding DataContext.StartSheetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              Visibility="{Binding OffersNewSheet, Converter={StaticResource Visible}}" />
                    </kyf:AdaptiveRow>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
                    <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
                    <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel Margin="-10,0,0,0">
            <Button x:Name="FirstStepsGuide" Content="{x:Static pages:FirstStepsText.ReadGuide}" Command="{Binding OpenGuideCommand}" Style="{DynamicResource Kyf.Button.Subtle}"
                    MinHeight="44" Visibility="{Binding CanOpenGuide, Converter={StaticResource Visible}}" />
            <Button x:Name="FirstStepsHide" Content="{x:Static pages:FirstStepsText.Hide}" Command="{Binding HideCommand}" Style="{DynamicResource Kyf.Button.Subtle}" MinHeight="44" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- En-tête de groupe : le cliquer (ou Entrée, Espace) replie ou déplie le groupe. -->
    <DataTemplate DataType="{x:Type pages:DashboardGroup}">
      <ToggleButton x:Name="Header" Command="{Binding ToggleCommand}" IsChecked="{Binding IsExpanded, Mode=OneWay}" Focusable="False"
                    Style="{DynamicResource Kyf.Button.Subtle}" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,8,0,0"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HeadingLevel="Level2">
        <DockPanel>
          <kyf:Icon x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" Margin="8,0,4,0" />
          <!-- L'action de la section (rangée 26C) : là où elle sert, en lien ; son clic ne replie pas la section. -->
          <Button x:Name="GroupAction" DockPanel.Dock="Right" Style="{DynamicResource Kyf.Button.Subtle}" Foreground="{DynamicResource Kyf.Brush.Primary}" FontWeight="SemiBold"
                  Padding="8,0" MinHeight="32" Content="{Binding Action.Label}" Command="{Binding Action.Command}" ToolTip="{Binding Action.Name}"
                  AutomationProperties.Name="{Binding Action.Name}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}" />
          <kyf:Icon x:Name="Glyph" Text="{Binding Glyph}" Margin="0,0,8,0" />
          <TextBlock x:Name="Title" Text="{Binding Title}" Style="{DynamicResource Kyf.Text.BodyStrong}" VerticalAlignment="Center" />
          <Border x:Name="CountPill" Margin="8,0,0,0" Padding="8,0" MinWidth="24" VerticalAlignment="Center" HorizontalAlignment="Left"
                  CornerRadius="{DynamicResource Kyf.Radius.Control}" Background="{DynamicResource Kyf.Brush.SurfaceAlt}">
            <TextBlock Text="{Binding Count}" Style="{DynamicResource Kyf.Text.Caption}" HorizontalAlignment="Center" />
          </Border>
        </DockPanel>
      </ToggleButton>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
          <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Count}" Value="0">
          <Setter TargetName="CountPill" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Overdue">
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
          <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Reminder">
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.MarkerReminder}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Une fiche ou un passage à réviser : le titre, ce qu'il faut savoir dessous, le retard ou l'échéance, l'étape. -->
    <DataTemplate DataType="{x:Type pages:DueItemRow}">
      <Border BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock TextTrimming="CharacterEllipsis" FontSize="{DynamicResource Kyf.FontSize.BodyLarge}">
            <Run x:Name="Heading" Text="{Binding HeadingText, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource Kyf.Brush.TextSecondary}" />
          </TextBlock>
          <TextBlock x:Name="Meta" Text="{Binding Meta}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding FileMissing, Converter={StaticResource Visible}}">
            <kyf:Icon Text="{x:Static kyf:Icons.Warning}" Foreground="{DynamicResource Kyf.Brush.Warning}" FontSize="12" Margin="0,0,4,0" />
            <TextBlock Text="{x:Static pages:DashboardText.FileMissing}" Style="{DynamicResource Kyf.Text.Caption}"
                       Foreground="{DynamicResource Kyf.Brush.Warning}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="Timing" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock x:Name="Late" Text="{Binding Late}" Style="{DynamicResource Kyf.Text.Caption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource Kyf.Brush.Warning}" HorizontalAlignment="Right" />
          <TextBlock x:Name="Due" Text="{Binding DueDate}" Style="{DynamicResource Kyf.Text.Caption}" HorizontalAlignment="Right" />
        </StackPanel>
        <Border Grid.Column="2" Grid.RowSpan="2" MinWidth="44" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="{DynamicResource Kyf.Radius.Control}"
                Background="{DynamicResource Kyf.Brush.PillSheetBackground}" ToolTip="{x:Static pages:DashboardText.StepTooltip}">
          <TextBlock Text="{Binding Step}" FontFamily="{DynamicResource Kyf.Font.Code}" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource Kyf.Brush.PillSheetText}" />
        </Border>
      </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DataContext.HasRoom, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
          <Setter TargetName="Timing" Property="Grid.Column" Value="0" />
          <Setter TargetName="Timing" Property="Grid.Row" Value="1" />
          <Setter TargetName="Timing" Property="Grid.RowSpan" Value="1" />
          <Setter TargetName="Timing" Property="HorizontalAlignment" Value="Left" />
          <Setter TargetName="Timing" Property="Margin" Value="0,2,0,0" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Late}" Value="{x:Null}">
          <Setter TargetName="Late" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding DueDate}" Value="{x:Null}">
          <Setter TargetName="Due" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Heading}" Value="Excerpt">
          <Setter TargetName="Heading" Property="Background" Value="{DynamicResource Kyf.Brush.PillPassageBackground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Heading}" Value="Hidden">
          <Setter TargetName="Heading" Property="FontWeight" Value="Normal" />
          <Setter TargetName="Heading" Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Un rappel de consolidation, dans la liste quand il n'y a pas de colonne latérale. -->
    <DataTemplate DataType="{x:Type pages:ReminderRow}">
      <Border BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
        <StackPanel>
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource Kyf.FontSize.BodyLarge}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Meta}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <!-- Les sept prochains jours : le nombre d'échéances est écrit, le remplissage le redit. -->
    <DataTemplate x:Key="ForecastSection">
      <StackPanel>
        <!-- Le titre mène à la Charge (rangée 26C) : il remplace son bouton. -->
        <Button x:Name="ForecastTitle" Style="{DynamicResource Kyf.Button.Subtle}" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="8,0" Margin="-8,0,0,0" MinHeight="32"
                Command="{Binding OpenWorkloadCommand}" ToolTip="{x:Static pages:DashboardText.SeeWorkload}" AutomationProperties.Name="{x:Static pages:DashboardText.Forecast}"
                AutomationProperties.HelpText="{x:Static pages:DashboardText.SeeWorkload}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static pages:DashboardText.Forecast}" Style="{DynamicResource Kyf.Text.BodyStrong}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2" />
            <kyf:Icon Text="&#xE76C;" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource Kyf.Brush.TextSecondary}" />
          </StackPanel>
        </Button>
        <ItemsControl x:Name="Forecast" ItemsSource="{Binding Forecast}" ItemsPanel="{StaticResource SevenDays}" Focusable="False" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type pages:ForecastDay}">
              <!-- Un jour ouvre la Charge sur lui, choisi et détaillé. -->
              <Button x:Name="ForecastDay" Style="{DynamicResource Kyf.Button.Subtle}" Padding="0,4" MinWidth="0" HorizontalContentAlignment="Stretch"
                      Command="{Binding DataContext.OpenWorkloadOnCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                      ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
              <StackPanel>
                <Border x:Name="Dot" Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Center"
                        BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.Divider}">
                  <TextBlock x:Name="Count" kyf:Transitions.RollingText="{Binding Count}" FontFamily="{DynamicResource Kyf.Font.Code}" FontWeight="SemiBold"
                             FontSize="{DynamicResource Kyf.FontSize.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Label}" Style="{DynamicResource Kyf.Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="None">
                  <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Some">
                  <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
                  <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
                  <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Many">
                  <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
                  <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
                  <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- Les révisions de la semaine : le total, et une barre par jour, ancrée en bas. Le survol donne la valeur. -->
    <DataTemplate x:Key="WeekSection">
      <StackPanel>
        <TextBlock Text="{x:Static pages:DashboardText.ThisWeek}" Style="{DynamicResource Kyf.Text.BodyStrong}" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock x:Name="WeekTotal" Style="{DynamicResource Kyf.Text.Body}">
          <Run Text="{Binding WeekTotal, Mode=OneWay}" FontFamily="{DynamicResource Kyf.Font.Code}" FontWeight="SemiBold" FontSize="{DynamicResource Kyf.FontSize.Subtitle}" />
          <Run Text="{Binding WeekNoun, Mode=OneWay}" />
        </TextBlock>
        <ItemsControl x:Name="Week" ItemsSource="{Binding Week}" ItemsPanel="{StaticResource SevenDays}" Focusable="False" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type pages:WeekBar}">
              <DockPanel Height="72" Background="Transparent" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                <TextBlock x:Name="Day" DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{DynamicResource Kyf.Text.Caption}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <Border x:Name="Bar" kyf:Transitions.GrowsFrom="Bottom" VerticalAlignment="Bottom" Height="{Binding Height}" MaxWidth="24" CornerRadius="4,4,0,0"
                        Background="{DynamicResource Kyf.Brush.Primary}" />
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Count}" Value="0">
                  <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Kyf.Brush.Divider}" />
                  <Setter TargetName="Bar" Property="CornerRadius" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                  <Setter TargetName="Day" Property="FontWeight" Value="SemiBold" />
                  <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="ExamDayLabel" TargetType="Run">
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource Kyf.FontSize.Caption}" />
    </Style>

    <!-- Un examen : son nom, le compte à rebours, son dossier et ce qui tombe après lui ; ses boutons à côté, ou dessous à l'étroit.
         Ils ne prennent pas le focus : au clavier, Entrée sur la ligne ouvre son menu. -->
    <DataTemplate DataType="{x:Type pages:ExamRow}">
      <kyf:AdaptiveRow Margin="0,8" MainMinWidth="200">
        <StackPanel kyf:AdaptiveRow.Part="Main">
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Kyf.FontSize.BodyLarge}">
            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
            <InlineUIContainer BaselineAlignment="Center">
              <Border x:Name="Countdown" Padding="8,0" Margin="4,0,0,0" CornerRadius="{DynamicResource Kyf.Radius.Control}" Background="{DynamicResource Kyf.Brush.PillSheetBackground}">
                <TextBlock x:Name="CountdownText" Text="{Binding Countdown}" Style="{DynamicResource Kyf.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Kyf.Brush.PillSheetText}" />
              </Border>
            </InlineUIContainer>
            <Run x:Name="DayLabel" Text="{Binding DayLabel, Mode=OneWay}" Style="{StaticResource ExamDayLabel}" />
          </TextBlock>
          <TextBlock x:Name="ExamDetail" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="{Binding Detail, Mode=OneWay}" /><Run x:Name="After" Text="{Binding AfterExam, Mode=OneWay}" /><Run x:Name="ArchivedNote" Text="{Binding ArchivedNote, Mode=OneWay}" /></TextBlock>
        </StackPanel>
        <StackPanel kyf:AdaptiveRow.Part="Trailing" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="Tighten" Content="{x:Static pages:ExamText.TightenAction}" Click="OnTightenClick" Focusable="False" Margin="0,0,4,0"
                  AutomationProperties.Name="{Binding TightenName}" Visibility="{Binding CanTighten, Converter={StaticResource Visible}}"
                  IsEnabled="{Binding DataContext.Exams.IsIdle, RelativeSource={RelativeSource AncestorType=ListBox}, FallbackValue=False}" />
          <Button x:Name="More" Style="{DynamicResource Kyf.Button.Icon}" Content="{x:Static kyf:Icons.More}" Click="OnExamMenuClick" Focusable="False"
                  ToolTip="{Binding MoreName}" AutomationProperties.Name="{Binding MoreName}" Visibility="{Binding DataContext.CanPlanExams, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Visible}}"
                  IsEnabled="{Binding DataContext.Exams.IsIdle, RelativeSource={RelativeSource AncestorType=ListBox}, FallbackValue=False}" />
        </StackPanel>
      </kyf:AdaptiveRow>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Urgency}" Value="Soon">
          <Setter TargetName="Countdown" Property="Background" Value="{DynamicResource Kyf.Brush.WarningBackground}" />
          <Setter TargetName="CountdownText" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Urgency}" Value="Past">
          <Setter TargetName="Countdown" Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
          <Setter TargetName="CountdownText" Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasAlert}" Value="True">
          <Setter TargetName="After" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
          <Setter TargetName="After" Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <!-- La ligne choisie a son propre fond : le texte secondaire prend la couleur qui s'y lit, dans chaque thème. -->
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="DayLabel" Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
          <Setter TargetName="ExamDetail" Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
          <Setter TargetName="After" Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Un encart apporté par un module (la citation du jour). -->
    <DataTemplate DataType="{x:Type modules:DashboardCard}">
      <Border x:Name="Aside" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
        <StackPanel>
          <TextBlock Text="{Binding Text}" Style="{DynamicResource Kyf.Text.BodyLarge}" TextWrapping="Wrap" />
          <TextBlock x:Name="Credit" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"><Run x:Name="Detail" Text="{Binding Detail, Mode=OneWay}" /><Run x:Name="Separator" Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
          <Setter TargetName="Separator" Property="Text" Value="" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Sans colonne latérale : les jours à venir, la semaine et les encarts, à la suite de la liste. -->
    <DataTemplate DataType="{x:Type pages:DashboardExtras}">
      <StackPanel DataContext="{Binding Page}" Margin="0,16,0,8">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ForecastSection}" Focusable="False" IsTabStop="False"
                        Margin="0,0,0,16" Visibility="{Binding HasForecast, Converter={StaticResource Visible}}" />
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WeekSection}" Focusable="False" IsTabStop="False"
                        Visibility="{Binding HasWeek, Converter={StaticResource Visible}}" />
        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Visibility="{Binding HasCards, Converter={StaticResource Visible}}" />
      </StackPanel>
    </DataTemplate>

    <!-- Une tuile du jour (rangée 26C) : son nom à sa couleur, son nombre ; choisie, au fond du choix actif. -->
    <Style x:Key="DayTile" TargetType="ToggleButton">
      <Setter Property="Template" Value="{DynamicResource Kyf.Template.Button}" />
      <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
      <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
      <Setter Property="Background" Value="{DynamicResource Kyf.Brush.SurfaceAlt}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource Kyf.FocusVisual}" />
      <Setter Property="kyf:Transitions.PressScale" Value="0.97" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="3,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Command" Value="{Binding DataContext.ChooseTileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
      <Setter Property="CommandParameter" Value="{Binding}" />
      <Setter Property="IsChecked" Value="{Binding IsChosen, Mode=OneWay}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Spoken}" />
      <Style.Triggers>
        <!-- Choisie : le fond du choix actif et son contour, comme les autres choix de kyfRev. -->
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
          <Setter Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Divider}" />
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions>
            <Condition Property="IsMouseOver" Value="True" />
            <Condition Property="IsChecked" Value="False" />
          </MultiTrigger.Conditions>
          <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.ControlBorder}" />
        </MultiTrigger>
        <!-- Vide, elle ne se choisit pas. -->
        <DataTrigger Binding="{Binding Count}" Value="0">
          <Setter Property="IsEnabled" Value="False" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- À l'étroit, la tuile tient sur une ligne : la liste passe avant. -->
    <DataTemplate x:Key="DayTileTemplate" DataType="{x:Type pages:DayTile}">
      <ToggleButton x:Name="Tile" Style="{StaticResource DayTile}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="TileTitle" Text="{Binding Title}" Style="{DynamicResource Kyf.Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Kyf.Brush.Primary}"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock x:Name="TileCount" Grid.Row="1" kyf:Transitions.RollingText="{Binding Count}" FontFamily="{DynamicResource Kyf.Font.Code}" FontWeight="SemiBold"
                     FontSize="{DynamicResource Kyf.FontSize.Subtitle}" VerticalAlignment="Center" />
        </Grid>
      </ToggleButton>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Overdue">
          <Setter TargetName="TileTitle" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Reminders">
          <Setter TargetName="TileTitle" Property="Foreground" Value="{DynamicResource Kyf.Brush.MarkerReminder}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding DataContext.HasRoom, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
          <Setter TargetName="TileCount" Property="Grid.Row" Value="0" />
          <Setter TargetName="TileCount" Property="Grid.Column" Value="1" />
          <Setter TargetName="TileCount" Property="Margin" Value="8,0,0,0" />
          <Setter TargetName="TileCount" Property="FontSize" Value="{DynamicResource Kyf.FontSize.Body}" />
          <Setter TargetName="Tile" Property="Padding" Value="10,0" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Le titre et le résumé du jour sur une ligne quand il y a la place, l'un sous l'autre sinon. -->
    <Style x:Key="HeroSlot" TargetType="ContentControl">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="24,0,0,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="OneColumn">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
          <Setter Property="Grid.Row" Value="1" />
          <Setter Property="Margin" Value="0,12,0,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Les boutons de la séance : à droite, ou dessous sur toute la largeur. -->
    <Style x:Key="HeroActions" TargetType="StackPanel">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,0,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasRoom}" Value="False">
          <Setter Property="DockPanel.Dock" Value="Bottom" />
          <Setter Property="Orientation" Value="Vertical" />
          <Setter Property="Margin" Value="0,12,0,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PageMargin" TargetType="Grid">
      <Setter Property="Margin" Value="24,24,24,16" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="OneColumn">
          <Setter Property="Margin" Value="16,12,16,8" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Une partie de la colonne latérale : son titre, ce qu'elle montre, puis de l'espace et un filet. Seule la liste du jour est une carte. -->
    <Style x:Key="SideSection" TargetType="Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Divider}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,0,0,16" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- Un avertissement du jour : une ligne dans sa couleur, un point devant, et le lien qui mène où le régler. -->
    <Style x:Key="WarningLine" TargetType="Grid">
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <Style x:Key="WarningDot" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource Kyf.Brush.Warning}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- Le lien de l'avertissement : à la suite du texte, ou sous lui quand la place manque. -->
    <Style x:Key="WarningLink" TargetType="Border">
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasRoom}" Value="False">
          <Setter Property="Grid.Column" Value="1" />
          <Setter Property="Grid.Row" Value="1" />
          <Setter Property="Margin" Value="-8,0,0,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SideColumn" TargetType="DockPanel">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="OneColumn">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- L'aperçu : plus large quand la liste se partage en deux. -->
    <Style x:Key="PreviewPane" TargetType="ContentControl">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Width" Value="620" />
      <Setter Property="Margin" Value="32,0,0,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="WithSplit">
          <Setter Property="Width" Value="840" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- La seconde carte de la liste. -->
    <Style x:Key="SecondList" TargetType="ContentControl">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="WithSplit">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Style="{StaticResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="Subtitle" Text="{Binding DayLabel}" Style="{DynamicResource Kyf.Text.Secondary}" />
      <TextBlock x:Name="Heading" Text="{x:Static pages:DashboardText.Today}" Style="{DynamicResource Kyf.Text.Title}"
                 AutomationProperties.HeadingLevel="Level1" />
    </StackPanel>

    <!-- Ce qu'il y a à réviser aujourd'hui, et de quoi s'y mettre. -->
    <ContentControl Style="{StaticResource HeroSlot}">
      <!-- Sans cadre : la seule carte de la vue est la liste à réviser. -->
      <Border x:Name="Hero" Padding="0,4" AutomationProperties.Name="{Binding Subtitle}">
        <DockPanel>
          <StackPanel Style="{StaticResource HeroActions}">
            <Button x:Name="ResumeButton" Content="{Binding ResumeLabel}" Command="{Binding ResumeCommand}"
                    Visibility="{Binding CanResume, Converter={StaticResource Visible}}" />
            <Border Width="8" Height="8" Visibility="{Binding CanResume, Converter={StaticResource Visible}}" />
            <!-- Toujours là (rangée 26C) : à l'étroit, la nouvelle fiche se réduit à son icône, « Commencer » prend le reste. -->
            <DockPanel>
              <!-- Une idée de fiche vient souvent ici : on la crée sans passer par la vue Fiches. -->
              <Button x:Name="NewSheetButton" DockPanel.Dock="Left" Margin="0,0,8,0" Command="{Binding NewSheetCommand}"
                      ToolTip="{x:Static pages:DashboardText.NewSheet}" AutomationProperties.Name="{x:Static pages:DashboardText.NewSheet}">
                <StackPanel Orientation="Horizontal">
                  <kyf:Icon Text="{x:Static kyf:Icons.Add}" />
                  <TextBlock Text="{x:Static pages:DashboardText.NewSheet}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding HasRoom, Converter={StaticResource Visible}}" />
                </StackPanel>
              </Button>
              <Button x:Name="StartButton" Command="{Binding StartCommand}" Style="{DynamicResource Kyf.Button.Primary}" AutomationProperties.Name="{Binding StartLabel}"
                      ToolTip="{Binding StartHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.HelpText="{Binding StartHint}">
                <StackPanel Orientation="Horizontal">
                  <kyf:Icon Text="&#xE768;" Margin="0,0,8,0" />
                  <TextBlock Text="{Binding StartLabel}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DockPanel>
          </StackPanel>
          <TextBlock x:Name="HeroCount" DockPanel.Dock="Left" kyf:Transitions.RollingText="{Binding ReviewCount}" FontFamily="{DynamicResource Kyf.Font.Code}" FontWeight="SemiBold"
                     FontSize="{DynamicResource Kyf.FontSize.Display}" VerticalAlignment="Center" Margin="0,0,16,0"
                     Visibility="{Binding HasReviews, Converter={StaticResource Visible}}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="HeroLabel" Text="{Binding ReviewNoun}" Style="{DynamicResource Kyf.Text.BodyLarge}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ItemsControl x:Name="Chips" ItemsSource="{Binding Chips}" Focusable="False" Visibility="{Binding HasReviews, Converter={StaticResource Visible}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:HeroChip}">
                  <kyf:Pill Kind="{Binding Kind}" Text="{Binding Text}" Margin="0,4,8,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DockPanel>
      </Border>
    </ContentControl>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
      <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}"
                        IsClosable="False" Margin="0,12,0,0" />
      <Grid x:Name="HealthWarning" Style="{StaticResource WarningLine}" Visibility="{Binding HasHealthWarning, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Ellipse Style="{StaticResource WarningDot}" />
        <TextBlock x:Name="HealthText" Grid.Column="1" Text="{Binding HealthWarning}" Style="{DynamicResource Kyf.Text.Body}" Foreground="{DynamicResource Kyf.Brush.Warning}"
                   TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="HealthWarning" />
        <Border Style="{StaticResource WarningLink}">
          <Button x:Name="HealthLink" Style="{DynamicResource Kyf.Button.Subtle}" Foreground="{DynamicResource Kyf.Brush.Primary}" FontWeight="SemiBold" MinHeight="44" Padding="8,0"
                  Command="{Binding OpenHealthCommand}" Content="{x:Static pages:DashboardText.SeeHealth}" AutomationProperties.Name="{x:Static pages:DashboardText.SeeHealth}" />
        </Border>
      </Grid>
      <Grid x:Name="PriorityWarning" Style="{StaticResource WarningLine}" Visibility="{Binding HasPriorityWarning, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse Style="{StaticResource WarningDot}" />
        <TextBlock x:Name="PriorityText" Grid.Column="1" Text="{Binding PriorityWarning}" Style="{DynamicResource Kyf.Text.Body}" Foreground="{DynamicResource Kyf.Brush.Warning}"
                   TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="PriorityWarning" />
      </Grid>
      <kyf:Notification x:Name="ExamMessage" Severity="Success" Message="{Binding Exams.Message}" IsOpen="{Binding Exams.HasMessage, Mode=OneWay, FallbackValue=False}"
                        IsClosable="False" Margin="0,12,0,0" />
      <kyf:Notification x:Name="ExamError" Severity="Critical" Message="{Binding Exams.Error}" IsOpen="{Binding Exams.HasError, Mode=OneWay, FallbackValue=False}"
                        IsClosable="False" Margin="0,12,0,0" />
      <kyf:Notification x:Name="SpreadMessage" Severity="Success" Message="{Binding Spread.Message}" IsOpen="{Binding Spread.HasMessage, Mode=OneWay, FallbackValue=False}"
                        IsClosable="False" Margin="0,12,0,0" />
      <kyf:Notification x:Name="SpreadError" Severity="Critical" Message="{Binding Spread.Error}" IsOpen="{Binding Spread.HasError, Mode=OneWay, FallbackValue=False}"
                        IsClosable="False" Margin="0,12,0,0" />
    </StackPanel>

    <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0">
      <!-- La colonne latérale : les encarts en bas, le reste défile au besoin. -->
      <DockPanel x:Name="Side" DockPanel.Dock="Right" Width="300" Margin="32,0,0,0" Style="{StaticResource SideColumn}">
        <ItemsControl x:Name="Cards" DockPanel.Dock="Bottom" ItemsSource="{Binding Cards}" Focusable="False" Margin="8,0"
                      Visibility="{Binding HasCards, Converter={StaticResource Visible}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="8,8,8,4">
            <Border x:Name="RemindersSection" Style="{StaticResource SideSection}" Visibility="{Binding HasSideReminders, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="{x:Static pages:DashboardText.Reminders}" Style="{DynamicResource Kyf.Text.BodyStrong}" AutomationProperties.HeadingLevel="Level2" />
                <ItemsControl x:Name="SideReminders" ItemsSource="{Binding SideReminders}" Focusable="False" Margin="-8,4,-8,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:ReminderRow}">
                      <Button Style="{DynamicResource Kyf.Button.Subtle}" Padding="8,0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                              Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Spoken}">
                        <StackPanel Margin="0,4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Meta}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border x:Name="ForecastSection" Style="{StaticResource SideSection}" Visibility="{Binding HasForecast, Converter={StaticResource Visible}}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ForecastSection}" Focusable="False" IsTabStop="False" />
            </Border>
            <!-- La dernière : rien ne la suit dans la colonne, elle n'a pas de filet. -->
            <Border x:Name="WeekSection" Visibility="{Binding HasWeek, Converter={StaticResource Visible}}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WeekSection}" Focusable="False" IsTabStop="False" />
            </Border>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- L'aperçu de la ligne choisie, sur les grands écrans. -->
      <ContentControl Style="{StaticResource PreviewPane}" Visibility="{Binding ShowsPreview, Converter={StaticResource Visible}}">
        <!-- Sans cadre : la seule carte de la vue est la liste à réviser ; un filet sépare l'aperçu de ce qui l'entoure. -->
        <Border x:Name="PreviewCard" BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1,0,0,0" Padding="32,4,0,0"
                AutomationProperties.Name="{x:Static pages:DashboardText.Preview}">
          <ContentControl Content="{Binding Preview}" Focusable="False" IsTabStop="False" />
        </Border>
      </ContentControl>

      <kyf:Card x:Name="ListCard" Padding="8">
      <UniformGrid Rows="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Margin="4,0,4,4">
            <DockPanel>
              <!-- Le tri : le choix en cours, les autres dans un menu. -->
              <Button x:Name="SortButton" Style="{DynamicResource Kyf.Button.Subtle}" Click="OnSortClick" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="{Binding SortName}"
                      AutomationProperties.Name="{Binding SortName}">
                <Button.ContextMenu>
                  <ContextMenu x:Name="SortMenu" ItemsSource="{Binding Sorts}" DisplayMemberPath="Label"
                               AutomationProperties.Name="{x:Static pages:DashboardText.SortBy}" />
                </Button.ContextMenu>
                <StackPanel Orientation="Horizontal">
                  <kyf:Icon Text="&#xE8CB;" />
                  <StackPanel x:Name="SortChoice" Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding HasRoom, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding SortName}" VerticalAlignment="Center" />
                    <kyf:Icon Text="&#xE70D;" FontSize="12" Margin="8,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Button>
              <!-- Le filtre écrit (rangée 26C) : le genre, un dossier, une étiquette ou un mot ; la séance suit la liste. -->
              <TextBox x:Name="FilterBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=150}" VerticalContentAlignment="Center"
                       kyf:Field.Placeholder="{x:Static pages:DashboardText.FilterPlaceholder}" AutomationProperties.Name="{x:Static pages:DashboardText.FilterName}"
                       PreviewKeyDown="OnFilterKeyDown" />
            </DockPanel>
            <!-- Les tuiles du jour : un clic ne garde que les leurs, un second rend tout. -->
            <ItemsControl x:Name="Tiles" ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource DayTileTemplate}" Focusable="False" Margin="-3,8,-3,0"
                          AutomationProperties.Name="{x:Static pages:DashboardText.Tiles}" Visibility="{Binding HasTiles, Converter={StaticResource Visible}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <!-- Où en est la journée : ce qui est fait sur le tout, et ce que la séance ouvrira d'abord. -->
            <StackPanel x:Name="DayProgress" Margin="0,8,0,0" Visibility="{Binding HasProgress, Converter={StaticResource Visible}}">
              <ProgressBar Maximum="1" Value="{Binding DoneShare, Mode=OneWay}" Height="4" AutomationProperties.Name="{Binding Progress}" />
              <TextBlock x:Name="ProgressText" Text="{Binding Progress}" Style="{DynamicResource Kyf.Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>

          <!-- Squelettes pendant la première lecture. -->
          <StackPanel x:Name="Loading" Grid.Row="1" Margin="12,8,12,0" kyf:Transitions.StandsIn="{Binding IsLoading}"
                      AutomationProperties.Name="{x:Static pages:DashboardText.Loading}">
            <kyf:Skeleton Width="220" Height="20" HorizontalAlignment="Left" Margin="0,0,0,16" />
            <kyf:Skeleton Height="44" Margin="0,0,0,8" />
            <kyf:Skeleton Height="44" Margin="0,0,0,8" />
            <kyf:Skeleton Height="44" Margin="0,0,0,8" />
          </StackPanel>

          <!-- La liste : une seule liste virtualisée, pour qu'un grand coffre s'affiche vite. -->
          <pages:OpenableList x:Name="Items" Grid.Row="1" ItemsSource="{Binding Rows}" OpenCommand="{Binding OpenCommand}" SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                   AutomationProperties.Name="{x:Static pages:DashboardText.Items}"
                   ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                   PreviewKeyDown="OnItemsKeyDown" SelectionChanged="OnItemsSelectionChanged" MouseDoubleClick="OnItemsDoubleClick" />

          <TextBlock x:Name="Footer" Grid.Row="2" Text="{Binding Footer}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="16,8,16,4"
                     Visibility="{Binding HasRoom, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- La suite de la liste, sur un très grand écran : dans la même carte, après un filet. -->
        <ContentControl Style="{StaticResource SecondList}">
        <Border BorderBrush="{DynamicResource Kyf.Brush.Divider}" BorderThickness="1,0,0,0" Padding="8,0,0,0">
          <pages:OpenableList x:Name="SecondItems" ItemsSource="{Binding SecondRows}" OpenCommand="{Binding OpenCommand}" SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                   AutomationProperties.Name="{x:Static pages:DashboardText.Items}"
                   ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                   PreviewKeyDown="OnItemsKeyDown" SelectionChanged="OnItemsSelectionChanged" MouseDoubleClick="OnItemsDoubleClick" />
        </Border>
        </ContentControl>
      </UniformGrid>
      </kyf:Card>
    </DockPanel>

    <kyf:Dialog x:Name="ArchiveConfirmation" Grid.RowSpan="9" Grid.ColumnSpan="9" Title="{x:Static pages:ReviewText.ArchiveTitle}" IsOpen="{Binding IsConfirmingArchive, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:ReviewText.ArchiveConfirm}" Closed="OnArchiveClosed">
      <TextBlock Text="{x:Static pages:ReviewText.ArchiveMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
    </kyf:Dialog>

    <kyf:Dialog x:Name="ExamConfirmation" Grid.RowSpan="9" Grid.ColumnSpan="9" DataContext="{Binding Exams}" Title="{Binding ConfirmTitle}" IsOpen="{Binding IsConfirming, Mode=OneWay, FallbackValue=False}"
                PrimaryButtonText="{Binding ConfirmLabel}" Closed="OnExamConfirmationClosed">
      <StackPanel>
        <TextBlock Text="{Binding ConfirmMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
        <!-- Les fiches archivées du dossier échappent aux révisions : on peut les y remettre avant l'examen. -->
        <StackPanel x:Name="IncludeArchived" Margin="0,12,0,0" Visibility="{Binding CanIncludeArchived, Converter={StaticResource Visible}}">
          <CheckBox x:Name="IncludeArchivedBox" IsChecked="{Binding IncludeArchived}" AutomationProperties.Name="{Binding IncludeArchivedLabel}" AutomationProperties.HelpText="{x:Static pages:ExamText.IncludeArchivedHelp}">
            <TextBlock Text="{Binding IncludeArchivedLabel}" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Text="{x:Static pages:ExamText.IncludeArchivedHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="NewSheetDialog" Grid.RowSpan="9" Grid.ColumnSpan="9" Title="{x:Static pages:DashboardText.NewSheet}" IsOpen="{Binding IsCreatingSheet, Mode=OneWay, FallbackValue=False}"
                PrimaryButtonText="{x:Static pages:DashboardText.NewSheetCreate}" Closed="OnNewSheetClosed">
      <StackPanel>
        <kyf:Notification x:Name="NewSheetErrorMessage" Severity="Critical" Message="{Binding NewSheetError}" IsOpen="{Binding HasNewSheetError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,12" />
        <TextBlock Text="{x:Static pages:DashboardText.NewSheetTitleLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="NewSheetTitleBox" Text="{Binding NewSheetTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static pages:DashboardText.NewSheetTitleLabel}" />
        <TextBlock x:Name="NewSheetPlaceText" Text="{Binding NewSheetPlace}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="SpreadDialog" Grid.RowSpan="9" Grid.ColumnSpan="9" DataContext="{Binding Spread}" Title="{x:Static pages:SpreadText.Title}" IsOpen="{Binding IsOpen, Mode=OneWay, FallbackValue=False}"
                PrimaryButtonText="{x:Static pages:SpreadText.Confirm}" Closed="OnSpreadClosed">
      <StackPanel>
        <TextBlock Text="{x:Static pages:SpreadText.Help}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <RadioButton x:Name="CatchUpChoice" GroupName="SpreadKind" IsChecked="{Binding IsCatchUp}" Margin="0,0,0,8" AutomationProperties.HelpText="{x:Static pages:SpreadText.CatchUpHelp}">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SpreadText.CatchUp}" />
            <TextBlock Text="{x:Static pages:SpreadText.CatchUpHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="PauseChoice" GroupName="SpreadKind" IsChecked="{Binding IsPause}" AutomationProperties.HelpText="{x:Static pages:SpreadText.PauseHelp}">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SpreadText.Pause}" />
            <TextBlock Text="{x:Static pages:SpreadText.PauseHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>
        <StackPanel x:Name="PauseDays" Margin="0,8,0,0" Visibility="{Binding IsPause, Converter={StaticResource Visible}}">
          <TextBlock Text="{x:Static pages:SpreadText.From}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
          <kyf:DateField x:Name="PauseFromDay" Width="200" HorizontalAlignment="Left" Day="{Binding PauseFrom}" Minimum="{Binding Earliest}" AutomationProperties.Name="{x:Static pages:SpreadText.From}" />
          <TextBlock Text="{x:Static pages:SpreadText.To}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,8,0,4" />
          <kyf:DateField x:Name="PauseToDay" Width="200" HorizontalAlignment="Left" Day="{Binding PauseTo}" Minimum="{Binding PauseFrom}" AutomationProperties.Name="{x:Static pages:SpreadText.To}" />
        </StackPanel>
        <TextBlock Text="{x:Static pages:SpreadText.PerDay}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,12,0,4" />
        <TextBox x:Name="SpreadPerDay" Width="80" HorizontalAlignment="Left" Text="{Binding PerDay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static pages:SpreadText.PerDay}" />
        <!-- Le plan, recalculé à chaque changement : ce qui sera fait si on accepte. -->
        <TextBlock x:Name="SpreadPlan" Text="{Binding Plan}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="ExamEditor" Grid.RowSpan="9" Grid.ColumnSpan="9" DataContext="{Binding Exams}" Title="{Binding EditorTitle}" IsOpen="{Binding IsEditing, Mode=OneWay, FallbackValue=False}"
                PrimaryButtonText="{x:Static pages:ExamText.Save}" Closed="OnExamEditorClosed">
      <StackPanel>
        <TextBlock Text="{x:Static pages:ExamText.EditorHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <kyf:Notification x:Name="ExamEditorError" Severity="Critical" Message="{Binding EditorError}" IsOpen="{Binding HasEditorError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,12" />
        <TextBlock Text="{x:Static pages:ExamText.NameLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="ExamNameBox" Text="{Binding ExamName, UpdateSourceTrigger=PropertyChanged}" kyf:Field.Placeholder="{x:Static pages:ExamText.NamePlaceholder}"
                 AutomationProperties.Name="{x:Static pages:ExamText.NameLabel}" />
        <TextBlock Text="{x:Static pages:ExamText.FolderLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,8,0,4" />
        <ComboBox x:Name="ExamFolderChoice" ItemsSource="{Binding Folders}" SelectedItem="{Binding Folder}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static pages:ExamText.FolderLabel}" />
        <TextBlock Text="{x:Static pages:ExamText.DateLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,8,0,4" />
        <kyf:DateField x:Name="ExamDay" Width="200" HorizontalAlignment="Left" Day="{Binding Day}" Minimum="{Binding Earliest}" AutomationProperties.Name="{x:Static pages:ExamText.DateLabel}" />
      </StackPanel>
    </kyf:Dialog>
  </Grid>
</UserControl>
