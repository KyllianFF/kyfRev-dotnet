<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.DashboardPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:modules="clr-namespace:KyfRev.Application.Modules;assembly=KyfRev.Application"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Choix en ligne (filtre), comme le choix du thème de la galerie. -->
    <ItemsPanelTemplate x:Key="InLine">
      <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- Sept colonnes égales : les jours à venir, les jours passés. -->
    <ItemsPanelTemplate x:Key="SevenDays">
      <UniformGrid Columns="7" />
    </ItemsPanelTemplate>

    <!-- Rien à réviser aujourd'hui. -->
    <DataTemplate DataType="{x:Type pages:EmptyDashboardRow}">
      <kyf:EmptyState Glyph="{x:Static kyf:Icons.Success}" Title="{x:Static pages:DashboardText.EmptyTitle}"
                      Description="{Binding Description}" Margin="0,8,0,16" />
    </DataTemplate>

    <!-- En-tête de groupe : le cliquer (ou Entrée, Espace) replie ou déplie le groupe. -->
    <DataTemplate DataType="{x:Type pages:DashboardGroup}">
      <ToggleButton x:Name="Header" Command="{Binding ToggleCommand}" IsChecked="{Binding IsExpanded, Mode=OneWay}" Focusable="False"
                    Style="{DynamicResource Kyf.Button.Subtle}" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,8,0,0"
                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HeadingLevel="Level2">
        <DockPanel>
          <kyf:Icon x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" Margin="8,0,4,0" />
          <kyf:Icon x:Name="Glyph" Text="{Binding Glyph}" Margin="0,0,8,0" />
          <TextBlock x:Name="Title" Text="{Binding Title}" Style="{DynamicResource Kyf.Text.BodyStrong}" VerticalAlignment="Center" />
          <Border Margin="8,0,0,0" Padding="8,0" MinWidth="24" VerticalAlignment="Center" HorizontalAlignment="Left"
                  CornerRadius="{DynamicResource Kyf.Radius.Control}" Background="{DynamicResource Kyf.Brush.SurfaceAlt}">
            <TextBlock Text="{Binding Count}" Style="{DynamicResource Kyf.Text.Caption}" HorizontalAlignment="Center" />
          </Border>
        </DockPanel>
      </ToggleButton>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
          <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Overdue">
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
          <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tone}" Value="Reminder">
          <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.MarkerReminder}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Une fiche ou un passage à réviser : le titre, ce qu'il faut savoir dessous, le retard ou l'échéance, l'étape. -->
    <DataTemplate DataType="{x:Type pages:DueItemRow}">
      <Grid Margin="0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock TextTrimming="CharacterEllipsis" FontSize="{DynamicResource Kyf.FontSize.BodyLarge}">
            <Run x:Name="Heading" Text="{Binding HeadingText, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text="{Binding Source, Mode=OneWay}" Foreground="{DynamicResource Kyf.Brush.TextSecondary}" />
          </TextBlock>
          <TextBlock x:Name="Meta" Text="{Binding Meta}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
          <StackPanel Orientation="Horizontal" Visibility="{Binding FileMissing, Converter={StaticResource Visible}}">
            <kyf:Icon Text="{x:Static kyf:Icons.Warning}" Foreground="{DynamicResource Kyf.Brush.Warning}" FontSize="12" Margin="0,0,4,0" />
            <TextBlock Text="{x:Static pages:DashboardText.FileMissing}" Style="{DynamicResource Kyf.Text.Caption}"
                       Foreground="{DynamicResource Kyf.Brush.Warning}" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="Timing" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock x:Name="Late" Text="{Binding Late}" Style="{DynamicResource Kyf.Text.Caption}" FontWeight="SemiBold"
                     Foreground="{DynamicResource Kyf.Brush.Warning}" HorizontalAlignment="Right" />
          <TextBlock x:Name="Due" Text="{Binding DueDate}" Style="{DynamicResource Kyf.Text.Caption}" HorizontalAlignment="Right" />
        </StackPanel>
        <Border Grid.Column="2" Grid.RowSpan="2" MinWidth="44" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="{DynamicResource Kyf.Radius.Control}"
                Background="{DynamicResource Kyf.Brush.PillSheetBackground}" ToolTip="{x:Static pages:DashboardText.StepTooltip}">
          <TextBlock Text="{Binding Step}" FontFamily="{DynamicResource Kyf.Font.Code}" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="{DynamicResource Kyf.Brush.PillSheetText}" />
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DataContext.HasRoom, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
          <Setter TargetName="Timing" Property="Grid.Column" Value="0" />
          <Setter TargetName="Timing" Property="Grid.Row" Value="1" />
          <Setter TargetName="Timing" Property="Grid.RowSpan" Value="1" />
          <Setter TargetName="Timing" Property="HorizontalAlignment" Value="Left" />
          <Setter TargetName="Timing" Property="Margin" Value="0,2,0,0" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Late}" Value="{x:Null}">
          <Setter TargetName="Late" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding DueDate}" Value="{x:Null}">
          <Setter TargetName="Due" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Heading}" Value="Excerpt">
          <Setter TargetName="Heading" Property="Background" Value="{DynamicResource Kyf.Brush.PillPassageBackground}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Heading}" Value="Hidden">
          <Setter TargetName="Heading" Property="FontStyle" Value="Italic" />
          <Setter TargetName="Heading" Property="FontWeight" Value="Normal" />
          <Setter TargetName="Heading" Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Un rappel de consolidation, dans la liste quand il n'y a pas de colonne latérale. -->
    <DataTemplate DataType="{x:Type pages:ReminderRow}">
      <StackPanel Margin="0,8">
        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource Kyf.FontSize.BodyLarge}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Meta}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
      </StackPanel>
    </DataTemplate>

    <!-- Les sept prochains jours : le nombre d'échéances est écrit, le remplissage le redit. -->
    <DataTemplate x:Key="ForecastSection">
      <StackPanel>
        <TextBlock Text="{x:Static pages:DashboardText.Forecast}" Style="{DynamicResource Kyf.Text.BodyStrong}" AutomationProperties.HeadingLevel="Level2" />
        <ItemsControl x:Name="Forecast" ItemsSource="{Binding Forecast}" ItemsPanel="{StaticResource SevenDays}" Focusable="False" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type pages:ForecastDay}">
              <StackPanel ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" Background="Transparent">
                <Border x:Name="Dot" Width="32" Height="32" CornerRadius="16" HorizontalAlignment="Center"
                        BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.Divider}">
                  <TextBlock x:Name="Count" Text="{Binding Count}" FontFamily="{DynamicResource Kyf.Font.Code}" FontWeight="SemiBold"
                             FontSize="{DynamicResource Kyf.FontSize.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Label}" Style="{DynamicResource Kyf.Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="None">
                  <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Some">
                  <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
                  <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
                  <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Many">
                  <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
                  <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
                  <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- Les révisions de la semaine : le total, et une barre par jour, ancrée en bas. Le survol donne la valeur. -->
    <DataTemplate x:Key="WeekSection">
      <StackPanel>
        <TextBlock Text="{x:Static pages:DashboardText.ThisWeek}" Style="{DynamicResource Kyf.Text.BodyStrong}" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock x:Name="WeekTotal" Style="{DynamicResource Kyf.Text.Body}">
          <Run Text="{Binding WeekTotal, Mode=OneWay}" FontFamily="{DynamicResource Kyf.Font.Code}" FontWeight="SemiBold" FontSize="{DynamicResource Kyf.FontSize.Subtitle}" />
          <Run Text="{Binding WeekNoun, Mode=OneWay}" />
        </TextBlock>
        <ItemsControl x:Name="Week" ItemsSource="{Binding Week}" ItemsPanel="{StaticResource SevenDays}" Focusable="False" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type pages:WeekBar}">
              <DockPanel Height="72" Background="Transparent" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                <TextBlock x:Name="Day" DockPanel.Dock="Bottom" Text="{Binding Label}" Style="{DynamicResource Kyf.Text.Caption}"
                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                <Border x:Name="Bar" VerticalAlignment="Bottom" Height="{Binding Height}" MaxWidth="24" CornerRadius="4,4,0,0"
                        Background="{DynamicResource Kyf.Brush.Primary}" />
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Count}" Value="0">
                  <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Kyf.Brush.Divider}" />
                  <Setter TargetName="Bar" Property="CornerRadius" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                  <Setter TargetName="Day" Property="FontWeight" Value="SemiBold" />
                  <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource Kyf.Brush.Text}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- Un encart apporté par un module (la citation du jour). -->
    <DataTemplate DataType="{x:Type modules:DashboardCard}">
      <Border CornerRadius="{DynamicResource Kyf.Radius.Card}" Padding="16" Margin="0,16,0,0" Background="{DynamicResource Kyf.Brush.NavigationActiveBackground}">
        <StackPanel>
          <TextBlock Text="{Binding Text}" Style="{DynamicResource Kyf.Text.BodyLarge}" TextWrapping="Wrap"
                     Foreground="{DynamicResource Kyf.Brush.NavigationActiveText}" />
          <TextBlock x:Name="Credit" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                     Foreground="{DynamicResource Kyf.Brush.NavigationActiveText}"><Run x:Name="Detail" Text="{Binding Detail, Mode=OneWay}" /><Run x:Name="Separator" Text=" · " /><Run Text="{Binding Title, Mode=OneWay}" /></TextBlock>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
          <Setter TargetName="Separator" Property="Text" Value="" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Sans colonne latérale : les jours à venir, la semaine et les encarts, à la suite de la liste. -->
    <DataTemplate DataType="{x:Type pages:DashboardExtras}">
      <StackPanel DataContext="{Binding Page}" Margin="0,16,0,8">
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ForecastSection}" Focusable="False" IsTabStop="False"
                        Margin="0,0,0,16" Visibility="{Binding HasForecast, Converter={StaticResource Visible}}" />
        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WeekSection}" Focusable="False" IsTabStop="False"
                        Visibility="{Binding HasWeek, Converter={StaticResource Visible}}" />
        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Visibility="{Binding HasCards, Converter={StaticResource Visible}}" />
      </StackPanel>
    </DataTemplate>

    <!-- Le titre et le résumé du jour sur une ligne quand il y a la place, l'un sous l'autre sinon. -->
    <Style x:Key="HeroSlot" TargetType="ContentControl">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="24,0,0,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="OneColumn">
          <Setter Property="Grid.Column" Value="0" />
          <Setter Property="Grid.ColumnSpan" Value="2" />
          <Setter Property="Grid.Row" Value="1" />
          <Setter Property="Margin" Value="0,12,0,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Les boutons de la séance : à droite, ou dessous sur toute la largeur. -->
    <Style x:Key="HeroActions" TargetType="StackPanel">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="16,0,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasRoom}" Value="False">
          <Setter Property="DockPanel.Dock" Value="Bottom" />
          <Setter Property="Orientation" Value="Vertical" />
          <Setter Property="Margin" Value="0,12,0,0" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PageMargin" TargetType="Grid">
      <Setter Property="Margin" Value="24,24,24,16" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="OneColumn">
          <Setter Property="Margin" Value="16,12,16,8" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SideColumn" TargetType="DockPanel">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="OneColumn">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- L'aperçu : plus large quand la liste se partage en deux. -->
    <Style x:Key="PreviewPane" TargetType="ContentControl">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Width" Value="620" />
      <Setter Property="Margin" Value="16,0,0,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="WithSplit">
          <Setter Property="Width" Value="840" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- La seconde carte de la liste. -->
    <Style x:Key="SecondList" TargetType="ContentControl">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Margin" Value="16,0,0,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Layout}" Value="WithSplit">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- L'aperçu de la ligne choisie : son texte, les étapes de son cycle, ce qui a été révisé. -->
    <DataTemplate DataType="{x:Type pages:TodayPreview}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PreviewMeta" Text="{Binding Meta}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
        <TextBlock x:Name="PreviewTitle" Grid.Row="1" Text="{Binding Title}" Style="{DynamicResource Kyf.Text.Title}" TextWrapping="Wrap" Margin="0,4,0,0"
                   AutomationProperties.HeadingLevel="Level2" />
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <kyf:Notification x:Name="PreviewError" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" />
            <TextBlock x:Name="PreviewPrompt" Text="{Binding Prompt}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap"
                       Visibility="{Binding HasPrompt, Converter={StaticResource Visible}}" />
            <TextBlock x:Name="PreviewBody" Text="{Binding Body}" Style="{DynamicResource Kyf.Text.BodyLarge}" TextWrapping="Wrap"
                       Visibility="{Binding HasBody, Converter={StaticResource Visible}}" />
          </StackPanel>
        </ScrollViewer>
        <ItemsControl x:Name="PreviewSteps" Grid.Row="3" ItemsSource="{Binding Steps}" Focusable="False" Margin="0,12,0,0"
                      AutomationProperties.Name="{x:Static pages:ReviewText.Steps}" Visibility="{Binding HasSteps, Converter={StaticResource Visible}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type pages:StepMark}">
              <Border x:Name="Chip" CornerRadius="13" Padding="10,2" Margin="0,0,6,6" BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}"
                      ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="Label" Text="{Binding Label}" FontFamily="{DynamicResource Kyf.Font.Code}" FontSize="{DynamicResource Kyf.FontSize.Caption}" VerticalAlignment="Center" />
                  <kyf:Icon x:Name="Check" Text="&#xE73E;" FontSize="10" Margin="4,0,0,0" Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
                  <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
                  <Setter TargetName="Check" Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
                  <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                  <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
                  <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
                  <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
                  <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel x:Name="PreviewHistory" Grid.Row="4" Margin="0,6,0,0" Visibility="{Binding HasHistory, Converter={StaticResource Visible}}">
          <Separator Margin="0,0,0,8" />
          <TextBlock Text="{x:Static pages:DashboardText.History}" Style="{DynamicResource Kyf.Text.BodyStrong}" AutomationProperties.HeadingLevel="Level3" />
          <ItemsControl ItemsSource="{Binding History}" Focusable="False" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <Button x:Name="ReviewNow" Grid.Row="5" Content="{x:Static pages:DashboardText.ReviewNow}" Style="{DynamicResource Kyf.Button.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0"
                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Row}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Style="{StaticResource PageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="Subtitle" Text="{Binding DayLabel}" Style="{DynamicResource Kyf.Text.Secondary}" />
      <TextBlock x:Name="Heading" Text="{x:Static pages:DashboardText.Today}" Style="{DynamicResource Kyf.Text.Title}"
                 AutomationProperties.HeadingLevel="Level1" />
    </StackPanel>

    <!-- Ce qu'il y a à réviser aujourd'hui, et de quoi s'y mettre. -->
    <ContentControl Style="{StaticResource HeroSlot}">
      <kyf:Card x:Name="Hero" Padding="24,12" AutomationProperties.Name="{Binding Subtitle}">
        <DockPanel>
          <StackPanel Style="{StaticResource HeroActions}">
            <Button x:Name="ResumeButton" Content="{Binding ResumeLabel}" Command="{Binding ResumeCommand}"
                    Visibility="{Binding CanResume, Converter={StaticResource Visible}}" />
            <Border Width="8" Height="8" Visibility="{Binding CanResume, Converter={StaticResource Visible}}" />
            <Button x:Name="StartButton" Command="{Binding StartCommand}" Style="{DynamicResource Kyf.Button.Primary}"
                    Visibility="{Binding CanStart, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding StartLabel}">
              <StackPanel Orientation="Horizontal">
                <kyf:Icon Text="&#xE768;" Margin="0,0,8,0" />
                <TextBlock Text="{Binding StartLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock x:Name="HeroCount" DockPanel.Dock="Left" Text="{Binding ReviewCount}" FontFamily="{DynamicResource Kyf.Font.Code}" FontWeight="SemiBold"
                     FontSize="{DynamicResource Kyf.FontSize.Display}" VerticalAlignment="Center" Margin="0,0,16,0"
                     Visibility="{Binding HasReviews, Converter={StaticResource Visible}}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="HeroLabel" Text="{Binding ReviewNoun}" Style="{DynamicResource Kyf.Text.BodyLarge}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ItemsControl x:Name="Chips" ItemsSource="{Binding Chips}" Focusable="False" Visibility="{Binding HasReviews, Converter={StaticResource Visible}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:HeroChip}">
                  <kyf:Pill Kind="{Binding Kind}" Text="{Binding Text}" Margin="0,4,6,0" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DockPanel>
      </kyf:Card>
    </ContentControl>

    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
      <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}"
                        IsClosable="False" Margin="0,12,0,0" />
      <kyf:Notification x:Name="HealthWarning" Severity="Warning" Message="{Binding HealthWarning}" IsOpen="{Binding HasHealthWarning, Mode=OneWay}"
                        IsClosable="False" Margin="0,12,0,0" />
      <kyf:Notification x:Name="PriorityWarning" Severity="Warning" Message="{Binding PriorityWarning}" IsOpen="{Binding HasPriorityWarning, Mode=OneWay}"
                        IsClosable="False" Margin="0,12,0,0" />
    </StackPanel>

    <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,16,0,0">
      <!-- La colonne latérale : les encarts en bas, le reste défile au besoin. -->
      <DockPanel x:Name="Side" DockPanel.Dock="Right" Width="340" Margin="16,0,0,0" Style="{StaticResource SideColumn}">
        <ItemsControl x:Name="Cards" DockPanel.Dock="Bottom" ItemsSource="{Binding Cards}" Focusable="False"
                      Visibility="{Binding HasCards, Converter={StaticResource Visible}}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="0,0,0,4">
            <kyf:Card Padding="16,12" Margin="0,0,0,12" Visibility="{Binding HasSideReminders, Converter={StaticResource Visible}}">
              <StackPanel>
                <TextBlock Text="{x:Static pages:DashboardText.Reminders}" Style="{DynamicResource Kyf.Text.BodyStrong}" AutomationProperties.HeadingLevel="Level2" />
                <ItemsControl x:Name="SideReminders" ItemsSource="{Binding SideReminders}" Focusable="False" Margin="-8,4,-8,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:ReminderRow}">
                      <Button Style="{DynamicResource Kyf.Button.Subtle}" Padding="8,0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                              Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding Spoken}">
                        <StackPanel Margin="0,4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Meta}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </kyf:Card>
            <kyf:Card Padding="16,12" Margin="0,0,0,12" Visibility="{Binding HasForecast, Converter={StaticResource Visible}}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ForecastSection}" Focusable="False" IsTabStop="False" />
            </kyf:Card>
            <kyf:Card Padding="16,12" Visibility="{Binding HasWeek, Converter={StaticResource Visible}}">
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WeekSection}" Focusable="False" IsTabStop="False" />
            </kyf:Card>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- L'aperçu de la ligne choisie, sur les grands écrans. -->
      <ContentControl Style="{StaticResource PreviewPane}" Visibility="{Binding ShowsPreview, Converter={StaticResource Visible}}">
        <kyf:Card x:Name="PreviewCard" Padding="24,20" AutomationProperties.Name="{x:Static pages:DashboardText.Preview}">
          <ContentControl Content="{Binding Preview}" Focusable="False" IsTabStop="False" />
        </kyf:Card>
      </ContentControl>

      <UniformGrid Rows="1">
      <kyf:Card x:Name="ListCard" Padding="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <WrapPanel Margin="4,0,4,4">
            <ListBox x:Name="Filters" ItemsPanel="{StaticResource InLine}" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"
                     AutomationProperties.Name="{x:Static pages:DashboardText.Show}" />
            <!-- Le tri : le choix en cours, les autres dans un menu. -->
            <Button x:Name="SortButton" Style="{DynamicResource Kyf.Button.Subtle}" Click="OnSortClick" VerticalAlignment="Center" Margin="4,0,0,0"
                    AutomationProperties.Name="{Binding SortName}">
              <Button.ContextMenu>
                <ContextMenu x:Name="SortMenu" ItemsSource="{Binding Sorts}" DisplayMemberPath="Label"
                             AutomationProperties.Name="{x:Static pages:DashboardText.SortBy}" />
              </Button.ContextMenu>
              <StackPanel Orientation="Horizontal">
                <kyf:Icon Text="&#xE8CB;" />
                <StackPanel x:Name="SortChoice" Orientation="Horizontal" Margin="8,0,0,0" Visibility="{Binding HasRoom, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding SortName}" VerticalAlignment="Center" />
                  <kyf:Icon Text="&#xE70D;" FontSize="12" Margin="8,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Button>
          </WrapPanel>

          <!-- Squelettes pendant la première lecture. -->
          <StackPanel x:Name="Loading" Grid.Row="1" Margin="12,8,12,0" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}"
                      AutomationProperties.Name="{x:Static pages:DashboardText.Loading}">
            <kyf:Skeleton Width="220" Height="20" HorizontalAlignment="Left" Margin="0,0,0,16" />
            <kyf:Skeleton Height="44" Margin="0,0,0,8" />
            <kyf:Skeleton Height="44" Margin="0,0,0,8" />
            <kyf:Skeleton Height="44" Margin="0,0,0,8" />
          </StackPanel>

          <!-- La liste : une seule liste virtualisée, pour qu'un grand coffre s'affiche vite. -->
          <ListBox x:Name="Items" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                   AutomationProperties.Name="{x:Static pages:DashboardText.Items}"
                   ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                   PreviewKeyDown="OnItemsKeyDown" SelectionChanged="OnItemsSelectionChanged" MouseDoubleClick="OnItemsDoubleClick" />

          <TextBlock x:Name="Footer" Grid.Row="2" Text="{Binding Footer}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="16,8,16,4"
                     Visibility="{Binding HasRoom, Converter={StaticResource Visible}}" />
        </Grid>
      </kyf:Card>

      <ContentControl Style="{StaticResource SecondList}">
        <kyf:Card Padding="8">
          <ListBox x:Name="SecondItems" ItemsSource="{Binding SecondRows}" SelectedItem="{Binding SelectedRow, Mode=OneWay}"
                   AutomationProperties.Name="{x:Static pages:DashboardText.Items}"
                   ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                   PreviewKeyDown="OnItemsKeyDown" SelectionChanged="OnItemsSelectionChanged" MouseDoubleClick="OnItemsDoubleClick" />
        </kyf:Card>
      </ContentControl>
      </UniformGrid>
    </DockPanel>
  </Grid>
</UserControl>
