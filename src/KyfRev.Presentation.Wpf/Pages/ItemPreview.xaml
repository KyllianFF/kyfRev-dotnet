<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
                    xmlns:reading="clr-namespace:KyfRev.Presentation.Wpf.Reading"
                    xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <BooleanToVisibilityConverter x:Key="Visible" />

  <!-- Une étape du cycle : faite, en cours ou à venir. -->
  <DataTemplate x:Key="StepChip" DataType="{x:Type pages:StepMark}">
    <Border x:Name="Chip" CornerRadius="12" Padding="8,1" Margin="0,0,8,8" BorderThickness="1" BorderBrush="{DynamicResource Kyf.Brush.ControlBorder}"
            ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="Label" Text="{Binding Label}" FontFamily="{DynamicResource Kyf.Font.Code}" FontSize="{DynamicResource Kyf.FontSize.Caption}" VerticalAlignment="Center" />
        <kyf:Icon x:Name="Check" Text="&#xE73E;" FontSize="10" Margin="4,0,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsDone}" Value="True">
        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
        <Setter TargetName="Check" Property="Foreground" Value="{DynamicResource Kyf.Brush.OnPrimary}" />
        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Kyf.Brush.NavigationActiveBackground}" />
        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Primary}" />
        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Kyf.Brush.NavigationActiveText}" />
        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- L'aperçu du Carnet : la fiche posée sur le fond de la page, comme une feuille. Son titre et ses deux boutons sont au-dessus
       d'elle, sur sa largeur ; les étapes du cycle au-dessous, sur sa largeur aussi. Sans papier choisi, la feuille est unie ;
       avec un papier, le texte est sur ses lignes, comme en lecture. Entre deux feuilles, le fond de la page et le rang de la
       suivante. -->
  <DataTemplate x:Key="CarnetPreview" DataType="{x:Type pages:TodayPreview}">
    <Grid x:Name="PreviewColumn" HorizontalAlignment="Center" MaxWidth="{Binding SheetWidth, ElementName=PreviewSheet}" TextElement.Foreground="{DynamicResource Kyf.Brush.Text}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- La feuille s'arrête où commence sa barre de défilement : le titre et les boutons prennent ses marges (SheetInset), pour
           s'aligner sur ses bords et non sur ceux de la vue. -->
      <DockPanel x:Name="PreviewHead" Margin="{Binding SheetInset, ElementName=PreviewSheet}">
        <StackPanel x:Name="PreviewActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button x:Name="ReadButton" Content="{x:Static pages:SheetsText.Read}" Style="{DynamicResource Kyf.Button.Primary}" MinWidth="76" MinHeight="40"
                  Command="{Binding DataContext.ReadSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Button.Resources>
              <CornerRadius x:Key="Kyf.Radius.Control">8,0,0,8</CornerRadius>
            </Button.Resources>
          </Button>
          <Button x:Name="WriteButton" Content="{x:Static pages:SheetsText.Write}" MinWidth="76" MinHeight="40" BorderThickness="0,1,1,1"
                  Command="{Binding DataContext.WriteSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Button.Resources>
              <CornerRadius x:Key="Kyf.Radius.Control">0,8,8,0</CornerRadius>
            </Button.Resources>
          </Button>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom" Margin="0,0,12,0">
          <TextBlock x:Name="PreviewMeta" Text="{Binding Meta}" Style="{DynamicResource Kyf.Text.Caption}" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PreviewTitle" Text="{Binding Title}" Style="{DynamicResource Kyf.Text.Subtitle}" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"
                     Margin="0,2,0,0" AutomationProperties.HeadingLevel="Level2" />
        </StackPanel>
      </DockPanel>
      <StackPanel Grid.Row="1">
        <kyf:Notification x:Name="PreviewError" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" />
        <TextBlock x:Name="PreviewPrompt" Text="{Binding Prompt}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap"
                   Visibility="{Binding HasPrompt, Converter={StaticResource Visible}}" />
      </StackPanel>
      <!-- Le titre est déjà au-dessus. Les liens s'y lisent : on les suit une fois la fiche ouverte. -->
      <reading:PageFitHost x:Name="PreviewSheet" Grid.Row="2" EndlessWidth="760" Margin="0,12,0,0" Visibility="{Binding HasBody, Converter={StaticResource Visible}}">
        <reading:SheetDocumentViewer x:Name="PreviewBody" Reading="{Binding Reading}" Highlights="{Binding Reading.Highlights}" ShowsHeader="False" FollowsSheetLayout="True"
                                     ShowsSheet="True" NumbersPages="True" AutomationProperties.Name="{x:Static pages:ReadingText.Document}" />
      </reading:PageFitHost>
      <Border x:Name="PreviewFoot" Grid.Row="3" Margin="{Binding SheetInset, ElementName=PreviewSheet}" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Kyf.Brush.Divider}">
        <DockPanel LastChildFill="False" Margin="0,8,0,0">
          <ToggleButton x:Name="HistoryToggle" Style="{DynamicResource Kyf.Button.Subtle}" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,-6,0,0" AutomationProperties.Name="{Binding HistoryLabel}"
                        Visibility="{Binding HasHistory, Converter={StaticResource Visible}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding HistoryLabel}" VerticalAlignment="Center" />
              <kyf:Icon x:Name="HistoryChevron" Text="{x:Static kyf:Icons.ChevronRight}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ItemsControl x:Name="PreviewSteps" DockPanel.Dock="Left" ItemsSource="{Binding Steps}" Focusable="False" VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Static pages:ReviewText.Steps}" Visibility="{Binding HasSteps, Converter={StaticResource Visible}}"
                        ItemTemplate="{StaticResource StepChip}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </DockPanel>
      </Border>
      <!-- L'historique se replie : le texte passe avant, et chaque étape dit déjà sa date au survol. -->
      <ScrollViewer x:Name="PreviewHistory" Grid.Row="4" MaxHeight="96" Margin="0,2,0,0" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsChecked, ElementName=HistoryToggle, Converter={StaticResource Visible}}">
        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsChecked, ElementName=HistoryToggle}" Value="True">
        <Setter TargetName="HistoryChevron" Property="Text" Value="{x:Static kyf:Icons.ChevronDown}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- L'aperçu de la ligne choisie : son texte, les étapes de son cycle, ce qui a été révisé. -->
  <DataTemplate DataType="{x:Type pages:TodayPreview}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="PreviewMeta" Text="{Binding Meta}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
      <TextBlock x:Name="PreviewTitle" Grid.Row="1" Text="{Binding Title}" Style="{DynamicResource Kyf.Text.Title}" TextWrapping="Wrap" Margin="0,4,0,0"
                 AutomationProperties.HeadingLevel="Level2" />
      <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <kyf:Notification x:Name="PreviewError" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" />
          <TextBlock x:Name="PreviewPrompt" Text="{Binding Prompt}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap"
                     Visibility="{Binding HasPrompt, Converter={StaticResource Visible}}" />
        </StackPanel>
        <!-- Le titre est déjà au-dessus. Les liens s'y lisent : on les suit une fois la fiche ouverte. -->
        <reading:PageFitHost x:Name="PreviewSheet" Grid.Row="1" Visibility="{Binding HasBody, Converter={StaticResource Visible}}">
          <reading:SheetDocumentViewer x:Name="PreviewBody" Reading="{Binding Reading}" Highlights="{Binding Reading.Highlights}" ShowsHeader="False" FollowsSheetLayout="True"
                                       AutomationProperties.Name="{x:Static pages:ReadingText.Document}" />
        </reading:PageFitHost>
      </Grid>
      <!-- Les étapes du cycle, puis « Historique » à leur suite : une ligne, au lieu de deux. -->
      <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
      <ItemsControl x:Name="PreviewSteps" DockPanel.Dock="Left" ItemsSource="{Binding Steps}" Focusable="False" VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Static pages:ReviewText.Steps}" Visibility="{Binding HasSteps, Converter={StaticResource Visible}}"
                    ItemTemplate="{StaticResource StepChip}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
        <ToggleButton x:Name="HistoryToggle" Style="{DynamicResource Kyf.Button.Subtle}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,-6,0,0" AutomationProperties.Name="{Binding HistoryLabel}"
                      Visibility="{Binding HasHistory, Converter={StaticResource Visible}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding HistoryLabel}" VerticalAlignment="Center" />
            <kyf:Icon x:Name="HistoryChevron" Text="{x:Static kyf:Icons.ChevronRight}" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </ToggleButton>
      </DockPanel>
      <!-- L'historique se replie : le texte passe avant, et chaque étape dit déjà sa date au survol. -->
      <ScrollViewer x:Name="PreviewHistory" Grid.Row="4" MaxHeight="96" Margin="0,2,0,0" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding IsChecked, ElementName=HistoryToggle, Converter={StaticResource Visible}}">
        <ItemsControl ItemsSource="{Binding History}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <!-- « Réviser », sur Aujourd'hui ; dans le Carnet, « Lire » et « Écrire » au-dessus de l'aperçu ouvrent déjà le document. -->
      <DockPanel Grid.Row="5" Margin="0,8,0,0" LastChildFill="False" Visibility="{Binding ShowsOpen, Converter={StaticResource Visible}}">
        <Button x:Name="ReviewNow" Content="{Binding OpenLabel}" Style="{DynamicResource Kyf.Button.Primary}"
                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Row}" />
      </DockPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsChecked, ElementName=HistoryToggle}" Value="True">
        <Setter TargetName="HistoryChevron" Property="Text" Value="{x:Static kyf:Icons.ChevronDown}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
