<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.SheetSharingDialogs"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <Grid>
    <!-- « Partager » : le format, et, s'il y a un fichier, le dossier ; le résultat se lit ici, fenêtre ouverte, au-dessus des formats pour se voir en fenêtre étroite. -->
    <kyf:Dialog x:Name="ShareDialog" Title="{Binding ShareTitle}" IsOpen="{Binding IsSharing, Mode=OneWay}"
                PrimaryButtonText="{Binding ActionLabel}" SecondaryButtonText="{Binding CloseLabel}" IsPrimaryEnabled="{Binding IsIdle}" IsWorking="{Binding IsBusy}" Closed="OnShareClosed">
      <StackPanel>
        <kyf:Notification x:Name="ClearWarning" Severity="Warning" Message="{x:Static pages:SharingText.ClearWarning}" IsOpen="{Binding IsEncrypted, Mode=OneWay}" IsClosable="False" Margin="0,0,0,12" />
        <kyf:Notification x:Name="Preparing" Message="{x:Static pages:SharingText.Preparing}" IsOpen="{Binding IsBusy, Mode=OneWay}" IsClosable="False" ScrollsIntoView="True" Margin="0,0,0,12" />
        <kyf:Notification x:Name="ShareMessage" Severity="Success" StaysOpen="True" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" IsClosable="False" ScrollsIntoView="True" Margin="0,0,0,12" />
        <kyf:Notification x:Name="ShareError" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" ScrollsIntoView="True" Margin="0,0,0,12" />
        <TextBlock Text="{x:Static pages:SharingText.FormatLegend}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level3" />
        <ItemsControl x:Name="Formats" ItemsSource="{Binding Choices}" Focusable="False" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="{x:Static pages:SharingText.FormatLegend}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type pages:ShareChoice}">
              <RadioButton GroupName="FormatPartage" IsChecked="{Binding IsChecked}" Margin="0,0,0,8"
                           AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Help}">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Help}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </kyf:Dialog>

    <!-- « Enregistrer comme modèle » : le titre de la fiche est proposé. -->
    <kyf:Dialog x:Name="TemplateDialog" Title="{x:Static pages:SharingText.TemplateTitle}" IsOpen="{Binding IsNamingTemplate, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:SharingText.TemplateConfirm}" Closed="OnTemplateClosed">
      <StackPanel>
        <kyf:Notification x:Name="TemplateErrorMessage" Severity="Critical" Message="{Binding TemplateError}" IsOpen="{Binding HasTemplateError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,12" />
        <TextBlock Text="{x:Static pages:SharingText.TemplateLabel}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
        <TextBox x:Name="TemplateNameBox" Text="{Binding TemplateName, UpdateSourceTrigger=PropertyChanged}" IsVisibleChanged="OnTemplateNameShown"
                 AutomationProperties.Name="{x:Static pages:SharingText.TemplateLabel}" />
      </StackPanel>
    </kyf:Dialog>
  </Grid>
</UserControl>
