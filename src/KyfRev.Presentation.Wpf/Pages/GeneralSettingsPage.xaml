<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.GeneralSettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel MaxWidth="1100">
      <kyf:Notification x:Name="NotRemembered" Severity="Warning" Message="{x:Static pages:GeneralSettingsText.NotRemembered}" IsOpen="{Binding IsNotRemembered, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
      <TextBlock Text="{x:Static pages:GeneralSettingsText.MachineNote}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <Grid x:Name="Sections">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="SecondColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <kyf:Card x:Name="AppearanceCard" Padding="16,12" Margin="0,0,8,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:GeneralSettingsText.AppearanceTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,8" />

            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static pages:GeneralSettingsText.Theme}" Style="{StaticResource RowLabel}" />
              <ComboBox x:Name="ThemeChoice" Grid.Column="1" ItemsSource="{x:Static pages:GeneralSettingsViewModel.Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.Theme}" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Static pages:GeneralSettingsText.InterfaceSize}" Style="{StaticResource RowLabel}" />
                <TextBlock Text="{x:Static pages:GeneralSettingsText.InterfaceSizeHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,0,12,0" />
              </StackPanel>
              <ComboBox x:Name="SizeChoice" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Sizes}" SelectedItem="{Binding Size}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.InterfaceSize}" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static pages:GeneralSettingsText.Width}" Style="{StaticResource RowLabel}" />
              <ComboBox x:Name="WidthChoice" Grid.Column="1" ItemsSource="{x:Static pages:GeneralSettingsViewModel.Widths}" SelectedItem="{Binding Width}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.Width}" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static pages:GeneralSettingsText.TextSize}" Style="{StaticResource RowLabel}" />
              <ComboBox x:Name="TextSizeChoice" Grid.Column="1" ItemsSource="{x:Static pages:GeneralSettingsViewModel.TextSizes}" SelectedItem="{Binding TextSize}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.TextSize}" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static pages:GeneralSettingsText.Spacing}" Style="{StaticResource RowLabel}" />
              <ComboBox x:Name="SpacingChoice" Grid.Column="1" ItemsSource="{x:Static pages:GeneralSettingsViewModel.LineSpacings}" SelectedItem="{Binding LineSpacing}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.Spacing}" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static pages:GeneralSettingsText.Font}" Style="{StaticResource RowLabel}" />
              <ComboBox x:Name="FontChoice" Grid.Column="1" ItemsSource="{x:Static pages:GeneralSettingsViewModel.Fonts}" SelectedItem="{Binding Font}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.Font}" />
            </Grid>
            <CheckBox x:Name="DefinedWordsBox" IsChecked="{Binding MarkDefinedWords}" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.DefinedWords}" Margin="0,8,0,0">
              <TextBlock Text="{x:Static pages:GeneralSettingsText.DefinedWords}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{x:Static pages:GeneralSettingsText.DefinedWordsHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,4" />

          </StackPanel>
        </kyf:Card>

        <kyf:Card x:Name="PreviewCard" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:GeneralSettingsText.Preview}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
            <TextBlock x:Name="PreviewText" Text="{x:Static pages:GeneralSettingsText.PreviewText}" TextWrapping="Wrap" Foreground="{DynamicResource Kyf.Brush.Text}"
                       FontSize="{Binding PreviewSize}" LineHeight="{Binding PreviewLineHeight}" LineStackingStrategy="BlockLineHeight">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{DynamicResource Kyf.Font.Ui}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviewIsSerif}" Value="True">
                      <Setter Property="FontFamily" Value="Georgia" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </kyf:Card>

        <kyf:Card x:Name="AccessibilityCard" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:GeneralSettingsText.AccessibilityTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,8" />

            <CheckBox x:Name="ReducedMotionBox" IsChecked="{Binding ReducedMotion}" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.ReducedMotion}">
              <TextBlock Text="{x:Static pages:GeneralSettingsText.ReducedMotion}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{x:Static pages:GeneralSettingsText.ReducedMotionHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,12" />

            <CheckBox x:Name="HighContrastBox" IsChecked="{Binding HighContrast}" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.HighContrast}">
              <TextBlock Text="{x:Static pages:GeneralSettingsText.HighContrast}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{x:Static pages:GeneralSettingsText.HighContrastHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,12" />

            <CheckBox x:Name="LargerTargetsBox" IsChecked="{Binding LargerTargets}" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.LargerTargets}">
              <TextBlock Text="{x:Static pages:GeneralSettingsText.LargerTargets}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{x:Static pages:GeneralSettingsText.LargerTargetsHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,12" />

            <TextBlock x:Name="NoVoice" Text="{x:Static pages:GeneralSettingsText.NoVoice}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding HasNoVoice, Converter={StaticResource Visible}}" />
            <Grid Style="{StaticResource Row}" Visibility="{Binding HasVoices, Converter={StaticResource Visible}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static pages:GeneralSettingsText.Voice}" Style="{StaticResource RowLabel}" />
              <ComboBox x:Name="VoiceChoice" Grid.Column="1" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.Voice}" />
            </Grid>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static pages:GeneralSettingsText.Rate}" Style="{StaticResource RowLabel}" />
              <ComboBox x:Name="RateChoice" Grid.Column="1" ItemsSource="{x:Static pages:GeneralSettingsViewModel.Rates}" SelectedItem="{Binding Rate}" DisplayMemberPath="Label" AutomationProperties.Name="{x:Static pages:GeneralSettingsText.Rate}" />
            </Grid>
          </StackPanel>
        </kyf:Card>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
