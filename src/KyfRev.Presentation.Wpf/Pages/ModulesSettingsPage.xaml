<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.ModulesSettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>

  <Grid>
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel MaxWidth="1100">
      <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
      <kyf:Notification x:Name="DoneMessage" Severity="Success" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />

      <kyf:Card x:Name="ModulesCard" Padding="16,12" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="{x:Static pages:ModulesSettingsText.ModulesTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{x:Static pages:ModulesSettingsText.ModulesHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,12" />

          <CheckBox x:Name="QuotesBox" IsChecked="{Binding QuotesActive}" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.QuotesModule}">
            <TextBlock Text="{x:Static pages:ModulesSettingsText.QuotesModule}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Text="{x:Static pages:ModulesSettingsText.QuotesHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,8" />

          <StackPanel x:Name="QuotesOptions" Margin="26,0,0,12" Visibility="{Binding QuotesActive, Converter={StaticResource Visible}}">
            <CheckBox x:Name="OnlineBox" IsChecked="{Binding QuotesOnline}" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.Online}">
              <TextBlock Text="{x:Static pages:ModulesSettingsText.Online}" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="{x:Static pages:ModulesSettingsText.OnlineHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,8" />
            <StackPanel x:Name="DomainsPanel" Margin="26,0,0,0" Visibility="{Binding ShowsDomains, Converter={StaticResource Visible}}">
              <TextBlock Text="{x:Static pages:ModulesSettingsText.DomainsTitle}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
              <ItemsControl x:Name="DomainsList" ItemsSource="{Binding Domains}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.DomainsTitle}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type pages:QuoteDomainChoice}">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChosen}" ToolTip="{Binding Pages}" Margin="0,0,16,4" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Pages}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <CheckBox x:Name="SchemasBox" IsChecked="{Binding SchemasActive}" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.SchemasModule}">
            <TextBlock Text="{x:Static pages:ModulesSettingsText.SchemasModule}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
          </CheckBox>
          <TextBlock Text="{x:Static pages:ModulesSettingsText.SchemasHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,0" />
        </StackPanel>
      </kyf:Card>

      <kyf:Card x:Name="ExtensionsCard" Padding="16,12" DataContext="{Binding Extensions}">
        <StackPanel>
          <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionsTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionsHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock x:Name="ExtensionsNotShownYet" Text="{x:Static pages:ModulesSettingsText.ExtensionsNotShownYet}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <kyf:Notification x:Name="ExtensionError" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Margin="0,8,0,0" />
          <kyf:Notification x:Name="ExtensionDone" Severity="Success" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" IsClosable="False" Margin="0,8,0,0" />
          <Button x:Name="InstallExtension" Content="{x:Static pages:ModulesSettingsText.ExtensionInstallFromFolder}" Command="{Binding InstallCommand}" HorizontalAlignment="Left" Margin="0,12,0,8" />
          <TextBlock x:Name="NoExtension" Text="{x:Static pages:ModulesSettingsText.ExtensionsNone}" Style="{DynamicResource Kyf.Text.Caption}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
          <ItemsControl x:Name="ExtensionsList" ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.ExtensionsTitle}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:ExtensionRow}">
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Kyf.Brush.Divider}" Padding="0,8">
                  <DockPanel>
                    <Button x:Name="RemoveExtension" DockPanel.Dock="Right" Content="{x:Static pages:ModulesSettingsText.ExtensionRemoveLabel}" Style="{DynamicResource Kyf.Button.Subtle}" VerticalAlignment="Top" Margin="8,0,0,0"
                            Command="{Binding DataContext.RequestRemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding RemoveName}" />
                    <StackPanel>
                      <CheckBox x:Name="ExtensionActive" IsChecked="{Binding IsActive}" AutomationProperties.Name="{Binding Name}">
                        <TextBlock Text="{Binding Name}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
                      </CheckBox>
                      <TextBlock Text="{Binding Version}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,0" />
                      <TextBlock Text="{Binding Description}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,0" Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding Adds}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,0" />
                      <TextBlock Text="{Binding Permissions}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="26,2,0,0" Visibility="{Binding HasPermissions, Converter={StaticResource Visible}}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </kyf:Card>
    </StackPanel>
  </ScrollViewer>

  <kyf:Dialog x:Name="InstallConfirmation" DataContext="{Binding Extensions}" Title="{Binding InstallTitle}" IsOpen="{Binding IsConfirmingInstall, Mode=OneWay}"
              PrimaryButtonText="{Binding InstallAction}" Closed="OnInstallClosed">
    <TextBlock Text="{Binding InstallDetails}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
  </kyf:Dialog>

  <kyf:Dialog x:Name="RemoveConfirmation" DataContext="{Binding Extensions}" Title="{x:Static pages:ModulesSettingsText.ExtensionRemoveTitle}" IsOpen="{Binding IsConfirmingRemove, Mode=OneWay}"
              PrimaryButtonText="{x:Static pages:ModulesSettingsText.ExtensionRemove}" Closed="OnRemoveClosed">
    <TextBlock Text="{Binding RemoveDetails}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
  </kyf:Dialog>
  </Grid>
</UserControl>
