<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.ModulesSettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>

  <Grid>
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel MaxWidth="{x:Static pages:SettingsTab.Column}">
      <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
      <kyf:Notification x:Name="DoneMessage" Severity="Success" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />

      <kyf:Card x:Name="ModulesCard" Padding="16,12" Margin="0,0,0,8">
        <StackPanel>
          <TextBlock Text="{x:Static pages:ModulesSettingsText.ModulesTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{x:Static pages:ModulesSettingsText.ModulesHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,12" />

          <!-- Un module s'allume et s'éteint d'une bascule : le changement vaut aussitôt. -->
          <CheckBox x:Name="QuotesBox" Style="{DynamicResource Kyf.Switch}" IsChecked="{Binding QuotesActive}" Margin="0,0,0,12"
                    AutomationProperties.Name="{x:Static pages:ModulesSettingsText.QuotesModule}" AutomationProperties.HelpText="{x:Static pages:ModulesSettingsText.QuotesHelp}">
            <StackPanel>
              <TextBlock Text="{x:Static pages:ModulesSettingsText.QuotesModule}" Style="{DynamicResource Kyf.Text.BodyStrong}" />
              <TextBlock Text="{x:Static pages:ModulesSettingsText.QuotesHelp}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="0,2,0,0" />
            </StackPanel>
          </CheckBox>

          <StackPanel x:Name="QuotesOptions" Margin="20,0,0,12" Visibility="{Binding QuotesActive, Converter={StaticResource Visible}}">
            <CheckBox x:Name="OnlineBox" Style="{DynamicResource Kyf.Switch}" IsChecked="{Binding QuotesOnline}" Margin="0,0,0,8"
                      AutomationProperties.Name="{x:Static pages:ModulesSettingsText.Online}" AutomationProperties.HelpText="{x:Static pages:ModulesSettingsText.OnlineHelp}">
              <StackPanel>
                <TextBlock Text="{x:Static pages:ModulesSettingsText.Online}" Style="{DynamicResource Kyf.Text.Body}" />
                <TextBlock Text="{x:Static pages:ModulesSettingsText.OnlineHelp}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="0,2,0,0" />
              </StackPanel>
            </CheckBox>
            <StackPanel x:Name="DomainsPanel" Visibility="{Binding ShowsDomains, Converter={StaticResource Visible}}">
              <TextBlock Text="{x:Static pages:ModulesSettingsText.DomainsTitle}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,0,4" />
              <ItemsControl x:Name="DomainsList" ItemsSource="{Binding Domains}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.DomainsTitle}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type pages:QuoteDomainChoice}">
                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChosen}" ToolTip="{Binding Pages}" Margin="0,0,16,4" AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Pages}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <Border Style="{DynamicResource Kyf.Setting.Row}" Padding="0,12,0,4">
            <CheckBox x:Name="SchemasBox" Style="{DynamicResource Kyf.Switch}" IsChecked="{Binding SchemasActive}"
                      AutomationProperties.Name="{x:Static pages:ModulesSettingsText.SchemasModule}" AutomationProperties.HelpText="{x:Static pages:ModulesSettingsText.SchemasHelp}">
              <StackPanel>
                <TextBlock Text="{x:Static pages:ModulesSettingsText.SchemasModule}" Style="{DynamicResource Kyf.Text.BodyStrong}" />
                <TextBlock Text="{x:Static pages:ModulesSettingsText.SchemasHelp}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="0,2,0,0" />
              </StackPanel>
            </CheckBox>
          </Border>
        </StackPanel>
      </kyf:Card>

      <kyf:Card x:Name="ExtensionsCard" Padding="16,12" DataContext="{Binding Extensions}">
        <StackPanel>
          <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionsTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionsHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <kyf:Notification x:Name="ExtensionError" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Margin="0,8,0,0" />
          <kyf:Notification x:Name="ExtensionDone" Severity="Success" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" IsClosable="False" Margin="0,8,0,0" />
          <WrapPanel Margin="0,12,0,8">
            <Button x:Name="InstallExtension" Content="{x:Static pages:ModulesSettingsText.ExtensionInstallFromFolder}" Command="{Binding InstallCommand}" Margin="0,0,8,4" />
            <Button x:Name="CreateExtension" Content="{x:Static pages:ModulesSettingsText.ExtensionCreate}" Command="{Binding CreateCommand}" Style="{DynamicResource Kyf.Button.Subtle}" Margin="0,0,8,4" />
            <Button x:Name="OpenCatalogue" Content="{x:Static pages:ModulesSettingsText.CatalogueOpen}" Command="{Binding ReadCatalogueCommand}" Style="{DynamicResource Kyf.Button.Subtle}" Margin="0,0,0,4"
                    Visibility="{Binding CanReadCatalogue, Converter={StaticResource Visible}}" />
          </WrapPanel>
          <!-- Le catalogue : lu seulement à la demande, montré seulement vérifié. -->
          <StackPanel x:Name="ExtensionCatalogue" Margin="0,0,0,8" Visibility="{Binding HasCatalogue, Converter={StaticResource Visible}}">
            <TextBlock Text="{x:Static pages:ModulesSettingsText.CatalogueTitle}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3" />
            <TextBlock Text="{x:Static pages:ModulesSettingsText.CatalogueHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock x:Name="CatalogueState" Text="{Binding CatalogueStatus}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <ItemsControl x:Name="CatalogueList" ItemsSource="{Binding CatalogueRows}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.CatalogueTitle}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:CatalogueRow}">
                  <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0">
                      <Button x:Name="CatalogueInstall" Content="{Binding Action}" Command="{Binding InstallCommand}" AutomationProperties.Name="{Binding Spoken}"
                              Visibility="{Binding CanInstall, Converter={StaticResource Visible}}" />
                      <TextBlock x:Name="CatalogueUpToDate" Text="{x:Static pages:ModulesSettingsText.CatalogueUpToDate}" Style="{DynamicResource Kyf.Text.Caption}"
                                 Visibility="{Binding IsUpToDate, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Version}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasSummary, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding Permissions}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <CheckBox x:Name="DeveloperMode" Style="{DynamicResource Kyf.Switch}" IsChecked="{Binding IsDeveloperMode}" Margin="0,0,0,8" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.ExtensionDeveloper}" AutomationProperties.HelpText="{x:Static pages:ModulesSettingsText.ExtensionDeveloperHelp}">
            <StackPanel>
              <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionDeveloper}" TextWrapping="Wrap" />
              <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionDeveloperHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
            </StackPanel>
          </CheckBox>
          <TextBlock x:Name="NoExtension" Text="{x:Static pages:ModulesSettingsText.ExtensionsNone}" Style="{DynamicResource Kyf.Text.Caption}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
          <ItemsControl x:Name="ExtensionsList" ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.ExtensionsTitle}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:ExtensionRow}">
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Kyf.Brush.Divider}" Padding="0,8">
                  <DockPanel>
                    <Button x:Name="RemoveExtension" DockPanel.Dock="Right" Content="{x:Static pages:ModulesSettingsText.ExtensionRemoveLabel}" Style="{DynamicResource Kyf.Button.Subtle}" VerticalAlignment="Top" Margin="8,0,0,0"
                            Command="{Binding DataContext.RequestRemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding RemoveName}" />
                    <StackPanel>
                      <CheckBox x:Name="ExtensionActive" Style="{DynamicResource Kyf.Switch}" IsChecked="{Binding IsActive}" AutomationProperties.Name="{Binding Name}">
                        <TextBlock Text="{Binding Name}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
                      </CheckBox>
                      <TextBlock Text="{Binding Version}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding Description}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding HasDescription, Converter={StaticResource Visible}}" />
                      <TextBlock Text="{Binding Adds}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      <StackPanel x:Name="ExtensionRights" Margin="0,8,0,0" Visibility="{Binding HasRights, Converter={StaticResource Visible}}">
                        <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionRightsTitle}" Style="{DynamicResource Kyf.Text.Caption}" FontWeight="SemiBold" />
                        <TextBlock x:Name="ExtensionRightsInactive" Text="{x:Static pages:ModulesSettingsText.ExtensionRightsInactive}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding IsInactive, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Rights}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.ExtensionRightsTitle}"
                                      AutomationProperties.HelpText="{x:Static pages:ModulesSettingsText.ExtensionRightsHelp}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:ExtensionRightRow}">
                              <CheckBox x:Name="ExtensionRight" IsChecked="{Binding IsGranted}" IsEnabled="{Binding IsAvailable}" Margin="0,4,0,0" AutomationProperties.Name="{Binding Spoken}"
                                        ToolTip="{x:Static pages:ModulesSettingsText.ExtensionRightsHelp}">
                                <DockPanel>
                                  <kyf:Icon x:Name="RiskGlyph" DockPanel.Dock="Left" Text="{Binding Glyph}" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Kyf.Brush.TextSecondary}" />
                                  <TextBlock x:Name="RightText" Text="{Binding Text}" TextWrapping="Wrap" />
                                </DockPanel>
                              </CheckBox>
                              <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Risk}" Value="Notable">
                                  <Setter TargetName="RiskGlyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Risk}" Value="High">
                                  <Setter TargetName="RiskGlyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.Critical}" />
                                  <Setter TargetName="RightText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                              </DataTemplate.Triggers>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel x:Name="ExtensionDeveloper" Margin="26,8,0,0" Visibility="{Binding IsDeveloper, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="ExtensionSource" Text="{Binding SourceText}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
                        <Button x:Name="ReloadExtension" Content="{x:Static pages:ModulesSettingsText.ExtensionReload}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding DataContext.ReloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding ReloadName}" />
                        <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionFaultsTitle}" Style="{DynamicResource Kyf.Text.Caption}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock x:Name="ExtensionNoFaults" Text="{x:Static pages:ModulesSettingsText.ExtensionNoFaults}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Visibility="{Binding HasNoFaults, Converter={StaticResource Visible}}" />
                        <ItemsControl x:Name="ExtensionFaults" ItemsSource="{Binding Faults}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.ExtensionFaultsTitle}" Visibility="{Binding HasFaults, Converter={StaticResource Visible}}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pages:ExtensionFaultRow}">
                              <DockPanel Margin="0,2,0,0">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding When}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource Kyf.Brush.Critical}" />
                              </DockPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel x:Name="ExtensionJournal" Margin="0,12,0,0" Visibility="{Binding HasJournal, Converter={StaticResource Visible}}">
            <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionJournalTitle}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level3" />
            <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionJournalHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,4" />
            <ItemsControl x:Name="ExtensionJournalList" ItemsSource="{Binding Journal}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.ExtensionJournalTitle}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:ExtensionJournalRow}">
                  <StackPanel Margin="0,8,0,0" AutomationProperties.Name="{Binding Spoken}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding When}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </kyf:Card>
    </StackPanel>
  </ScrollViewer>

  <kyf:Dialog x:Name="InstallConfirmation" DataContext="{Binding Extensions}" Title="{Binding InstallTitle}" IsOpen="{Binding IsConfirmingInstall, Mode=OneWay}"
              PrimaryButtonText="{Binding InstallAction}" IsDestructive="{Binding InstallHasHighRisk}" Closed="OnInstallClosed">
    <StackPanel>
      <TextBlock x:Name="InstallSummary" Text="{Binding InstallSummary}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" />
      <kyf:Notification x:Name="InstallHighRisk" Severity="Critical" Message="{x:Static pages:ModulesSettingsText.ExtensionHighRisk}" IsOpen="{Binding InstallHasHighRisk, Mode=OneWay}" IsClosable="False" Margin="0,12,0,0" />
      <kyf:Notification x:Name="InstallNewRights" Severity="Warning" Message="{x:Static pages:ModulesSettingsText.ExtensionNewRights}" IsOpen="{Binding InstallHasNewRights, Mode=OneWay}" IsClosable="False" Margin="0,12,0,0" />
      <StackPanel Visibility="{Binding InstallHasAdds, Converter={StaticResource Visible}}">
        <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionAddsTitle}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="0,16,0,4" />
        <ItemsControl x:Name="InstallAdds" ItemsSource="{Binding InstallAdds}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.ExtensionAddsTitle}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2,0,0">
                <TextBlock DockPanel.Dock="Left" Text="•" Margin="4,0,8,0" Foreground="{DynamicResource Kyf.Brush.TextSecondary}" />
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionRightsTitle}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="0,16,0,4" />
      <TextBlock x:Name="InstallNoRights" Text="{x:Static pages:ModulesSettingsText.ExtensionNoPermission}" TextWrapping="Wrap" Visibility="{Binding InstallHasNoRights, Converter={StaticResource Visible}}" />
      <ItemsControl x:Name="InstallRights" ItemsSource="{Binding InstallRights}" Focusable="False" AutomationProperties.Name="{x:Static pages:ModulesSettingsText.ExtensionRightsTitle}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type pages:ExtensionRightRow}">
            <DockPanel Margin="0,4,0,0" AutomationProperties.Name="{Binding Spoken}">
              <kyf:Icon x:Name="RiskGlyph" DockPanel.Dock="Left" Text="{Binding Glyph}" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Kyf.Brush.TextSecondary}" />
              <TextBlock x:Name="NewRight" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Text="{x:Static pages:ModulesSettingsText.ExtensionRightNew}"
                         Style="{DynamicResource Kyf.Text.Caption}" Foreground="{DynamicResource Kyf.Brush.Warning}" Visibility="{Binding IsNew, Converter={StaticResource Visible}}" />
              <StackPanel>
                <TextBlock x:Name="RightText" Text="{Binding Text}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionRightKeptWithdrawn}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap"
                           Visibility="{Binding IsWithdrawn, Converter={StaticResource Visible}}" />
              </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Risk}" Value="Notable">
                <Setter TargetName="RiskGlyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.Warning}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding Risk}" Value="High">
                <Setter TargetName="RiskGlyph" Property="Foreground" Value="{DynamicResource Kyf.Brush.Critical}" />
                <Setter TargetName="RightText" Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock x:Name="InstallLimits" Text="{Binding InstallLimits}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,16,0,0" />
      <TextBlock Text="{x:Static pages:ModulesSettingsText.ExtensionTrust}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>
  </kyf:Dialog>

  <kyf:Dialog x:Name="RemoveConfirmation" DataContext="{Binding Extensions}" Title="{x:Static pages:ModulesSettingsText.ExtensionRemoveTitle}" IsOpen="{Binding IsConfirmingRemove, Mode=OneWay}"
              PrimaryButtonText="{x:Static pages:ModulesSettingsText.ExtensionRemove}" Closed="OnRemoveClosed">
    <TextBlock Text="{Binding RemoveDetails}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
  </kyf:Dialog>
  </Grid>
</UserControl>
