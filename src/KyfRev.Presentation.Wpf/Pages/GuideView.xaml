<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.GuideView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:reading="clr-namespace:KyfRev.Presentation.Wpf.Reading"
             xmlns:shell="clr-namespace:KyfRev.Presentation.Wpf.Shell">
  <!-- Le guide : son plan à gauche tant que la place le permet, dans une liste déroulante au-dessus du texte sinon. -->
  <DockPanel>
    <TextBlock x:Name="Shipped" DockPanel.Dock="Bottom" Text="{x:Static shell:GuideText.Shipped}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
    <ComboBox x:Name="PlanChoice" DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="Collapsed" ItemsSource="{Binding Sections}" SelectedItem="{Binding Selected}"
              DisplayMemberPath="Title" AutomationProperties.Name="{x:Static shell:GuideText.Plan}" />
    <ListBox x:Name="Plan" DockPanel.Dock="Left" Width="200" Margin="0,0,16,0" ItemsSource="{Binding Sections}" SelectedItem="{Binding Selected}"
             DisplayMemberPath="Title" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{x:Static shell:GuideText.Plan}" />
    <reading:SheetDocumentViewer x:Name="GuideText" Reading="{Binding Selected.Reading}" ShowsHeader="False" AutomationProperties.Name="{x:Static shell:GuideText.Text}" />
  </DockPanel>
</UserControl>
