<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.StatisticsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Un chiffre clé. -->
    <DataTemplate DataType="{x:Type pages:StatisticsTile}">
      <kyf:Card Margin="0,0,8,8" Padding="16,12" AutomationProperties.Name="{Binding Spoken}">
        <StackPanel>
          <TextBlock Text="{Binding Label}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource Kyf.Brush.Text}" Margin="0,2,0,2" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </kyf:Card>
    </DataTemplate>

    <!-- Une case du calendrier : plus la journée est chargée, plus elle est franche ; le détail est dans l'infobulle. -->
    <DataTemplate x:Key="CellTemplate" DataType="{x:Type pages:CalendarCell}">
      <Border x:Name="Frame" Margin="1" CornerRadius="2" BorderThickness="1" BorderBrush="Transparent" ToolTip="{Binding Description}"
              Height="{Binding DataContext.CellSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Border x:Name="Fill" CornerRadius="1" Background="{DynamicResource Kyf.Brush.Divider}" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Level}" Value="1">
          <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
          <Setter TargetName="Fill" Property="Opacity" Value="0.3" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="2">
          <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
          <Setter TargetName="Fill" Property="Opacity" Value="0.55" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="3">
          <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
          <Setter TargetName="Fill" Property="Opacity" Value="0.8" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="4">
          <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsFuture}" Value="True">
          <Setter TargetName="Fill" Property="Visibility" Value="Hidden" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsToday}" Value="True">
          <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Kyf.Brush.Text}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Une échelle de la légende. -->
    <Style x:Key="LegendCell" TargetType="Border">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="{DynamicResource Kyf.Brush.Primary}" />
    </Style>

    <!-- Un mois : la barre vaut sa part du mois le plus chargé. -->
    <DataTemplate DataType="{x:Type pages:MonthRow}">
      <Grid Margin="0,4" AutomationProperties.Name="{Binding Spoken}" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="48" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Style="{DynamicResource Kyf.Text.Body}" TextTrimming="CharacterEllipsis" />
        <Grid Grid.Column="1" VerticalAlignment="Center" Height="8" Margin="8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Filled}" />
            <ColumnDefinition Width="{Binding Rest}" />
          </Grid.ColumnDefinitions>
          <Border CornerRadius="2" Background="{DynamicResource Kyf.Brush.Primary}" />
        </Grid>
        <TextBlock Grid.Column="2" Text="{Binding Reviews}" Style="{DynamicResource Kyf.Text.Body}" TextAlignment="Right" />
        <TextBlock Grid.Column="3" Text="{Binding ActiveDays}" Style="{DynamicResource Kyf.Text.Body}" TextAlignment="Right" />
      </Grid>
    </DataTemplate>

    <!-- Un dossier. -->
    <DataTemplate DataType="{x:Type pages:FolderRow}">
      <Grid Margin="0,4" AutomationProperties.Name="{Binding Spoken}" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="64" />
          <ColumnDefinition Width="88" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Folder}" Style="{DynamicResource Kyf.Text.Body}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
        <TextBlock Grid.Column="1" Text="{Binding Sheets}" Style="{DynamicResource Kyf.Text.Body}" TextAlignment="Right" />
        <TextBlock Grid.Column="2" Text="{Binding Reviews}" Style="{DynamicResource Kyf.Text.Body}" TextAlignment="Right" />
        <TextBlock Grid.Column="3" Text="{Binding OnTime}" Style="{DynamicResource Kyf.Text.Body}" TextAlignment="Right" />
        <TextBlock Grid.Column="4" Text="{Binding AverageDelay}" Style="{DynamicResource Kyf.Text.Body}" TextAlignment="Right" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel MaxWidth="1440" Margin="16">
      <TextBlock x:Name="Heading" Text="{Binding Title}" Style="{DynamicResource Kyf.Text.Title}" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="Summary" Text="{Binding Summary}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" Margin="0,0,0,8" />

      <StackPanel x:Name="Loading" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static pages:StatisticsText.Loading}">
        <kyf:Skeleton Height="96" Margin="0,0,0,8" />
        <kyf:Skeleton Height="180" Margin="0,0,0,8" />
        <kyf:Skeleton Height="180" />
      </StackPanel>

      <StackPanel x:Name="Figures" Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}">
        <ItemsControl x:Name="TilesList" ItemsSource="{Binding Tiles}" Focusable="False" Margin="0,0,-8,0" AutomationProperties.Name="{x:Static pages:StatisticsText.KeyFigures}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="{Binding DataContext.TileColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <kyf:Card x:Name="CalendarCard" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <DockPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="{x:Static pages:StatisticsText.Less}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,4,0" />
                <Border Style="{StaticResource LegendCell}" Background="{DynamicResource Kyf.Brush.Divider}" />
                <Border Style="{StaticResource LegendCell}" Opacity="0.3" />
                <Border Style="{StaticResource LegendCell}" Opacity="0.55" />
                <Border Style="{StaticResource LegendCell}" Opacity="0.8" />
                <Border Style="{StaticResource LegendCell}" />
                <TextBlock Text="{x:Static pages:StatisticsText.More}" Style="{DynamicResource Kyf.Text.Caption}" Margin="4,0,0,0" />
              </DockPanel>
              <TextBlock Style="{DynamicResource Kyf.Text.Body}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2">
                <Run Text="{x:Static pages:StatisticsText.CalendarTitle}" />
                <Run Text="{x:Static pages:StatisticsText.CalendarPeriod}" FontWeight="Normal" Foreground="{DynamicResource Kyf.Brush.TextSecondary}" />
              </TextBlock>
            </DockPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <!-- Les mois au-dessus de la semaine qui les ouvre : le libellé déborde sur les semaines suivantes. -->
              <pages:DecorativeItems x:Name="MonthsHeader" Grid.Column="1" ItemsSource="{Binding MonthLabels}" Focusable="False" IsHitTestVisible="False" Margin="0,0,0,2">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="{Binding DataContext.WeekCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,0,-48,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </pages:DecorativeItems>
              <!-- Lignes de la hauteur des cases : un nom plus haut qu'une ligne déborde, sans la pousser. -->
              <StackPanel x:Name="WeekDays" Grid.Row="1" VerticalAlignment="Top">
                <Grid Height="{Binding RowHeight}">
                  <TextBlock Text="{x:Static pages:StatisticsText.Monday}" Style="{DynamicResource Kyf.Text.Caption}" VerticalAlignment="Center" Margin="0,-12" />
                </Grid>
                <Grid Height="{Binding RowHeight}" />
                <Grid Height="{Binding RowHeight}">
                  <TextBlock Text="{x:Static pages:StatisticsText.Wednesday}" Style="{DynamicResource Kyf.Text.Caption}" VerticalAlignment="Center" Margin="0,-12" />
                </Grid>
                <Grid Height="{Binding RowHeight}" />
                <Grid Height="{Binding RowHeight}">
                  <TextBlock Text="{x:Static pages:StatisticsText.Friday}" Style="{DynamicResource Kyf.Text.Caption}" VerticalAlignment="Center" Margin="0,-12" />
                </Grid>
              </StackPanel>
              <pages:ActivityCalendar x:Name="Calendar" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Weeks}" Focusable="False"
                                      AutomationProperties.Name="{Binding CalendarName}" SizeChanged="OnCalendarSized">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="{Binding DataContext.WeekCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type pages:CalendarWeek}">
                    <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource CellTemplate}" Focusable="False" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </pages:ActivityCalendar>
            </Grid>
          </StackPanel>
        </kyf:Card>

        <Grid x:Name="Details">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <kyf:Card x:Name="MonthsCard" Padding="16,12" Margin="0,0,8,8" VerticalAlignment="Stretch">
            <StackPanel>
              <TextBlock Text="{x:Static pages:StatisticsText.ByMonth}" Style="{DynamicResource Kyf.Text.Body}" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static pages:StatisticsText.MonthColumn}" Style="{DynamicResource Kyf.Text.Caption}" />
                <TextBlock Grid.Column="1" Style="{DynamicResource Kyf.Text.Caption}" TextAlignment="Right">
                  <Run Text="{x:Static pages:StatisticsText.ReviewsColumn}" /> · <Run Text="{x:Static pages:StatisticsText.ActiveDaysColumn}" />
                </TextBlock>
              </Grid>
              <ItemsControl x:Name="MonthsList" ItemsSource="{Binding Months}" Focusable="False" />
              <TextBlock x:Name="NoMonth" Text="{x:Static pages:StatisticsText.NoMonth}" Style="{DynamicResource Kyf.Text.Secondary}"
                         Visibility="{Binding HasNoMonth, Converter={StaticResource Visible}}" />
            </StackPanel>
          </kyf:Card>
          <kyf:Card x:Name="FoldersCard" Grid.Column="1" Padding="16,12" Margin="0,0,0,8" VerticalAlignment="Stretch">
            <StackPanel>
              <TextBlock Text="{x:Static pages:StatisticsText.ByFolder}" Style="{DynamicResource Kyf.Text.Body}" FontWeight="SemiBold" Margin="0,0,0,8" AutomationProperties.HeadingLevel="Level2" />
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="56" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static pages:StatisticsText.FolderColumn}" Style="{DynamicResource Kyf.Text.Caption}" />
                <TextBlock Grid.Column="1" Text="{x:Static pages:StatisticsText.SheetsColumn}" Style="{DynamicResource Kyf.Text.Caption}" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{x:Static pages:StatisticsText.ReviewsColumn}" Style="{DynamicResource Kyf.Text.Caption}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{x:Static pages:StatisticsText.OnTimeColumn}" Style="{DynamicResource Kyf.Text.Caption}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{x:Static pages:StatisticsText.AverageDelayColumn}" Style="{DynamicResource Kyf.Text.Caption}" TextAlignment="Right" />
              </Grid>
              <ItemsControl x:Name="FoldersList" ItemsSource="{Binding Folders}" Focusable="False" />
              <TextBlock x:Name="NoFolder" Text="{x:Static pages:StatisticsText.NoSheet}" Style="{DynamicResource Kyf.Text.Secondary}"
                         Visibility="{Binding HasNoFolder, Converter={StaticResource Visible}}" />
            </StackPanel>
          </kyf:Card>
        </Grid>

        <TextBlock x:Name="NoteText" Text="{x:Static pages:StatisticsText.Note}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
