<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.UnlockPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>

  <!-- Un coffre chiffré attend sa clé : rien de lui n'est lu, ni menu ni recherche. Ses fiches ne s'ouvrent qu'ensuite. -->
  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel MaxWidth="480" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <kyf:Icon Text="{x:Static kyf:Icons.Lock}" FontSize="32" HorizontalAlignment="Center" />
      <TextBlock x:Name="Heading" Text="{x:Static pages:EncryptionText.LockedHeading}" Style="{DynamicResource Kyf.Text.Title}"
                 Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                 AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="VaultPath" Text="{Binding Vault}" FontFamily="{DynamicResource Kyf.Font.Code}" Style="{DynamicResource Kyf.Text.Caption}"
                 Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" />
      <TextBlock x:Name="Intro" Text="{Binding Intro}" Style="{DynamicResource Kyf.Text.Secondary}" Margin="0,16,0,0"
                 TextAlignment="Center" TextWrapping="Wrap" />

      <!-- Le mot de passe, ou, perdu, la clé de récupération. -->
      <StackPanel x:Name="PasswordPart" Margin="0,24,0,0" Visibility="{Binding UsesPassword, Converter={StaticResource Visible}}"
                  IsVisibleChanged="OnSecretShown">
        <TextBlock x:Name="PasswordLabel" Text="{x:Static pages:EncryptionText.Password}" Style="{DynamicResource Kyf.Text.BodyStrong}"
                   Margin="0,0,0,6" />
        <PasswordBox x:Name="PasswordBox" IsEnabled="{Binding IsIdle}"
                     AutomationProperties.Name="{x:Static pages:EncryptionText.Password}"
                     AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" />
      </StackPanel>
      <StackPanel x:Name="RecoveryPart" Margin="0,24,0,0" Visibility="{Binding UsesRecoveryKey, Converter={StaticResource Visible}}"
                  IsVisibleChanged="OnSecretShown">
        <TextBlock x:Name="RecoveryLabel" Text="{x:Static pages:EncryptionText.RecoveryKey}" Style="{DynamicResource Kyf.Text.BodyStrong}"
                   Margin="0,0,0,6" />
        <TextBox x:Name="RecoveryBox" IsEnabled="{Binding IsIdle}" FontFamily="{DynamicResource Kyf.Font.Code}" TextWrapping="Wrap"
                 AutomationProperties.Name="{x:Static pages:EncryptionText.RecoveryKey}"
                 AutomationProperties.HelpText="{x:Static pages:EncryptionText.RecoveryHelp}"
                 AutomationProperties.LabeledBy="{Binding ElementName=RecoveryLabel}" />
        <TextBlock x:Name="RecoveryHelp" Text="{x:Static pages:EncryptionText.RecoveryHelp}" Style="{DynamicResource Kyf.Text.Caption}"
                   Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>

      <CheckBox x:Name="RememberBox" IsChecked="{Binding Remember}" IsEnabled="{Binding IsIdle}" Margin="0,16,0,0"
                AutomationProperties.Name="{x:Static pages:EncryptionText.Remember}"
                AutomationProperties.HelpText="{x:Static pages:EncryptionText.RememberHelp}">
        <TextBlock Text="{x:Static pages:EncryptionText.Remember}" TextWrapping="Wrap" />
      </CheckBox>
      <TextBlock x:Name="RememberHelp" Text="{x:Static pages:EncryptionText.RememberHelp}" Style="{DynamicResource Kyf.Text.Caption}"
                 Margin="26,2,0,0" TextWrapping="Wrap" />

      <WrapPanel Margin="0,24,0,0">
        <Button x:Name="UnlockButton" Style="{DynamicResource Kyf.Button.Primary}" IsDefault="True" Click="OnUnlock"
                IsEnabled="{Binding IsIdle}" Margin="0,0,8,8" AutomationProperties.Name="{x:Static pages:EncryptionText.Unlock}">
          <StackPanel Orientation="Horizontal">
            <kyf:Icon Text="{x:Static kyf:Icons.Lock}" Margin="0,0,8,0" />
            <TextBlock Text="{x:Static pages:EncryptionText.Unlock}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="LostPasswordButton" Style="{DynamicResource Kyf.Button.Subtle}" Command="{Binding UseRecoveryKeyCommand}"
                Margin="0,0,8,8" Visibility="{Binding UsesPassword, Converter={StaticResource Visible}}"
                Content="{x:Static pages:EncryptionText.LostPassword}" AutomationProperties.Name="{x:Static pages:EncryptionText.LostPassword}" />
        <Button x:Name="UsePasswordButton" Style="{DynamicResource Kyf.Button.Subtle}" Command="{Binding UsePasswordCommand}"
                Margin="0,0,8,8" Visibility="{Binding UsesRecoveryKey, Converter={StaticResource Visible}}"
                Content="{x:Static pages:EncryptionText.UsePassword}" AutomationProperties.Name="{x:Static pages:EncryptionText.UsePassword}" />
      </WrapPanel>
      <TextBlock x:Name="BusyText" Text="{x:Static pages:EncryptionText.Unlocking}" Style="{DynamicResource Kyf.Text.Secondary}"
                 Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" />
      <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}"
                        IsClosable="False" Margin="0,8,0,0" />

      <!-- Un autre coffre, ou celui qui reste ouvert derrière cet écran. -->
      <WrapPanel Margin="0,24,0,0">
        <Button x:Name="OtherVaultButton" Command="{Binding OtherVaultCommand}" Margin="0,0,8,8"
                AutomationProperties.Name="{x:Static pages:EncryptionText.OtherVault}">
          <StackPanel Orientation="Horizontal">
            <kyf:Icon Text="{x:Static kyf:Icons.FolderOpen}" Margin="0,0,8,0" />
            <TextBlock Text="{x:Static pages:EncryptionText.OtherVault}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="BackButton" Command="{Binding BackCommand}" Margin="0,0,8,8"
                Visibility="{Binding CanGoBack, Converter={StaticResource Visible}}"
                AutomationProperties.Name="{x:Static pages:EncryptionText.BackToVault}">
          <StackPanel Orientation="Horizontal">
            <kyf:Icon Text="{x:Static kyf:Icons.Back}" Margin="0,0,8,0" />
            <TextBlock Text="{x:Static pages:EncryptionText.BackToVault}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
