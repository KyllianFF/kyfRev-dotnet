<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.DataSettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:model="clr-namespace:KyfRev.Application.Model;assembly=KyfRev.Application"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <DataTemplate DataType="{x:Type pages:BackupRow}">
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Kyf.Brush.Divider}" Padding="0,6">
        <DockPanel>
          <Button x:Name="RestoreBackup" DockPanel.Dock="Right" Content="{x:Static pages:SettingsHubText.RestoreBackupLabel}" Style="{DynamicResource Kyf.Button.Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"
                  Command="{Binding DataContext.RequestRestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding RestoreName}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Moment}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Size}" Style="{DynamicResource Kyf.Text.Caption}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:TrashRow}">
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Kyf.Brush.Divider}" Padding="0,6">
        <DockPanel>
          <Button x:Name="RestoreItem" DockPanel.Dock="Right" Content="{x:Static pages:SettingsHubText.Restore}" Command="{Binding Restore}" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="{Binding RestoreName}" />
          <Button x:Name="OpenItemSheet" DockPanel.Dock="Right" Content="{x:Static pages:SettingsHubText.SheetKind}" Command="{Binding OpenSheet}" Style="{DynamicResource Kyf.Button.Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"
                  AutomationProperties.Name="{Binding OpenSheetName}" Visibility="{Binding HasSheet, Converter={StaticResource Visible}}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
        <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
        <kyf:Notification x:Name="DoneMessage" Severity="Success" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
        <Button x:Name="OpenRestored" Content="{x:Static pages:SettingsHubText.OpenRestored}" Command="{Binding OpenRestoredVaultCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"
                Visibility="{Binding HasRestoredVault, Converter={StaticResource Visible}}" />

        <kyf:Card x:Name="VaultCard" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SettingsHubText.VaultTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="VaultOpen" Text="{Binding VaultLine}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <WrapPanel IsEnabled="{Binding IsIdle}">
              <Button x:Name="OpenVaultButton" Content="{x:Static pages:SettingsHubText.OpenVault}" Command="{Binding OpenVaultCommand}" Margin="0,0,8,8" />
              <Button x:Name="CreateVaultButton" Content="{x:Static pages:SettingsHubText.CreateVault}" Command="{Binding CreateVaultCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding VaultHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
          </StackPanel>
        </kyf:Card>

        <kyf:Card x:Name="BackupsCard" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SettingsHubText.BackupsTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="{Binding BackupHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <WrapPanel IsEnabled="{Binding IsIdle}" Margin="0,0,0,8">
              <Button x:Name="BackupNowButton" Content="{x:Static pages:SettingsHubText.BackupNow}" Command="{Binding BackupNowCommand}" Style="{DynamicResource Kyf.Button.Primary}" Margin="0,0,12,8" />
              <CheckBox x:Name="RotationBox" IsChecked="{Binding Rotation}" Command="{Binding SaveRotationCommand}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.Name="{x:Static pages:SettingsHubText.Rotation}">
                <TextBlock Text="{x:Static pages:SettingsHubText.Rotation}" TextWrapping="Wrap" />
              </CheckBox>
            </WrapPanel>
            <TextBlock x:Name="NoBackup" Text="{x:Static pages:SettingsHubText.NoBackup}" Style="{DynamicResource Kyf.Text.Secondary}" Visibility="{Binding HasNoBackup, Converter={StaticResource Visible}}" />
            <ItemsControl x:Name="BackupsList" ItemsSource="{Binding Backups}" Focusable="False" IsEnabled="{Binding IsIdle}" Visibility="{Binding HasBackups, Converter={StaticResource Visible}}" />
          </StackPanel>
        </kyf:Card>

        <kyf:Card x:Name="TrashCard" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SettingsHubText.TrashTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="{x:Static pages:SettingsHubText.TrashHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock x:Name="NoTrash" Text="{x:Static pages:SettingsHubText.NoTrash}" Style="{DynamicResource Kyf.Text.Secondary}" Visibility="{Binding HasNoTrash, Converter={StaticResource Visible}}" />
            <ItemsControl x:Name="TrashList" ItemsSource="{Binding Trash}" Focusable="False" IsEnabled="{Binding IsIdle}" Visibility="{Binding HasTrash, Converter={StaticResource Visible}}" />
          </StackPanel>
        </kyf:Card>

        <kyf:Card x:Name="ExportsCard" Padding="16,12">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SettingsHubText.ExportsTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="{x:Static pages:SettingsHubText.ExportsHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <WrapPanel IsEnabled="{Binding IsIdle}">
              <Button x:Name="ExportTracking" Content="{x:Static pages:SettingsHubText.ExportTracking}" Command="{Binding ExportCommand}" CommandParameter="{x:Static model:ExportKind.Tracking}" Margin="0,0,8,8" />
              <Button x:Name="ExportAnnotations" Content="{x:Static pages:SettingsHubText.ExportAnnotations}" Command="{Binding ExportCommand}" CommandParameter="{x:Static model:ExportKind.Annotations}" Margin="0,0,8,8" />
              <Button x:Name="ExportVault" Content="{x:Static pages:SettingsHubText.ExportVault}" Command="{Binding ExportCommand}" CommandParameter="{x:Static model:ExportKind.Vault}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </kyf:Card>
      </StackPanel>
    </ScrollViewer>

    <kyf:Dialog x:Name="Confirmation" Title="{x:Static pages:SettingsHubText.RestoreConfirmTitle}" IsOpen="{Binding IsConfirming, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:SettingsHubText.Restore}" Closed="OnConfirmationClosed">
      <TextBlock Text="{Binding ConfirmMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
    </kyf:Dialog>
  </Grid>
</UserControl>
