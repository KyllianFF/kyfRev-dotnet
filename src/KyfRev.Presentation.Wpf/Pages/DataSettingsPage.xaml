<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.DataSettingsPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:model="clr-namespace:KyfRev.Application.Model;assembly=KyfRev.Application"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <DataTemplate DataType="{x:Type pages:BackupRow}">
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Kyf.Brush.Divider}" Padding="0,6">
        <DockPanel>
          <Button x:Name="RestoreBackup" DockPanel.Dock="Right" Content="{x:Static pages:SettingsHubText.RestoreBackupLabel}" Style="{DynamicResource Kyf.Button.Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"
                  Command="{Binding DataContext.RequestRestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding RestoreName}" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Moment}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Size}" Style="{DynamicResource Kyf.Text.Caption}" />
          </StackPanel>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:TrashRow}">
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Kyf.Brush.Divider}" Padding="0,6">
        <!-- Le titre garde sa place : quand les boutons la lui prendraient, ils passent dessous. -->
        <kyf:AdaptiveRow MainMinWidth="220" Spacing="8" StackedSpacing="6">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
          <StackPanel kyf:AdaptiveRow.Part="Trailing" Orientation="Horizontal">
            <Button x:Name="OpenItemSheet" Content="{x:Static pages:SettingsHubText.SheetKind}" Command="{Binding OpenSheet}" Style="{DynamicResource Kyf.Button.Subtle}" VerticalAlignment="Center" Margin="12,0,0,0"
                    AutomationProperties.Name="{Binding OpenSheetName}" Visibility="{Binding HasSheet, Converter={StaticResource Visible}}" />
            <Button x:Name="RestoreItem" Content="{x:Static pages:SettingsHubText.Restore}" Command="{Binding Restore}" VerticalAlignment="Center" Margin="8,0,0,0" AutomationProperties.Name="{Binding RestoreName}" />
            <Button x:Name="EraseItem" Content="{x:Static kyf:Icons.Trash}" Style="{DynamicResource Kyf.Button.Icon}" VerticalAlignment="Center" Margin="4,0,0,0"
                    Command="{Binding DataContext.RequestEraseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                    ToolTip="{x:Static pages:SettingsHubText.Erase}" AutomationProperties.Name="{Binding EraseName}" />
          </StackPanel>
        </kyf:AdaptiveRow>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel MaxWidth="{x:Static pages:SettingsTab.Column}" HorizontalAlignment="Stretch">
        <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
        <kyf:Notification x:Name="DoneMessage" Severity="Success" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
        <Button x:Name="OpenRestored" Content="{x:Static pages:SettingsHubText.OpenRestored}" Command="{Binding OpenRestoredVaultCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"
                Visibility="{Binding HasRestoredVault, Converter={StaticResource Visible}}" />

        <StackPanel x:Name="VaultPart" pages:SettingsPart.Of="coffre">
        <kyf:Card x:Name="VaultCard" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SettingsHubText.VaultTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="VaultOpen" Text="{Binding VaultLine}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <WrapPanel IsEnabled="{Binding IsIdle}">
              <Button x:Name="OpenVaultButton" Content="{x:Static pages:SettingsHubText.OpenVault}" Command="{Binding OpenVaultCommand}" Margin="0,0,8,8" />
              <Button x:Name="CreateVaultButton" Content="{x:Static pages:SettingsHubText.CreateVault}" Command="{Binding CreateVaultCommand}" Margin="0,0,8,8" />
              <Button x:Name="EncryptVaultButton" Command="{Binding RequestEncryptionCommand}" Margin="0,0,8,8"
                      Visibility="{Binding CanEncrypt, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static pages:EncryptionText.EncryptVault}"
                      AutomationProperties.HelpText="{x:Static pages:EncryptionText.EncryptVaultHelp}">
                <StackPanel Orientation="Horizontal">
                  <kyf:Icon Text="{x:Static kyf:Icons.Lock}" Margin="0,0,8,0" />
                  <TextBlock Text="{x:Static pages:EncryptionText.EncryptVault}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>
            <TextBlock Text="{Binding VaultHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" />
            <TextBlock x:Name="EncryptVaultHelp" Text="{x:Static pages:EncryptionText.EncryptVaultHelp}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap"
                       Margin="0,4,0,0" Visibility="{Binding CanEncrypt, Converter={StaticResource Visible}}" />
          </StackPanel>
        </kyf:Card>

        <!-- Le chiffrement, pour un coffre chiffré seulement. Les mots de passe ne se lient pas : la vue les passe aux commandes. -->
        <kyf:Card x:Name="EncryptionCard" Padding="16,12" Margin="0,0,0,8" DataContext="{Binding Encryption}"
                  Visibility="{Binding IsEncrypted, Converter={StaticResource Visible}, FallbackValue=Collapsed}">
          <StackPanel>
            <TextBlock x:Name="EncryptionTitle" Text="{x:Static pages:EncryptionText.CardTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="EncryptionHelp" Text="{x:Static pages:EncryptionText.CardHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <kyf:Notification x:Name="EncryptionError" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
            <kyf:Notification x:Name="EncryptionDone" Severity="Success" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" IsClosable="False" Margin="0,0,0,8" />
            <StackPanel x:Name="EncryptionSettings" IsEnabled="{Binding IsIdle}">
              <CheckBox x:Name="RememberKeyBox" IsChecked="{Binding IsRemembered}"
                        AutomationProperties.Name="{x:Static pages:EncryptionText.Remember}"
                        AutomationProperties.HelpText="{x:Static pages:EncryptionText.RememberHelp}">
                <TextBlock Text="{x:Static pages:EncryptionText.Remember}" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock x:Name="RememberKeyHelp" Text="{x:Static pages:EncryptionText.RememberHelp}" Style="{DynamicResource Kyf.Text.Caption}" Margin="26,2,0,12" TextWrapping="Wrap" />

              <TextBlock x:Name="LockAfterLabel" Text="{x:Static pages:EncryptionText.LockAfter}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="0,0,0,8" />
              <ComboBox x:Name="LockAfterChoice" ItemsSource="{Binding LockAfterChoices}" SelectedItem="{Binding LockAfter}" DisplayMemberPath="Label" HorizontalAlignment="Left" MinWidth="180"
                        AutomationProperties.Name="{x:Static pages:EncryptionText.LockAfter}"
                        AutomationProperties.HelpText="{x:Static pages:EncryptionText.LockAfterHelp}"
                        AutomationProperties.LabeledBy="{Binding ElementName=LockAfterLabel}" />
              <TextBlock x:Name="LockAfterHelp" Text="{x:Static pages:EncryptionText.LockAfterHelp}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />

              <WrapPanel>
                <Button x:Name="LockNowButton" Command="{Binding LockNowCommand}" Margin="0,0,8,8" Visibility="{Binding CanLockNow, Converter={StaticResource Visible}}"
                        AutomationProperties.Name="{x:Static pages:EncryptionText.LockNow}">
                  <StackPanel Orientation="Horizontal">
                    <kyf:Icon Text="{x:Static kyf:Icons.Lock}" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static pages:EncryptionText.LockNow}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button x:Name="ChangePasswordButton" Content="{x:Static pages:EncryptionText.ChangePassword}" Command="{Binding RequestChangePasswordCommand}" Margin="0,0,8,8"
                        AutomationProperties.Name="{x:Static pages:EncryptionText.ChangePassword}" />
                <Button x:Name="NewRecoveryKeyButton" Content="{x:Static pages:EncryptionText.NewRecoveryKey}" Command="{Binding RequestNewRecoveryKeyCommand}" Margin="0,0,8,8"
                        AutomationProperties.Name="{x:Static pages:EncryptionText.NewRecoveryKey}" />
                <Button x:Name="DecryptVaultButton" Content="{x:Static pages:EncryptionText.DecryptVault}" Command="{Binding RequestDecryptionCommand}" Margin="0,0,8,8"
                        Visibility="{Binding CanDecrypt, Converter={StaticResource Visible}}"
                        AutomationProperties.Name="{x:Static pages:EncryptionText.DecryptVault}" AutomationProperties.HelpText="{x:Static pages:EncryptionText.DecryptVaultHelp}" />
              </WrapPanel>
            </StackPanel>
            <kyf:Notification x:Name="EncryptionBusy" Severity="Info" Message="{Binding BusyMessage}" IsOpen="{Binding IsBusy, Mode=OneWay}" IsClosable="False" />
          </StackPanel>
        </kyf:Card>

        </StackPanel>
        <StackPanel x:Name="BackupsPart" pages:SettingsPart.Of="sauvegardes">
        <kyf:Card x:Name="BackupsCard" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SettingsHubText.BackupsTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="{Binding BackupHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <WrapPanel IsEnabled="{Binding IsIdle}" Margin="0,0,0,8">
              <Button x:Name="BackupNowButton" Content="{x:Static pages:SettingsHubText.BackupNow}" Command="{Binding BackupNowCommand}" Style="{DynamicResource Kyf.Button.Primary}" Margin="0,0,12,8" />
              <CheckBox x:Name="RotationBox" IsChecked="{Binding Rotation}" Command="{Binding SaveRotationCommand}" VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.Name="{x:Static pages:SettingsHubText.Rotation}">
                <TextBlock Text="{x:Static pages:SettingsHubText.Rotation}" TextWrapping="Wrap" />
              </CheckBox>
            </WrapPanel>
            <TextBlock x:Name="NoBackup" Text="{x:Static pages:SettingsHubText.NoBackup}" Style="{DynamicResource Kyf.Text.Secondary}" Visibility="{Binding HasNoBackup, Converter={StaticResource Visible}}" />
            <ItemsControl x:Name="BackupsList" ItemsSource="{Binding Backups}" Focusable="False" IsEnabled="{Binding IsIdle}" Visibility="{Binding HasBackups, Converter={StaticResource Visible}}" />
          </StackPanel>
        </kyf:Card>

        <kyf:Card x:Name="TrashCard" Padding="16,12" Margin="0,0,0,8">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SettingsHubText.TrashTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="{x:Static pages:SettingsHubText.TrashHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock x:Name="NoTrash" Text="{x:Static pages:SettingsHubText.NoTrash}" Style="{DynamicResource Kyf.Text.Secondary}" Visibility="{Binding HasNoTrash, Converter={StaticResource Visible}}" />
            <ItemsControl x:Name="TrashList" ItemsSource="{Binding Trash}" Focusable="False" IsEnabled="{Binding IsIdle}" Visibility="{Binding HasTrash, Converter={StaticResource Visible}}" />
          </StackPanel>
        </kyf:Card>

        <kyf:Card x:Name="ExportsCard" Padding="16,12">
          <StackPanel>
            <TextBlock Text="{x:Static pages:SettingsHubText.ExportsTitle}" Style="{DynamicResource Kyf.Text.Subtitle}" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock Text="{x:Static pages:SettingsHubText.ExportsHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" />
            <WrapPanel IsEnabled="{Binding IsIdle}">
              <Button x:Name="ExportTracking" Content="{x:Static pages:SettingsHubText.ExportTracking}" Command="{Binding ExportCommand}" CommandParameter="{x:Static model:ExportKind.Tracking}" Margin="0,0,8,8" />
              <Button x:Name="ExportAnnotations" Content="{x:Static pages:SettingsHubText.ExportAnnotations}" Command="{Binding ExportCommand}" CommandParameter="{x:Static model:ExportKind.Annotations}" Margin="0,0,8,8" />
              <Button x:Name="ExportVault" Content="{x:Static pages:SettingsHubText.ExportVault}" Command="{Binding ExportCommand}" CommandParameter="{x:Static model:ExportKind.Vault}" Margin="0,0,8,8" />
              <Button x:Name="ExportAnki" Content="{x:Static pages:SettingsHubText.ExportAnki}" Command="{Binding ExportCommand}" CommandParameter="{x:Static model:ExportKind.Anki}" Margin="0,0,8,8"
                      ToolTip="{x:Static pages:SettingsHubText.ExportAnkiHelp}" AutomationProperties.HelpText="{x:Static pages:SettingsHubText.ExportAnkiHelp}" />
              <Button x:Name="ExportCalendar" Content="{x:Static pages:SettingsHubText.ExportCalendar}" Command="{Binding ExportCommand}" CommandParameter="{x:Static model:ExportKind.Calendar}" Margin="0,0,8,8"
                      ToolTip="{x:Static pages:SettingsHubText.ExportCalendarHelp}" AutomationProperties.HelpText="{x:Static pages:SettingsHubText.ExportCalendarHelp}" />
              <Button x:Name="ExportQuotes" Content="{x:Static pages:SettingsHubText.ExportQuotes}" Command="{Binding ExportCommand}" CommandParameter="{x:Static model:ExportKind.Quotes}" Margin="0,0,8,8"
                      Visibility="{Binding ExportsQuotes, Converter={StaticResource Visible}}" />
            </WrapPanel>
          </StackPanel>
        </kyf:Card>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <kyf:Dialog x:Name="EraseConfirmation" Title="{x:Static pages:SettingsHubText.EraseConfirmTitle}" IsOpen="{Binding IsConfirmingErase, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:SettingsHubText.Erase}" IsDestructive="True" Closed="OnEraseClosed">
      <TextBlock Text="{Binding EraseMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
    </kyf:Dialog>

    <kyf:Dialog x:Name="Confirmation" Title="{x:Static pages:SettingsHubText.RestoreConfirmTitle}" IsOpen="{Binding IsConfirming, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:SettingsHubText.Restore}" Closed="OnConfirmationClosed">
      <TextBlock Text="{Binding ConfirmMessage}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
    </kyf:Dialog>

    <!-- Les fenêtres de la carte « Chiffrement ». Chacune prend le mot de passe ou, « J'utilise la clé de récupération » coché,
         la clé de récupération. Un champ de secret est vidé dès que sa fenêtre se ferme ou se cache. -->
    <kyf:Dialog x:Name="RememberDialog" DataContext="{Binding Encryption}" Title="{x:Static pages:EncryptionText.Remember}" IsOpen="{Binding IsAskingRemember, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:EncryptionText.RememberButton}" Closed="OnRememberClosed" IsVisibleChanged="OnPasswordDialogVisibleChanged">
      <StackPanel>
        <TextBlock x:Name="RememberAsk" Text="{x:Static pages:EncryptionText.RememberAsk}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
        <TextBlock x:Name="RememberPasswordLabel" Text="{Binding SecretLabel}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="0,12,0,8" />
        <PasswordBox x:Name="RememberPasswordBox" IsVisibleChanged="OnSecretShown" Visibility="{Binding UsesPassword, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static pages:EncryptionText.Password}"
                     AutomationProperties.LabeledBy="{Binding ElementName=RememberPasswordLabel}" />
        <TextBox x:Name="RememberRecoveryBox" IsVisibleChanged="OnSecretShown" FontFamily="{DynamicResource Kyf.Font.Code}" TextWrapping="Wrap" IsUndoEnabled="False"
                 Visibility="{Binding UsesRecoveryKey, Converter={StaticResource Visible}}"
                 AutomationProperties.Name="{x:Static pages:EncryptionText.RecoveryKey}"
                 AutomationProperties.HelpText="{x:Static pages:EncryptionText.RecoveryHelp}"
                 AutomationProperties.LabeledBy="{Binding ElementName=RememberPasswordLabel}" />
        <CheckBox x:Name="RememberWithRecoveryBox" IsChecked="{Binding UsesRecoveryKey}" Margin="0,8,0,0" AutomationProperties.Name="{x:Static pages:EncryptionText.WithRecoveryKey}">
          <TextBlock Text="{x:Static pages:EncryptionText.WithRecoveryKey}" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock x:Name="RememberDialogHelp" Text="{x:Static pages:EncryptionText.RememberHelp}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
        <kyf:Notification x:Name="RememberError" Severity="Critical" Message="{Binding DialogError}" IsOpen="{Binding HasDialogError, Mode=OneWay}" IsClosable="False" Margin="0,12,0,0" />
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="ChangePasswordDialog" DataContext="{Binding Encryption}" Title="{x:Static pages:EncryptionText.ChangePasswordTitle}" IsOpen="{Binding IsChangingPassword, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:EncryptionText.Change}" Closed="OnChangePasswordClosed" IsVisibleChanged="OnPasswordDialogVisibleChanged">
      <StackPanel>
        <TextBlock x:Name="ChangePasswordHelp" Text="{x:Static pages:EncryptionText.ChangePasswordHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" />
        <TextBlock x:Name="CurrentPasswordLabel" Text="{Binding CurrentSecretLabel}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="0,12,0,8" />
        <PasswordBox x:Name="CurrentPasswordBox" IsVisibleChanged="OnSecretShown" Visibility="{Binding UsesPassword, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static pages:EncryptionText.CurrentPassword}"
                     AutomationProperties.LabeledBy="{Binding ElementName=CurrentPasswordLabel}" />
        <TextBox x:Name="CurrentRecoveryBox" IsVisibleChanged="OnSecretShown" FontFamily="{DynamicResource Kyf.Font.Code}" TextWrapping="Wrap" IsUndoEnabled="False"
                 Visibility="{Binding UsesRecoveryKey, Converter={StaticResource Visible}}"
                 AutomationProperties.Name="{x:Static pages:EncryptionText.RecoveryKey}"
                 AutomationProperties.HelpText="{x:Static pages:EncryptionText.RecoveryHelp}"
                 AutomationProperties.LabeledBy="{Binding ElementName=CurrentPasswordLabel}" />
        <CheckBox x:Name="ChangeWithRecoveryBox" IsChecked="{Binding UsesRecoveryKey}" Margin="0,8,0,0" AutomationProperties.Name="{x:Static pages:EncryptionText.WithRecoveryKey}">
          <TextBlock Text="{x:Static pages:EncryptionText.WithRecoveryKey}" TextWrapping="Wrap" />
        </CheckBox>
        <TextBlock x:Name="NewPasswordLabel" Text="{x:Static pages:EncryptionText.NewPassword}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="0,12,0,8" />
        <PasswordBox x:Name="NewPasswordBox" AutomationProperties.Name="{x:Static pages:EncryptionText.NewPassword}"
                     AutomationProperties.HelpText="{x:Static pages:EncryptionSettingsViewModel.PasswordLength}"
                     AutomationProperties.LabeledBy="{Binding ElementName=NewPasswordLabel}" />
        <TextBlock x:Name="PasswordLengthHelp" Text="{x:Static pages:EncryptionSettingsViewModel.PasswordLength}" Style="{DynamicResource Kyf.Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="ConfirmPasswordLabel" Text="{x:Static pages:EncryptionText.ConfirmPassword}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="0,12,0,8" />
        <PasswordBox x:Name="ConfirmPasswordBox" AutomationProperties.Name="{x:Static pages:EncryptionText.ConfirmPassword}"
                     AutomationProperties.LabeledBy="{Binding ElementName=ConfirmPasswordLabel}" />
        <kyf:Notification x:Name="ChangePasswordError" Severity="Critical" Message="{Binding DialogError}" IsOpen="{Binding HasDialogError, Mode=OneWay}" IsClosable="False" Margin="0,12,0,0" />
      </StackPanel>
    </kyf:Dialog>

    <kyf:Dialog x:Name="RecoveryPromptDialog" DataContext="{Binding Encryption}" Title="{x:Static pages:EncryptionText.NewRecoveryKeyTitle}" IsOpen="{Binding IsAskingRecoveryKey, Mode=OneWay}"
                PrimaryButtonText="{x:Static pages:EncryptionText.Create}" Closed="OnRecoveryPromptClosed" IsVisibleChanged="OnPasswordDialogVisibleChanged">
      <StackPanel>
        <TextBlock x:Name="RecoveryPromptHelp" Text="{x:Static pages:EncryptionText.NewRecoveryKeyHelp}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
        <TextBlock x:Name="RecoveryPasswordLabel" Text="{Binding SecretLabel}" Style="{DynamicResource Kyf.Text.BodyStrong}" Margin="0,12,0,8" />
        <PasswordBox x:Name="RecoveryPasswordBox" IsVisibleChanged="OnSecretShown" Visibility="{Binding UsesPassword, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static pages:EncryptionText.Password}"
                     AutomationProperties.LabeledBy="{Binding ElementName=RecoveryPasswordLabel}" />
        <TextBox x:Name="PromptRecoveryBox" IsVisibleChanged="OnSecretShown" FontFamily="{DynamicResource Kyf.Font.Code}" TextWrapping="Wrap" IsUndoEnabled="False"
                 Visibility="{Binding UsesRecoveryKey, Converter={StaticResource Visible}}"
                 AutomationProperties.Name="{x:Static pages:EncryptionText.RecoveryKey}"
                 AutomationProperties.HelpText="{x:Static pages:EncryptionText.RecoveryHelp}"
                 AutomationProperties.LabeledBy="{Binding ElementName=RecoveryPasswordLabel}" />
        <CheckBox x:Name="PromptWithRecoveryBox" IsChecked="{Binding UsesRecoveryKey}" Margin="0,8,0,0" AutomationProperties.Name="{x:Static pages:EncryptionText.WithRecoveryKey}">
          <TextBlock Text="{x:Static pages:EncryptionText.WithRecoveryKey}" TextWrapping="Wrap" />
        </CheckBox>
        <kyf:Notification x:Name="RecoveryPromptError" Severity="Critical" Message="{Binding DialogError}" IsOpen="{Binding HasDialogError, Mode=OneWay}" IsClosable="False" Margin="0,12,0,0" />
      </StackPanel>
    </kyf:Dialog>

    <!-- La nouvelle clé de récupération, préparée et montrée une seule fois : elle ne s'enregistre qu'une fois rangée ;
         « Annuler », Échap ou un verrouillage la laissent de côté, et l'ancienne reste la bonne. -->
    <kyf:Dialog x:Name="RecoveryKeyDialog" DataContext="{Binding Encryption}" Title="{x:Static pages:EncryptionText.RecoveryKeyShownTitle}" IsOpen="{Binding IsShowingRecoveryKey, Mode=OneWay}"
                CardMaxWidth="640" PrimaryButtonText="{x:Static pages:EncryptionText.SaveRecoveryKey}" Closed="OnRecoveryKeyClosed">
      <StackPanel>
        <TextBlock x:Name="RecoveryKeyHelp" Text="{x:Static pages:EncryptionText.RecoveryKeyShown}" Style="{DynamicResource Kyf.Text.Body}" TextWrapping="Wrap" />
        <TextBox x:Name="RecoveryKeyText" Text="{Binding RecoveryKey, Mode=OneWay}" IsReadOnly="True" FontFamily="{DynamicResource Kyf.Font.Code}" TextWrapping="Wrap" Margin="0,12,0,0"
                 AutomationProperties.Name="{x:Static pages:EncryptionText.RecoveryKey}" />
        <Button x:Name="CopyRecoveryKeyButton" Content="{x:Static pages:EncryptionText.Copy}" Command="{Binding CopyRecoveryKeyCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                AutomationProperties.Name="{x:Static pages:EncryptionText.CopyRecoveryKey}" />
        <kyf:Notification x:Name="RecoveryKeyStatus" Severity="Info" Message="{Binding KeyMessage}" IsOpen="{Binding HasKeyMessage, Mode=OneWay}" IsClosable="False" Margin="0,8,0,0" />
        <kyf:Notification x:Name="OldRecoveryKeyWarning" Severity="Warning" Message="{x:Static pages:EncryptionText.OldRecoveryKey}" IsOpen="True" IsClosable="False" Margin="0,12,0,0" />
        <CheckBox x:Name="KeyStoredBox" IsChecked="{Binding IsKeyStored}" Margin="0,12,0,0" AutomationProperties.Name="{x:Static pages:EncryptionText.KeyStored}">
          <TextBlock Text="{x:Static pages:EncryptionText.KeyStored}" TextWrapping="Wrap" />
        </CheckBox>
      </StackPanel>
    </kyf:Dialog>
  </Grid>
</UserControl>
