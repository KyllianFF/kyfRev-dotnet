<UserControl x:Class="KyfRev.Presentation.Wpf.Pages.HealthPage"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:kyf="clr-namespace:KyfRev.DesignSystem.Controls;assembly=KyfRev.DesignSystem"
             xmlns:pages="clr-namespace:KyfRev.Presentation.Wpf.Pages">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <!-- Une ligne : ce qui est concerné, et ce qu'on peut y faire. -->
    <DataTemplate DataType="{x:Type pages:HealthRow}">
      <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Kyf.Brush.Divider}" Background="Transparent" Padding="0,8" AutomationProperties.Name="{Binding Spoken}" ContextMenuOpening="OnRowMenu">
        <Border.ContextMenu>
          <ContextMenu />
        </Border.ContextMenu>
        <!-- Le texte garde sa place : quand le choix et la réparation la lui prendraient, ils passent dessous. -->
        <kyf:AdaptiveRow MainMinWidth="240" Spacing="12" StackedSpacing="8">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource Kyf.Text.BodyStrong}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Kyf.Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
          </StackPanel>
          <WrapPanel kyf:AdaptiveRow.Part="Trailing" VerticalAlignment="Center">
            <ComboBox x:Name="BackupChoice" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MinWidth="168" Margin="0,0,8,0"
                      Visibility="{Binding HasBackups, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static pages:HealthText.BackupToUse}" />
            <Button x:Name="Repair" Content="{Binding ActionLabel}" Command="{Binding Action}" AutomationProperties.Name="{Binding ActionName}"
                    Visibility="{Binding HasRepair, Converter={StaticResource Visible}}" />
            <Button x:Name="Open" Content="{Binding ActionLabel}" Command="{Binding Action}" Style="{DynamicResource Kyf.Button.Subtle}" AutomationProperties.Name="{Binding ActionName}"
                    Visibility="{Binding HasOpening, Converter={StaticResource Visible}}" />
            <TextBlock x:Name="Hint" Text="{Binding Hint}" Style="{DynamicResource Kyf.Text.Caption}" VerticalAlignment="Center"
                       Visibility="{Binding HasHint, Converter={StaticResource Visible}}" />
          </WrapPanel>
        </kyf:AdaptiveRow>
      </Border>
    </DataTemplate>

    <!-- Une section : un type de problème. -->
    <DataTemplate DataType="{x:Type pages:HealthSection}">
      <kyf:Card Padding="16,12" Margin="0,0,0,8">
        <StackPanel>
          <DockPanel>
            <kyf:Icon x:Name="SectionIcon" Text="{x:Static kyf:Icons.Warning}" Foreground="{DynamicResource Kyf.Brush.Warning}" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" Style="{DynamicResource Kyf.Text.BodyLarge}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
          </DockPanel>
          <TextBlock Text="{Binding Help}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8"
                     Visibility="{Binding HasHelp, Converter={StaticResource Visible}}" />
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" />
        </StackPanel>
      </kyf:Card>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsInformation}" Value="True">
          <Setter TargetName="SectionIcon" Property="Text" Value="{x:Static kyf:Icons.Info}" />
          <Setter TargetName="SectionIcon" Property="Foreground" Value="{DynamicResource Kyf.Brush.TextSecondary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel MaxWidth="1440" Margin="16">
      <DockPanel Margin="0,0,0,12">
        <Button x:Name="AnalyzeButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding IsIdle}"
                Content="{x:Static pages:HealthText.Analyze}" />
        <StackPanel>
          <TextBlock x:Name="Heading" Text="{Binding Title}" Style="{DynamicResource Kyf.Text.Title}" AutomationProperties.HeadingLevel="Level1" />
          <DockPanel Margin="0,4,0,0" Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}">
            <kyf:Icon x:Name="GoodIcon" Text="{x:Static kyf:Icons.Success}" Foreground="{DynamicResource Kyf.Brush.Success}" Margin="0,0,8,0" VerticalAlignment="Center"
                      Visibility="{Binding IsHealthy, Converter={StaticResource Visible}}" />
            <kyf:Icon x:Name="ProblemIcon" Text="{x:Static kyf:Icons.Warning}" Foreground="{DynamicResource Kyf.Brush.Warning}" Margin="0,0,8,0" VerticalAlignment="Center"
                      Visibility="{Binding HasProblems, Converter={StaticResource Visible}}" />
            <TextBlock x:Name="Summary" Text="{Binding Summary}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>
      </DockPanel>
      <kyf:Notification x:Name="ErrorMessage" Severity="Critical" Message="{Binding Error}" IsOpen="{Binding HasError, Mode=OneWay}" Margin="0,0,0,8" />
      <kyf:Notification x:Name="DoneMessage" Severity="Success" Message="{Binding Message}" IsOpen="{Binding HasMessage, Mode=OneWay}" Margin="0,0,0,8" />

      <StackPanel x:Name="Loading" Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" AutomationProperties.Name="{x:Static pages:HealthText.Loading}">
        <kyf:Skeleton Height="96" Margin="0,0,0,8" />
        <kyf:Skeleton Height="96" />
      </StackPanel>

      <ItemsControl x:Name="SectionsList" ItemsSource="{Binding Sections}" Focusable="False" IsEnabled="{Binding IsIdle}"
                    Visibility="{Binding HasSections, Converter={StaticResource Visible}}" />

      <!-- Tout va bien : ce qui a été vérifié, pour que ce résultat veuille dire quelque chose. -->
      <kyf:Card x:Name="ChecksCard" Padding="16,12" Margin="0,0,0,8" Visibility="{Binding IsHealthy, Converter={StaticResource Visible}}">
        <StackPanel>
          <TextBlock Text="{x:Static pages:HealthText.ChecksTitle}" Style="{DynamicResource Kyf.Text.BodyLarge}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{x:Static pages:HealthText.ChecksText}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
      </kyf:Card>

      <!-- Le diagnostic : rien ne part tout seul, c'est la personne qui colle le texte où elle veut. -->
      <kyf:Card x:Name="DiagnosticCard" Padding="16,12">
        <StackPanel>
          <TextBlock Text="{x:Static pages:HealthText.DiagnosticTitle}" Style="{DynamicResource Kyf.Text.BodyLarge}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
          <TextBlock Text="{x:Static pages:HealthText.DiagnosticHelp}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,8" />
          <WrapPanel>
            <Button x:Name="CopyButton" Content="{x:Static pages:HealthText.DiagnosticCopy}" Command="{Binding CopyDiagnosticCommand}" Margin="0,0,8,0" />
            <Button x:Name="ToggleButton" Content="{Binding DiagnosticToggle}" Command="{Binding ToggleDiagnosticCommand}" Style="{DynamicResource Kyf.Button.Subtle}" />
          </WrapPanel>
          <TextBlock x:Name="DiagnosticStatus" Text="{Binding DiagnosticMessage}" Style="{DynamicResource Kyf.Text.Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Visibility="{Binding HasDiagnosticMessage, Converter={StaticResource Visible}}" />
          <TextBox x:Name="DiagnosticBox" Text="{Binding DiagnosticText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="280" Margin="0,8,0,0"
                   VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static pages:HealthText.DiagnosticText}"
                   Visibility="{Binding IsDiagnosticShown, Converter={StaticResource Visible}}" />
        </StackPanel>
      </kyf:Card>
    </StackPanel>
  </ScrollViewer>
</UserControl>
